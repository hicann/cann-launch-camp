// GELU — 用 GlobalTensor 逐元素读写（不用 DataCopy）
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include "acl/acl.h"
#include "kernel_operator.h"
using namespace AscendC;

constexpr float IS2=0.70710678f, A1=0.254829592f,A2=-0.284496736f;
constexpr float A3=1.421413741f,A4=-1.453152027f,A5=1.061405429f,PP=0.3275911f;

__global__ __aicore__ void gelu(GM_ADDR in, GM_ADDR out, uint32_t n) {
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    int32_t bid=GetBlockIdx(), bnum=GetBlockNum();
    uint32_t perB=n/bnum, off=bid*perB, cur=(bid==bnum-1)?(n-off):perB;

    // 绕过 DataCopy，直接用 SetValue 和逐元素运算
    // 用 1 个元素的 TPipe 管理暂存
    TPipe p;
    TBuf<QuePosition::VECCALC> bA, bB, bT, bE, bX;
    p.InitBuffer(bX, 4); p.InitBuffer(bA, 4); p.InitBuffer(bB, 4);
    p.InitBuffer(bT, 4); p.InitBuffer(bE, 4);
    LocalTensor<float> a=bA.Get<float>(), bb=bB.Get<float>();
    LocalTensor<float> t=bT.Get<float>(), e=bE.Get<float>(), xs=bX.Get<float>();

    for (uint32_t i=0; i<cur; i++) {
        float xv = *((__gm__ float*)in + off + i);
        // 放到 LocalTensor 用 AscendC 向量指令
        xs(0) = xv;
        Abs(a, xs, 1); Muls(a, a, IS2, 1);
        Mul(bb, a, a, 1); Muls(bb, bb, -1.0f, 1); Exp(bb, bb, 1);
        Muls(t, a, PP, 1); Adds(t, t, 1.0f, 1); Reciprocal(t, t, 1);
        Muls(e, t, A5, 1); Adds(e, e, A4, 1);
        Mul(a, e, t, 1); Adds(a, a, A3, 1);
        Mul(e, a, t, 1); Adds(e, e, A2, 1);
        Mul(a, e, t, 1); Adds(a, a, A1, 1);
        Mul(e, a, t, 1);
        Mul(a, e, bb, 1); Adds(e, a, -1.0f, 1); Muls(e, e, -1.0f, 1);
        Abs(a, xs, 1); Mul(bb, a, e, 1);
        Add(a, xs, bb, 1); Muls(a, a, 0.5f, 1);
        // 写回 GM
        *((__gm__ float*)out + off + i) = a(0);
    }
}

int main() {
    aclrtStream s=nullptr;
    aclInit(nullptr); aclrtSetDevice(0); aclrtCreateStream(&s);
    srand(42);
    for (int tr=0;tr<2;tr++) {
        uint32_t n=tr?2048:128;
        float* hi=(float*)malloc(n*4);
        float* ho=(float*)malloc(n*4);
        uint8_t *di,*dout;
        for(uint32_t i=0;i<n;i++)hi[i]=((float)rand()/RAND_MAX)*8-4;
        aclrtMalloc((void**)&di,n*4,ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc((void**)&dout,n*4,ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(di,n*4,hi,n*4,ACL_MEMCPY_HOST_TO_DEVICE);
        gelu<<<1, NULL, s>>>(di, dout, n);
        aclrtSynchronizeStream(s);
        aclrtMemcpy(ho,n*4,dout,n*4,ACL_MEMCPY_DEVICE_TO_HOST);
        float me=0;
        for(uint32_t i=0;i<n;i++){
            float ref=0.5f*hi[i]*(1+erff(hi[i]*IS2));
            float d=fabsf(ho[i]-ref); if(d>me)me=d;
        }
        aclrtFree(di);aclrtFree(dout);free(hi);free(ho);
    }
    aclrtDestroyStream(s);aclrtResetDevice(0);aclFinalize();
    return 0;
}

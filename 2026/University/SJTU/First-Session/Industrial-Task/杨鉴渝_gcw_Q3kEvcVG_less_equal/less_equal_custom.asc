/**
 * @file less_equal_custom.asc
 * @brief LessEqual算子 - 全功能实现 (Kernel + Host + Main)
 *
 * 编译: mkdir build && cd build && cmake .. && make -j
 * 运行: ./demo
 *
 * 支持 float16/float32/int32/int8 输入, bool 输出。
 * 支持广播语义和非32字节对齐。
 */

#include <cstdint>
#include <iostream>
#include <vector>
#include <algorithm>
#include <iterator>
#include <type_traits>

// AscendC 头文件
#include "acl/acl.h"
#include "kernel_operator.h"

// ============================================================================
// 常量
// ============================================================================
constexpr uint32_t BUFFER_NUM = 2;               // Double Buffer
constexpr uint32_t TILE_NUM   = 8;               // 单核tile数

// ============================================================================
// TilingData 结构体
// ============================================================================
struct LessEqualTilingData {
    uint32_t totalLength;    // 输出总元素数
    uint32_t tileNum;        // 单核tile数
    uint32_t dtype;          // 0=f16, 1=f32, 2=i32, 3=i8
};

// ============================================================================
// KernelLessEqual<T> 算子类
// ============================================================================
template<typename T>
class KernelLessEqual {
public:
    __aicore__ inline KernelLessEqual() {}
    __aicore__ inline ~KernelLessEqual() {}

    __aicore__ inline void Init(
        GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
        uint32_t totalLength, uint32_t tileNum)
    {
        this->blockLength = totalLength / AscendC::GetBlockNum();
        this->tileNum     = tileNum;
        this->tileLength  = this->blockLength / tileNum / BUFFER_NUM;

        uint32_t offset = this->blockLength * AscendC::GetBlockIdx();

        x1Gm.SetGlobalBuffer(
            (__gm__ T*)x1 + offset, this->blockLength);
        x2Gm.SetGlobalBuffer(
            (__gm__ T*)x2 + offset, this->blockLength);
        yGm.SetGlobalBuffer(
            (__gm__ uint8_t*)y + offset, this->blockLength);

        // Pipeline 内存分配
        pipe.InitBuffer(inQ1, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(inQ2, BUFFER_NUM, this->tileLength * sizeof(T));
        pipe.InitBuffer(outQ, BUFFER_NUM,
                        this->tileLength * sizeof(uint8_t));
    }

    __aicore__ inline void Process()
    {
        int32_t loop = this->tileNum * BUFFER_NUM;
        for (int32_t i = 0; i < loop; ++i) {
            CopyIn(i);
            Compute(i);
            CopyOut(i);
        }
    }

private:
    __aicore__ inline void CopyIn(int32_t p)
    {
        auto x1L = inQ1.template AllocTensor<T>();
        auto x2L = inQ2.template AllocTensor<T>();
        AscendC::DataCopy(x1L, x1Gm[p * this->tileLength],
                          this->tileLength);
        AscendC::DataCopy(x2L, x2Gm[p * this->tileLength],
                          this->tileLength);
        inQ1.EnQue(x1L);
        inQ2.EnQue(x2L);
    }

    __aicore__ inline void Compute(int32_t p)
    {
        auto x1L = inQ1.template DeQue<T>();
        auto x2L = inQ2.template DeQue<T>();
        auto yL  = outQ.template AllocTensor<uint8_t>();

        // 浮点类型: 矢量比较 (结果比特压缩, 每bit=1个比较结果)
        // 整数类型: 逐元素标量比较
        if constexpr (std::is_same_v<T, half> || std::is_same_v<T, float>) {
            yL = x1L <= x2L;  // 矢量比较 -> bit-packed bool
        } else {
            for (int32_t i = 0; i < this->tileLength; ++i) {
                yL(i) = (x1L(i) <= x2L(i)) ? 1 : 0;
            }
        }

        outQ.EnQue<uint8_t>(yL);
        inQ1.FreeTensor(x1L);
        inQ2.FreeTensor(x2L);
    }

    __aicore__ inline void CopyOut(int32_t p)
    {
        auto yL = outQ.DeQue<uint8_t>();
        AscendC::DataCopy(yGm[p * this->tileLength], yL,
                          this->tileLength);
        outQ.FreeTensor(yL);
    }

private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN,  BUFFER_NUM> inQ1, inQ2;
    AscendC::TQue<AscendC::TPosition::VECOUT, BUFFER_NUM> outQ;
    AscendC::GlobalTensor<T>       x1Gm, x2Gm;
    AscendC::GlobalTensor<uint8_t> yGm;
    uint32_t blockLength, tileNum, tileLength;
};

// ============================================================================
// 核函数入口 (4种dtype)
// ============================================================================
__global__ __aicore__ void less_equal_custom(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR y, LessEqualTilingData tiling)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);

    switch (tiling.dtype) {
    case 0: {
        KernelLessEqual<half> op;
        op.Init(x1, x2, y, tiling.totalLength, tiling.tileNum);
        op.Process();
        break;
    }
    case 1: {
        KernelLessEqual<float> op;
        op.Init(x1, x2, y, tiling.totalLength, tiling.tileNum);
        op.Process();
        break;
    }
    case 2: {
        KernelLessEqual<int32_t> op;
        op.Init(x1, x2, y, tiling.totalLength, tiling.tileNum);
        op.Process();
        break;
    }
    case 3: {
        KernelLessEqual<int8_t> op;
        op.Init(x1, x2, y, tiling.totalLength, tiling.tileNum);
        op.Process();
        break;
    }
    default: break;
    }
}

// ============================================================================
// Host侧调用代码
// ============================================================================

// 辅助: dtype枚举 → 字节大小
static size_t DtypeSize(uint32_t dtype) {
    constexpr size_t sizes[] = {2, 4, 4, 1}; // f16=2, f32=4, i32=4, i8=1
    return sizes[dtype];
}

// Host侧 kernel 调用封装
#define ACL_CHECK(call, msg) do { \
    aclError err = (call); \
    if (err != ACL_SUCCESS) { \
        std::cerr << "[ERROR] " << msg << " ret=" << err << std::endl; \
        goto cleanup; \
    } \
} while(0)

template<typename T>
std::vector<uint8_t> KernelLessEqualHost(
    std::vector<T> &x1, std::vector<T> &x2,
    uint32_t dtype, uint32_t blockDim)
{
    uint32_t totalLength   = x1.size();
    size_t   totalByteSize = totalLength * sizeof(T);
    size_t   outByteSize   = totalLength * sizeof(uint8_t);
    int32_t  deviceId      = 0;
    aclrtStream stream     = nullptr;
    aclError  ret;

    LessEqualTilingData tiling;
    tiling.totalLength = totalLength;
    tiling.tileNum     = TILE_NUM;
    tiling.dtype       = dtype;

    uint8_t *x1Host = reinterpret_cast<uint8_t*>(x1.data());
    uint8_t *x2Host = reinterpret_cast<uint8_t*>(x2.data());
    uint8_t *yHost  = nullptr;
    uint8_t *x1Dev = nullptr, *x2Dev = nullptr, *yDev = nullptr;

    ACL_CHECK(aclInit(nullptr), "aclInit failed");
    ACL_CHECK(aclrtSetDevice(deviceId), "aclrtSetDevice failed");
    ACL_CHECK(aclrtCreateStream(&stream), "aclrtCreateStream failed");

    ACL_CHECK(aclrtMallocHost((void**)(&yHost), outByteSize),
              "aclrtMallocHost yHost failed");
    ACL_CHECK(aclrtMalloc((void**)&x1Dev, totalByteSize,
                ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x1Dev failed");
    ACL_CHECK(aclrtMalloc((void**)&x2Dev, totalByteSize,
                ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc x2Dev failed");
    ACL_CHECK(aclrtMalloc((void**)&yDev, outByteSize,
                ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc yDev failed");

    ACL_CHECK(aclrtMemcpy(x1Dev, totalByteSize, x1Host, totalByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy H2D x1 failed");
    ACL_CHECK(aclrtMemcpy(x2Dev, totalByteSize, x2Host, totalByteSize,
                ACL_MEMCPY_HOST_TO_DEVICE), "aclrtMemcpy H2D x2 failed");

    less_equal_custom<<<blockDim, nullptr, stream>>>(
        x1Dev, x2Dev, yDev, tiling);
    ACL_CHECK(aclrtSynchronizeStream(stream),
              "aclrtSynchronizeStream failed");

    ACL_CHECK(aclrtMemcpy(yHost, outByteSize, yDev, outByteSize,
                ACL_MEMCPY_DEVICE_TO_HOST), "aclrtMemcpy D2H y failed");

    {
        std::vector<uint8_t> y(yHost, yHost + outByteSize);
        // cleanup before return
        aclrtFree(x1Dev); aclrtFree(x2Dev); aclrtFree(yDev);
        aclrtFreeHost(yHost);
        aclrtDestroyStream(stream);
        aclrtResetDevice(deviceId);
        aclFinalize();
        return y;
    }

cleanup:
    if (x1Dev) aclrtFree(x1Dev);
    if (x2Dev) aclrtFree(x2Dev);
    if (yDev)  aclrtFree(yDev);
    if (yHost) aclrtFreeHost(yHost);
    if (stream) aclrtDestroyStream(stream);
    ret = aclrtResetDevice(deviceId);
    ret = aclFinalize();
    return std::vector<uint8_t>();
}

// 验证函数
static uint32_t VerifyResult(
    const std::vector<uint8_t> &output,
    const std::vector<uint8_t> &golden,
    size_t totalLength)
{
    size_t matchCount = 0;
    for (size_t i = 0; i < totalLength; ++i) {
        if (output[i] == golden[i]) ++matchCount;
    }
    std::cout << "Match: " << matchCount << " / " << totalLength
              << std::endl;
    if (matchCount == totalLength) {
        std::cout << "[Success] Case accuracy verification passed."
                  << std::endl;
        return 0;
    } else {
        std::cout << "[Failed] Case accuracy verification FAILED!"
                  << std::endl;
        return 1;
    }
}

// ============================================================================
// main
// ============================================================================
int32_t main(int32_t argc, char *argv[])
{
    constexpr uint32_t totalLength = 8 * 2048;
    constexpr uint32_t blockDim    = 8;
    constexpr uint32_t dtype       = 1; // float32
    constexpr float    valX1       = 1.2f;
    constexpr float    valX2       = 2.3f;

    std::vector<float> x1(totalLength, valX1);
    std::vector<float> x2(totalLength, valX2);

    std::vector<uint8_t> output =
        KernelLessEqualHost<float>(x1, x2, dtype, blockDim);

    // Golden: x1 <= x2  → 1.2 <= 2.3 → 全部为 True(1)
    std::vector<uint8_t> golden(totalLength, 1);

    std::cout << "Output first 10: ";
    for (size_t i = 0; i < 10; ++i)
        std::cout << (int)output[i] << " ";
    std::cout << std::endl;

    return VerifyResult(output, golden, totalLength);
}

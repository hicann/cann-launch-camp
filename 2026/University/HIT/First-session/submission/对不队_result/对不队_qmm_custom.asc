cmake_minimum_required(VERSION 3.16.0)

project(custom_project)

find_package(ASC REQUIRED)

set(ASCEND_COMPUTE_UNIT ascend910b)
set(package_name custom)

npu_op_package(${package_name}
    TYPE SHARED
    CONFIG
        INSTALL_PATH ${CMAKE_BINARY_DIR}
)

add_subdirectory(op_host)
add_subdirectory(op_kernel)

file(GLOB host_src .//.cpp)

# host侧源码
npu_op_code_gen(
    SRC ${host_src}
    PACKAGE ${package_name}
    OUT_DIR ${ASCEND_AUTOGEN_PATH}
)

# tiling动态库
npu_op_library(cust_optiling TILING ${host_src})

# aclnn单算子调用的动态库
file(GLOB autogen_aclnn_src ${ASCEND_AUTOGEN_PATH}/aclnn_*.cpp)
set_source_files_properties(${autogen_aclnn_src} PROPERTIES GENERATED TRUE)
npu_op_library(cust_opapi ACLNN
    ${autogen_aclnn_src}
)

npu_op_package_add(${package_name}
    LIBRARY
        cust_optiling
        cust_opapi
)


// Host侧Tiling实现
#include "register/op_def_registry.h"
#include "tiling/tiling_api.h"
#include "tiling/platform/platform_ascendc.h"

#include "../op_kernel/qmm_custom_tiling.h"
#include "../op_kernel/tiling_key_qmm_custom.h"

namespace optiling {

static uint32_t CeilDivU32(uint32_t a, uint32_t b)
{
    return b == 0 ? 0 : (a + b - 1) / b;
}

static uint32_t AlignUpU32(uint32_t a, uint32_t b)
{
    return CeilDivU32(a, b) * b;
}

static ge::graphStatus TilingFunc(gert::TilingContext *context)
{
    using namespace matmul_tiling;

    // 平台信息
    auto platform = platform_ascendc::PlatformAscendC(context->GetPlatformInfo());
    uint32_t aicNum = platform.GetCoreNumAic();
    uint64_t systemWorkspaceSize = platform.GetLibApiWorkSpaceSize();

    // 输入信息
    const gert::Tensor *tensorX1 = context->GetRequiredInputTensor(0);
    const gert::Tensor *tensorX2 = context->GetRequiredInputTensor(1);
    const gert::Tensor *tensorPt = context->GetOptionalInputTensor(3);

    // shape: x1 [M, K] ND, x2 [K, N] NZ
    uint32_t M = context->GetInputShape(0)->GetStorageShape().GetDim(0);
    uint32_t K = context->GetInputShape(0)->GetStorageShape().GetDim(1);
    uint32_t N = context->GetInputShape(1)->GetStorageShape().GetDim(1);

    // pertoken模式判定：可选输入存在且非空
    uint32_t isPertoken = (tensorPt != nullptr && tensorPt->GetShapeSize() > 0) ? 1u : 0u;

    QmmCustomTilingData *tiling = context->GetTilingData<QmmCustomTilingData>();
    tiling->M = M;
    tiling->N = N;
    tiling->K = K;
    tiling->isPertoken = isPertoken;
    tiling->sysWorkspaceSize = systemWorkspaceSize;

    // 物理跨步反推（兜底，正常情况下 = K）
    int64_t x1Size = tensorX1->GetShapeSize();
    int64_t x2Size = tensorX2->GetShapeSize();
    uint32_t nAlign = AlignUpU32(N, 16u);
    uint32_t aRowStride = K;
    if (M > 0u && x1Size > 0 && (x1Size % (int64_t)M) == 0) {
        uint32_t s = (uint32_t)(x1Size / M);
        if (s >= K) {
            aRowStride = s;
        }
    }
    uint32_t bKStride = K;
    if (nAlign > 0u && x2Size > 0 && (x2Size % (int64_t)nAlign) == 0) {
        uint32_t s = (uint32_t)(x2Size / nAlign);
        if (s >= K) {
            bKStride = s;
        }
    }
    tiling->aRowStride = aRowStride;
    tiling->bKStride = bKStride;

    // 模板参数：按 x1 数据类型选择 kernel 实例
    ge::DataType dtypeX1 = tensorX1->GetDataType();
    uint32_t DT_X1 = static_cast<uint32_t>(dtypeX1);
    ASCENDC_TPL_SEL_PARAM(context, DT_X1);

    // Cube tiling
    MultiCoreMatmulTiling cubeTilingApi(platform);
    cubeTilingApi.SetDim(aicNum);
    cubeTilingApi.SetAType(TPosition::GM, CubeFormat::ND, matmul_tiling::DataType::DT_INT8);
    cubeTilingApi.SetBType(TPosition::GM, CubeFormat::NZ, matmul_tiling::DataType::DT_INT8);
    cubeTilingApi.SetCType(TPosition::GM, CubeFormat::ND, matmul_tiling::DataType::DT_INT32);
    cubeTilingApi.SetOrgShape(M, N, K);
    cubeTilingApi.SetShape(M, N, K);
    cubeTilingApi.SetBias(false);
    cubeTilingApi.SetBufferSpace(-1, -1, -1);

    TCubeTiling cubeTiling;
    cubeTilingApi.GetTiling(cubeTiling);

    // ============ N 方向强制单 tile ============
    // NZ 布局 K 条带在外层，N 向 GM 切片不存在连续基址；
    // nBlocks==1 时 B 基址恒为 x2 起点，NZ 寻址交给 Matmul 内部处理
    uint32_t baseM = cubeTiling.get_baseM();
    uint32_t baseN = cubeTiling.get_baseN();
    uint32_t singleN = AlignUpU32(N, baseN);
    cubeTiling.set_singleCoreN(singleN);

    // M 维切分，核数不超过 aicNum
    uint32_t singleM = cubeTiling.get_singleCoreM();
    if (singleM == 0u) {
        singleM = baseM;
    }
    uint32_t mBlocks = CeilDivU32(M, singleM);
    while (mBlocks > aicNum && mBlocks > 1u) {
        singleM = AlignUpU32(CeilDivU32(M, mBlocks - 1u), baseM);
        mBlocks = CeilDivU32(M, singleM);
    }
    cubeTiling.set_singleCoreM(singleM);
    cubeTiling.set_singleCoreK(K);              // K 不切分
    cubeTiling.set_usedCoreNum(mBlocks);        // nBlocks == 1，总 tile 数 = mBlocks

    // 序列化到 tiling 结构体
    cubeTiling.SaveToBuffer(tiling->cubeTiling, cubeTiling.GetDataSize());
    tiling->cubeTilingSize = cubeTiling.GetDataSize();

    // 启动核数
    context->SetBlockDim(aicNum);

    // workspace = 系统区 + pertoken 的 C 中转区（int32, M*N）
    size_t *currentWorkspace = context->GetWorkspaceSizes(1);
    currentWorkspace[0] = (isPertoken != 0u ? (uint64_t)M * N * sizeof(int32_t) : 0u) + systemWorkspaceSize;
    return ge::GRAPH_SUCCESS;
}
}  // namespace optiling

namespace ge {
static graphStatus InferShape(gert::InferShapeContext *context)
{
    gert::Shape *yShape = context->GetOutputShape(0);
    yShape->SetDimNum(2);
    yShape->SetDim(0, context->GetInputShape(0)->GetDim(0));
    yShape->SetDim(1, context->GetInputShape(1)->GetDim(1));
    return GRAPH_SUCCESS;
}

static graphStatus InferDataType(gert::InferDataTypeContext *context)
{
    if (context->GetOptionalInputDesc(3) != nullptr) {
        context->SetOutputDataType(0, DT_BF16);
    } else {
        context->SetOutputDataType(0, DT_INT32);
    }
    return GRAPH_SUCCESS;
}
}  // namespace ge

namespace ops {
class QmmCustom : public OpDef {
public:
    explicit QmmCustom(const char *name) : OpDef(name) {
        this->Input("x1")
            .ParamType(REQUIRED)
            .DataType({ge::DT_INT8, ge::DT_INT8})
            .Format({ge::FORMAT_ND, ge::FORMAT_ND});
        this->Input("x2")
            .ParamType(REQUIRED)
            .DataType({ge::DT_INT8, ge::DT_INT8})
            .Format({ge::FORMAT_ND, ge::FORMAT_ND});
        this->Input("scale")
            .ParamType(REQUIRED)
            .DataType({ge::DT_FLOAT, ge::DT_FLOAT})
            .Format({ge::FORMAT_ND, ge::FORMAT_ND});
        this->Input("pertoken_scale")
            .ParamType(OPTIONAL)
            .DataType({ge::DT_FLOAT, ge::DT_FLOAT})
            .Format({ge::FORMAT_ND, ge::FORMAT_ND});
        this->Output("y")
            .ParamType(REQUIRED)
            .DataType({ge::DT_BF16, ge::DT_INT32})
            .Format({ge::FORMAT_ND, ge::FORMAT_ND});
        this->SetInferShape(ge::InferShape).SetInferDataType(ge::InferDataType);
        this->AICore()
            .SetTiling(optiling::TilingFunc)
            .AddConfig("ascend910b");
    }
};
OP_ADD(QmmCustom);
}  // namespace ops

# kernel源码
npu_op_kernel_sources(ascendc_kernels
    KERNEL_DIR ./
)

# kernel动态库
npu_op_kernel_library(ascendc_kernels
    SRC_BASE ${CMAKE_CURRENT_SOURCE_DIR}
    TILING_LIBRARY cust_optiling
)

# 添加到package中
npu_op_package_add(${package_name}
    LIBRARY ascendc_kernels
)

// Tiling结构体定义的头文件
#pragma once

#include <cstdint>

struct QmmCustomTilingData {
    uint32_t M;
    uint32_t N;
    uint32_t K;
    uint32_t isPertoken;       // 0: 非pertoken模式(int32输出)  1: pertoken模式(bf16输出)
    uint64_t sysWorkspaceSize; // 系统workspace字节数（用户workspace在其后）
    uint32_t aRowStride;       // x1 物理行跨步（正常=K）
    uint32_t bKStride;         // x2 NZ 物理 K 跨步（正常=K）
    uint32_t cubeTilingSize;   // cubeTiling有效字节数
    uint8_t cubeTiling[256];   // TCubeTiling序列化数据
};

// Kernel侧核函数实现
#include "kernel_operator.h"
#include "lib/matmul_intf.h"   // Matmul高阶API

#include "qmm_custom_tiling.h"
#include "tiling_key_qmm_custom.h"

using namespace AscendC;

namespace {
constexpr uint32_t DEQUANT_CHUNK = 2048;   // 反量化每次处理的列数
constexpr uint32_t SCALE_CAP = 24576;      // scale在UB中缓存的最大列数（96KB）
}

template <class DT_X1>
class KernelQmmCustom {
public:
    __aicore__ inline KernelQmmCustom() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertoken_scale,
                                GM_ADDR y, GM_ADDR workspace, const QmmCustomTilingData &tilingData) {
        M = tilingData.M;
        N = tilingData.N;
        K = tilingData.K;
        isPertoken = tilingData.isPertoken;

        // 从tiling结构体拷贝TCubeTiling（标量方式，参考官方样例CopyTiling）
        uint32_t *dst = reinterpret_cast<uint32_t *>(&cubeTiling);
        const uint32_t *src = reinterpret_cast<const uint32_t *>(tilingData.cubeTiling);
        for (uint32_t i = 0; i < sizeof(TCubeTiling) / sizeof(uint32_t); ++i) {
            dst[i] = src[i];
        }

        // 按cube tiling进行二维核映射（参考官方样例CalcGMOffset）
        uint32_t blockIdx = GetBlockIdx();
        uint32_t singleM = static_cast<uint32_t>(cubeTiling.singleCoreM);
        uint32_t singleN = static_cast<uint32_t>(cubeTiling.singleCoreN);
        uint32_t mSingleBlocks = (M + singleM - 1) / singleM;
        uint32_t mCoreIndx = blockIdx % mSingleBlocks;
        uint32_t nCoreIndx = blockIdx / mSingleBlocks;
        mStart = mCoreIndx * singleM;
        nStart = nCoreIndx * singleN;   // host已强制nBlocks==1，此处恒为0
        mCur = 0;
        nCur = 0;
        if (mStart < M) {
            mCur = (mStart + singleM <= M) ? singleM : (M - mStart);
        }
        if (nStart < N) {
            nCur = (nStart + singleN <= N) ? singleN : (N - nStart);
        }
        // 超出cube tiling使用核数的block不参与计算
        hasWork = (mCur > 0u) && (nCur > 0u) && (blockIdx < static_cast<uint32_t>(cubeTiling.usedCoreNum));

        // A: ND [M, K]，行切片偏移 mStart * K
        aGM.SetGlobalBuffer(reinterpret_cast<__gm__ DT_X1 *>(x1) + static_cast<uint64_t>(mStart) * K);
        // B: NZ [K, N]。host已强制N方向单tile，B基址恒为x2起点，
        // NZ内部的K块/N块交织寻址完全交给Matmul处理
        bGM.SetGlobalBuffer(reinterpret_cast<__gm__ DT_X1 *>(x2));
        scaleGM.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale));
        ptGM.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(pertoken_scale));

        // C: ND [M, N]，tile原点偏移 mStart * N + nStart
        uint64_t offsetC = static_cast<uint64_t>(mStart) * N + nStart;
        if (isPertoken != 0u) {
            // pertoken模式：Cube中间结果写入用户workspace。
            // 注意跳过系统workspace（KFC通信区）：系统区在workspace起始处，不跳过会被踩
            __gm__ uint8_t *wsBase = workspace;   // GM_ADDR即 __gm__ uint8_t *
            if (GetSysWorkSpacePtr() == workspace) {
                wsBase += tilingData.sysWorkspaceSize;
            }
            cGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(wsBase) + offsetC);
            yGM.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y) + offsetC);
        } else {
            // 非pertoken模式：int32结果直接写入输出y
            cGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y) + offsetC);
        }
    }

    __aicore__ inline void Process() {
        // 使用Matmul高阶API必须确保系统workspace已被框架设置
        if (GetSysWorkSpacePtr() == nullptr) {
            return;
        }
        // INT8 x INT8 -> INT32 矩阵乘法，x1为ND格式，x2为NZ格式
        Matmul<MatmulType<TPosition::GM, CubeFormat::ND, DT_X1>,
               MatmulType<TPosition::GM, CubeFormat::NZ, DT_X1>,
               MatmulType<TPosition::GM, CubeFormat::ND, int32_t>,
               MatmulType<TPosition::GM, CubeFormat::ND, int32_t>> mm;
        // 所有核（包括没分到任务的核）都必须注册Matmul对象：
        // AIC侧在此进入服务循环等待AIV消息，若AIV不注册，配对的AIC会一直死等导致超时。
        REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &cubeTiling);

        if (hasWork) {
            mm.SetTensorA(aGM);
            mm.SetTensorB(bGM);
            mm.SetTail(static_cast<int32_t>(mCur), static_cast<int32_t>(nCur));
            mm.IterateAll(cGM);
        }
        // 显式结束，通知AIC退出服务循环
        mm.End();

        if (isPertoken != 0u && hasWork) {
            // 等待Cube结果写回GM后，再由Vector做反量化
            AscendC::PipeBarrier<PIPE_ALL>();
            Dequant();
        }
    }

private:
    // pertoken模式反量化：y[m, n] = BF16(C[m, n] * scale[n] * pertoken_scale[m])
    // 处理本核tile：行 [mStart, mStart+mCur)，列 [nStart, nStart+nCur)
    // 性能优化（位精确，不改变任何数值）：
    //   1. scale 整段缓存进 UB——每核只从 GM 读一次，不再每行重复加载
    //   2. pertoken_scale 预取进 UB——消除每行一次的标量 GM 读（每次约数百ns）
    //   3. C 输入/输出队列双缓冲——搬运与计算流水
    __aicore__ inline void Dequant() {
        pipe.InitBuffer(cQue, 2, DEQUANT_CHUNK * sizeof(int32_t));
        pipe.InitBuffer(bfQue, 2, DEQUANT_CHUNK * sizeof(bfloat16_t));
        pipe.InitBuffer(scaleQue, 1, SCALE_CAP * sizeof(float));
        pipe.InitBuffer(ptQue, 1, 4096 * sizeof(float));
        pipe.InitBuffer(fBuf, DEQUANT_CHUNK * sizeof(float));

        // 本 tile 行范围的 pertoken_scale 预取进 UB
        LocalTensor<float> ptLocal = ptQue.AllocTensor<float>();
        DataCopyExtParams pParams{1, static_cast<uint32_t>(mCur * sizeof(float)), 0, 0, 0};
        DataCopyPadExtParams<float> pPad{false, 0, 0, 0};
        DataCopyPad(ptLocal, ptGM[mStart], pParams, pPad);
        ptQue.EnQue(ptLocal);
        ptLocal = ptQue.DeQue<float>();
        // 标量读 UB 前做一次全管线同步，确保 MTE2 写入可见
        AscendC::PipeBarrier<PIPE_ALL>();

        // cGM/yGM 已偏移到 tile 原点(mStart*N + nStart)，tile 内行跨步为 N
        for (uint32_t nBase = 0; nBase < nCur; nBase += SCALE_CAP) {
            uint32_t nLen = (nCur - nBase) < SCALE_CAP ? (nCur - nBase) : SCALE_CAP;
            // scale 整段缓存进 UB，整个 m 循环复用
            LocalTensor<float> scaleLocal = scaleQue.AllocTensor<float>();
            DataCopyExtParams sParams{1, static_cast<uint32_t>(nLen * sizeof(float)), 0, 0, 0};
            DataCopyPadExtParams<float> sPad{false, 0, 0, 0};
            DataCopyPad(scaleLocal, scaleGM[nStart + nBase], sParams, sPad);
            scaleQue.EnQue(scaleLocal);
            scaleLocal = scaleQue.DeQue<float>();

            for (uint32_t m = 0; m < mCur; ++m) {
                float ptVal = ptLocal.GetValue(m);
                uint64_t rowOff = static_cast<uint64_t>(m) * N + nBase;
                for (uint32_t n0 = 0; n0 < nLen; n0 += DEQUANT_CHUNK) {
                    uint32_t curN = (n0 + DEQUANT_CHUNK <= nLen) ? DEQUANT_CHUNK : (nLen - n0);

                    // 搬入 int32 中间结果
                    LocalTensor<int32_t> cLocal = cQue.AllocTensor<int32_t>();
                    DataCopyExtParams cParams{1, static_cast<uint32_t>(curN * sizeof(int32_t)), 0, 0, 0};
                    DataCopyPadExtParams<int32_t> cPad{false, 0, 0, 0};
                    DataCopyPad(cLocal, cGM[rowOff + n0], cParams, cPad);
                    cQue.EnQue(cLocal);
                    cLocal = cQue.DeQue<int32_t>();

                    // int32 -> float32，per-channel 反量化（乘 scale[n]）
                    LocalTensor<float> fLocal = fBuf.Get<float>();
                    Cast(fLocal, cLocal, RoundMode::CAST_NONE, curN);
                    cQue.FreeTensor(cLocal);
                    Mul(fLocal, fLocal, scaleLocal[n0], curN);
                    // per-token 反量化（乘 pertoken_scale[m]）
                    Muls(fLocal, fLocal, ptVal, curN);

                    // float32 -> bfloat16（四舍五入），写回输出
                    LocalTensor<bfloat16_t> bfLocal = bfQue.AllocTensor<bfloat16_t>();
                    Cast(bfLocal, fLocal, RoundMode::CAST_RINT, curN);
                    bfQue.EnQue(bfLocal);
                    bfLocal = bfQue.DeQue<bfloat16_t>();
                    DataCopyExtParams yParams{1, static_cast<uint32_t>(curN * sizeof(bfloat16_t)), 0, 0, 0};
                    DataCopyPad(yGM[rowOff + n0], bfLocal, yParams);
                    bfQue.FreeTensor(bfLocal);
                }
            }
            scaleQue.FreeTensor(scaleLocal);
        }
        ptQue.FreeTensor(ptLocal);
    }

private:
    GlobalTensor<DT_X1> aGM;
    GlobalTensor<DT_X1> bGM;
    GlobalTensor<float> scaleGM;
    GlobalTensor<float> ptGM;
    GlobalTensor<int32_t> cGM;
    GlobalTensor<bfloat16_t> yGM;
    TCubeTiling cubeTiling;
    TPipe pipe;
    TQue<TPosition::VECIN, 2> cQue;     // 反量化 C 输入（双缓冲）
    TQue<TPosition::VECIN, 1> scaleQue; // scale 缓存
    TQue<TPosition::VECIN, 1> ptQue;    // pertoken_scale 预取
    TBuf<TPosition::VECCALC> fBuf;
    TQue<TPosition::VECOUT, 2> bfQue;   // 反量化输出（双缓冲）
    uint32_t M = 0;
    uint32_t N = 0;
    uint32_t K = 0;
    uint32_t isPertoken = 0;
    uint32_t mStart = 0;
    uint32_t nStart = 0;
    uint32_t mCur = 0;
    uint32_t nCur = 0;
    bool hasWork = false;
};

template <typename DT_X1>
__global__ __aicore__ void qmm_custom(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertoken_scale,
                                      GM_ADDR y, GM_ADDR workspace, GM_ADDR tiling) {
    REGISTER_TILING_DEFAULT(QmmCustomTilingData);
    GET_TILING_DATA_WITH_STRUCT(QmmCustomTilingData, tiling_data, tiling);
    KernelQmmCustom<DT_X1> op;
    op.Init(x1, x2, scale, pertoken_scale, y, workspace, tiling_data);
    op.Process();
}

// TilingKey模板定义的头文件
#pragma once

#include "ascendc/host_api/tiling/template_argument.h"

ASCENDC_TPL_ARGS_DECL(QmmCustom,
    ASCENDC_TPL_DATATYPE_DECL(DT_X1, C_DT_INT8),
);

ASCENDC_TPL_SEL(
    ASCENDC_TPL_ARGS_SEL(
        ASCENDC_TPL_DATATYPE_SEL(DT_X1, C_DT_INT8),
    ),
);
using namespace AscendC;

// ============================================================
// 任务一: TilingData 结构体 + Tiling 函数
// ============================================================

static inline uint32_t DivUp(uint32_t value, uint32_t divisor) {
  return (value + divisor - 1) / divisor;
}

static inline uint32_t RoundUp(uint32_t value, uint32_t alignment) {
  return ((value + alignment - 1) / alignment) * alignment;
}

static inline uint32_t MinU32(uint32_t first, uint32_t second) {
  return first < second ? first : second;
}

static inline uint32_t MaxU32(uint32_t first, uint32_t second) {
  return first > second ? first : second;
}

#pragma pack(push, 8)
struct alignas(8) QmmCustomTilingData {
  TCubeTiling cubeTilingData;
  uint32_t isPertoken;
  uint32_t workspaceSize;
  uint32_t dimM;
  uint32_t dimN;
  uint32_t dimK;
  uint32_t blocksPerRow;
  uint32_t blocksPerCol;
  uint32_t rowsPerCore;
  uint32_t colsPerCore;
};
#pragma pack(pop)

static QmmCustomTilingData CalcQmmTiling(uint32_t isPertoken, uint32_t M,
                                         uint32_t N, uint32_t K) {
  // LLM 推理中形状重复出现（decode M=1, prefill M=50/4096），缓存避免重复调用 GetTiling()
  static std::mutex cacheMutex;
  static std::map<std::tuple<uint32_t, uint32_t, uint32_t, uint32_t>,
                  QmmCustomTilingData> tilingCache;

  {
    std::lock_guard<std::mutex> guard(cacheMutex);
    auto found = tilingCache.find({isPertoken, M, N, K});
    if (found != tilingCache.end()) {
      return found->second;
    }
  }

  QmmCustomTilingData tilingData{};
  auto platformInfo =
      platform_ascendc::PlatformAscendCManager::GetInstance();

  uint32_t availableCores = platformInfo->GetCoreNumAic();
  if (availableCores == 0) {
    availableCores = platformInfo->GetCoreNum();
  }
  availableCores = MaxU32(1, availableCores);

  // Qwen3-8B 热点形状以 N 为主。M≤64 时只切 N 维度让 decode/prefill 利用多核；大 M 则 M/N 双切
  const uint32_t groupM = (M <= 16) ? 16 : (M < 128 ? 32 : 128);
  // FRACTAL_NZ 格式要求 baseN 固定 256，小 M 用 128 会导致部分单核 N 形状读错 NZ 块
  const uint32_t groupN = 256;
  const uint32_t groupK = 128;

  uint32_t mGroups = 1;
  uint32_t nGroups = 1;
  if (M <= 64) {
    nGroups = MinU32(availableCores, DivUp(N, groupN));
  } else {
    uint32_t targetNGroups = 4;
    if (N >= 24576) {
      targetNGroups = 10;
    } else if (N >= 6144) {
      targetNGroups = 6;
    }
    targetNGroups = MinU32(targetNGroups, DivUp(N, groupN));
    targetNGroups = MinU32(targetNGroups, availableCores);
    // 优先选能整除AIC核数的 N 分块数，避免如20核设备上 3×6 只用18核
    while (targetNGroups > 1 &&
           availableCores % targetNGroups != 0) {
      --targetNGroups;
    }
    nGroups = MaxU32(1, targetNGroups);
    mGroups = MinU32(DivUp(M, 128), MaxU32(1, availableCores / nGroups));
    nGroups = MinU32(DivUp(N, groupN), MaxU32(1, availableCores / mGroups));
  }

  uint32_t coreRows = MinU32(M, RoundUp(DivUp(M, mGroups), 16));
  // x2 为 FRACTAL_NZ 格式，各核 N 起始偏移需 32 对齐（16 对齐会让后续分块读错 NZ 位置）
  uint32_t coreCols = MinU32(N, RoundUp(DivUp(N, nGroups), 32));
  mGroups = DivUp(M, coreRows);
  nGroups = DivUp(N, coreCols);
  uint32_t totalBlocks = mGroups * nGroups;

  matmul_tiling::MultiCoreMatmulTiling matmulTiler(*platformInfo);
  matmulTiler.SetDim(totalBlocks);
  matmulTiler.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       matmul_tiling::DataType::DT_INT8);
  matmulTiler.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::NZ,
                       matmul_tiling::DataType::DT_INT8);
  matmulTiler.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                       matmul_tiling::DataType::DT_INT32);
  matmulTiler.SetOrgShape(M, N, K, K);
  matmulTiler.SetSingleShape(coreRows, coreCols, K);
  matmulTiler.SetFixSplit(groupM, groupN, groupK);
  matmulTiler.SetBufferSpace(-1, -1, -1);
  matmulTiler.EnableBias(false);
  int64_t status = matmulTiler.GetTiling(tilingData.cubeTilingData);
  TORCH_CHECK(status != -1, "QmmCustom GetTiling failed for M=", M,
              ", N=", N, ", K=", K);

  tilingData.isPertoken = isPertoken;
  tilingData.dimM = M;
  tilingData.dimN = N;
  tilingData.dimK = K;
  tilingData.rowsPerCore = tilingData.cubeTilingData.singleCoreM;
  tilingData.colsPerCore = tilingData.cubeTilingData.singleCoreN;
  tilingData.blocksPerRow = DivUp(M, tilingData.rowsPerCore);
  tilingData.blocksPerCol = DivUp(N, tilingData.colsPerCore);
  tilingData.cubeTilingData.usedCoreNum =
      tilingData.blocksPerRow * tilingData.blocksPerCol;

  uint64_t scratchBytes = isPertoken ? (uint64_t)M * (uint64_t)N * sizeof(int32_t)
                                     : 32;
  scratchBytes = RoundUp((uint32_t)scratchBytes, 512);
  tilingData.workspaceSize = (uint32_t)scratchBytes;

  {
    std::lock_guard<std::mutex> guard(cacheMutex);
    tilingCache[{isPertoken, M, N, K}] = tilingData;
  }
  return tilingData;
}

// ============================================================
// 辅助函数 (device-side)
// ============================================================

__aicore__ inline uint32_t MinDev(uint32_t first, uint32_t second) {
  return first < second ? first : second;
}

__aicore__ inline void CalcTile(const QmmCustomTilingData *td,
                                uint32_t blockIdx, uint32_t &offsetM,
                                uint32_t &offsetN, uint32_t &countM,
                                uint32_t &countN) {
  uint32_t blockM = blockIdx % td->blocksPerRow;
  uint32_t blockN = blockIdx / td->blocksPerRow;
  offsetM = blockM * td->rowsPerCore;
  offsetN = blockN * td->colsPerCore;
  countM = MinDev(td->rowsPerCore, td->dimM - offsetM);
  countN = MinDev(td->colsPerCore, td->dimN - offsetN);
}

using QmmAType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
using QmmBType = MatmulType<TPosition::GM, CubeFormat::NZ, int8_t>;
using QmmCType = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using QmmBiasType = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;

// ============================================================
// 任务二: 纯 Cube 路径 — Path 1, INT32 输出
// ============================================================

class QmmCubeBasicKernel {
public:
  __aicore__ inline QmmCubeBasicKernel() {}

  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                              GM_ADDR y, GM_ADDR workSpace,
                              const QmmCustomTilingData *__restrict tilingData,
                              TPipe *tPipe);

  __aicore__ inline void Process();

private:
  GlobalTensor<int8_t>  inputA_;
  GlobalTensor<int8_t>  inputB_;
  GlobalTensor<int32_t> output_;
  const QmmCustomTilingData *td_;
  TPipe *pipeline_;
};

__aicore__ inline void QmmCubeBasicKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y, GM_ADDR workSpace,
    const QmmCustomTilingData *__restrict tilingData, TPipe *tPipe) {
  inputA_.SetGlobalBuffer((__gm__ int8_t *)x1, tilingData->dimM * tilingData->dimK);
  inputB_.SetGlobalBuffer((__gm__ int8_t *)x2, tilingData->dimK * tilingData->dimN);
  output_.SetGlobalBuffer((__gm__ int32_t *)y, tilingData->dimM * tilingData->dimN);
  td_ = tilingData;
  pipeline_ = tPipe;
}

__aicore__ inline void QmmCubeBasicKernel::Process() {
  if ASCEND_IS_AIV {
    return;
  }
  uint32_t block = GetBlockIdx();
  if (block >= td_->cubeTilingData.usedCoreNum) {
    return;
  }

  uint32_t offsetM = 0;
  uint32_t offsetN = 0;
  uint32_t countM = 0;
  uint32_t countN = 0;
  CalcTile(td_, block, offsetM, offsetN, countM, countN);

  uint64_t addrA = (uint64_t)offsetM * td_->dimK;
  uint64_t addrB = (uint64_t)offsetN * td_->dimK;
  uint64_t addrC = (uint64_t)offsetM * td_->dimN + offsetN;

  Matmul<QmmAType, QmmBType, QmmCType, QmmBiasType> matmul;
  REGIST_MATMUL_OBJ(pipeline_, GetSysWorkSpacePtr(), matmul,
                    &td_->cubeTilingData);
  matmul.SetTail(countM, countN, td_->dimK);
  matmul.SetTensorA(inputA_[addrA]);
  matmul.SetTensorB(inputB_[addrB]);
  matmul.IterateAll(output_[addrC]);
  matmul.End();
}

// ============================================================
// 任务三: Cube+Vector 路径 — Path 2, BF16 输出 (反量化)
// ============================================================

class QmmPertokenKernel {
public:
  __aicore__ inline QmmPertokenKernel() {}

  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                              GM_ADDR pertokenScale, GM_ADDR y,
                              GM_ADDR workSpace,
                              const QmmCustomTilingData *__restrict tilingData,
                              TPipe *tPipe);

  __aicore__ inline void Process();

private:
  static constexpr uint32_t VECTOR_LENGTH = 2048;
  GlobalTensor<int8_t>  inputA_;
  GlobalTensor<int8_t>  inputB_;
  GlobalTensor<float>   gmScale_;
  GlobalTensor<float>   gmPertokenScale_;
  GlobalTensor<int32_t> gmWorkspace_;
  GlobalTensor<bfloat16_t> outGm_;
  const QmmCustomTilingData *td_;
  TPipe *pipeline_;
  TQue<QuePosition::VECIN, 1>  queueInt_;
  TQue<QuePosition::VECIN, 1>  queueScale_;
  TQue<QuePosition::VECOUT, 1> queueOutput_;
  TBuf<TPosition::VECCALC>     bufferFloat_;
};

__aicore__ inline void QmmPertokenKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
    GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData,
    TPipe *tPipe) {
  inputA_.SetGlobalBuffer((__gm__ int8_t *)x1,      tilingData->dimM * tilingData->dimK);
  inputB_.SetGlobalBuffer((__gm__ int8_t *)x2,      tilingData->dimK * tilingData->dimN);
  gmScale_.SetGlobalBuffer((__gm__ float *)scale,   tilingData->dimN);
  gmPertokenScale_.SetGlobalBuffer((__gm__ float *)pertokenScale, tilingData->dimM);
  gmWorkspace_.SetGlobalBuffer((__gm__ int32_t *)workSpace, tilingData->dimM * tilingData->dimN);
  outGm_.SetGlobalBuffer((__gm__ bfloat16_t *)y,    tilingData->dimM * tilingData->dimN);
  td_ = tilingData;
  pipeline_ = tPipe;

  if ASCEND_IS_AIV {
    pipeline_->InitBuffer(queueInt_,   2, VECTOR_LENGTH * sizeof(int32_t));
    pipeline_->InitBuffer(queueScale_, 1, VECTOR_LENGTH * sizeof(float));
    pipeline_->InitBuffer(queueOutput_,2, VECTOR_LENGTH * sizeof(bfloat16_t));
    pipeline_->InitBuffer(bufferFloat_,   VECTOR_LENGTH * sizeof(float));
  }
}

__aicore__ inline void QmmPertokenKernel::Process() {
  // ==== Cube 核: INT8 矩阵乘 → INT32 写入 GM 中间结果 ====
  if ASCEND_IS_AIC {
    uint32_t block = GetBlockIdx();
    if (block >= td_->cubeTilingData.usedCoreNum) {
      return;
    }

    uint32_t offsetM = 0;
    uint32_t offsetN = 0;
    uint32_t countM = 0;
    uint32_t countN = 0;
    CalcTile(td_, block, offsetM, offsetN, countM, countN);

    uint64_t addrA = (uint64_t)offsetM * td_->dimK;
    uint64_t addrB = (uint64_t)offsetN * td_->dimK;
    uint64_t addrC = (uint64_t)offsetM * td_->dimN + offsetN;

    Matmul<QmmAType, QmmBType, QmmCType, QmmBiasType> matmul;
    REGIST_MATMUL_OBJ(pipeline_, GetSysWorkSpacePtr(), matmul,
                      &td_->cubeTilingData);
    matmul.SetTail(countM, countN, td_->dimK);
    matmul.SetTensorA(inputA_[addrA]);
    matmul.SetTensorB(inputB_[addrB]);
    matmul.IterateAll(gmWorkspace_[addrC]);
    matmul.End();

    // 通知两个 AIV 核 Cube 端已完成
    CrossCoreSetFlag<0x2, PIPE_FIX>(0x8);
    CrossCoreSetFlag<0x2, PIPE_FIX>(0x9);
    return;
  }

  // ==== Vector 核: 从 GM workspace 读 INT32 → 反量化 → BF16 写出 ====
  if ASCEND_IS_AIV {
    uint32_t aivBlock = GetBlockIdx();
    uint32_t logicalBlock = aivBlock >> 1;
    uint32_t subIndex = aivBlock & 1;
    if (logicalBlock >= td_->cubeTilingData.usedCoreNum) {
      return;
    }

    // 等待 Cube 核完成
    CrossCoreWaitFlag<0x2>(0x8 + subIndex);

    uint32_t offsetM = 0;
    uint32_t offsetN = 0;
    uint32_t countM = 0;
    uint32_t countN = 0;
    CalcTile(td_, logicalBlock, offsetM, offsetN, countM, countN);

    // M 行均分给 2 个 AIV 核
    uint32_t rowStart = (countM * subIndex + 1) >> 1;
    uint32_t rowStop  = (countM * (subIndex + 1) + 1) >> 1;
    rowStop = MinDev(rowStop, countM);
    // M=1 时第二个 AIV 无行可处理，直接返回
    if (rowStart >= rowStop) {
      return;
    }

    for (uint32_t column = 0; column < countN; column += VECTOR_LENGTH) {
      uint32_t length = MinDev(VECTOR_LENGTH, countN - column);
      LocalTensor<float> localScale = queueScale_.AllocTensor<float>();
      DataCopy(localScale, gmScale_[offsetN + column], length);
      queueScale_.EnQue(localScale);
      localScale = queueScale_.DeQue<float>();

      for (uint32_t r = rowStart; r < rowStop; ++r) {
        uint32_t globalR = offsetM + r;
        float pertokenValue = gmPertokenScale_.GetValue(globalR);
        uint64_t rowAddr = (uint64_t)globalR * td_->dimN + offsetN;

        LocalTensor<int32_t>    localInt   = queueInt_.AllocTensor<int32_t>();
        LocalTensor<float>      localFloat = bufferFloat_.Get<float>();
        LocalTensor<bfloat16_t> localOutput= queueOutput_.AllocTensor<bfloat16_t>();

        DataCopy(localInt, gmWorkspace_[rowAddr + column], length);
        queueInt_.EnQue(localInt);
        localInt = queueInt_.DeQue<int32_t>();
        Cast(localFloat, localInt, RoundMode::CAST_NONE, length);
        Mul(localFloat, localFloat, localScale, length);
        Muls(localFloat, localFloat, pertokenValue, length);
        Cast(localOutput, localFloat, RoundMode::CAST_RINT, length);
        queueOutput_.EnQue(localOutput);

        localOutput = queueOutput_.DeQue<bfloat16_t>();
        DataCopy(outGm_[rowAddr + column], localOutput, length);

        queueInt_.FreeTensor(localInt);
        queueOutput_.FreeTensor(localOutput);
      }
      queueScale_.FreeTensor(localScale);
    }
  }
}

// ============================================================
// Kernel 入口 (__mix__(1, 2): 1 个 Cube + 2 个 Vector)
// ============================================================
__global__ __mix__(1, 2) __aicore__
    void qmm_custom_kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                           GM_ADDR pertoken_scale, GM_ADDR y, GM_ADDR workspace,
                           QmmCustomTilingData tilingData) {
  if (workspace == nullptr) {
    return;
  }
  TPipe pipe;

  if (tilingData.isPertoken == 0) {
    QmmCubeBasicKernel kernel;
    kernel.Init(x1, x2, scale, y, workspace, &tilingData, &pipe);
    kernel.Process();
    pipe.Destroy();
  } else {
    QmmPertokenKernel kernel;
    kernel.Init(x1, x2, scale, pertoken_scale, y, workspace, &tilingData,
                &pipe);
    kernel.Process();
    pipe.Destroy();
  }
}

#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor {
  uint32_t type;
  uint32_t format;
  uint32_t dataType;
  uint32_t shapeDim;
  uint32_t shape[8];
};

struct aclprofTensorInfo {
  uint64_t opNameId;
  uint64_t opTypeId;
  uint32_t resv;
  uint32_t tensorNum;
  uint32_t kernelType;
  uint32_t blockNums;
  void *stream;
  aclprofTensor *tensors;
};

struct aclprofEventAttributes {
  uint16_t version;
  uint16_t size;
  uint32_t messageType;
  union message {
    aclprofTensorInfo *tensorInfo;
  } message;
};
#endif

#define INPUT(x)                                                               \
  aclprofTensor {                                                              \
    (uint32_t)0,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(x.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(x.scalar_type())),   \
        static_cast<uint32_t>(x.sizes().size()), {                             \
      static_cast<uint32_t>(x.sizes().size() > 0 ? x.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(x.sizes().size() > 1 ? x.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 2 ? x.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 3 ? x.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define OUTPUT(z)                                                              \
  aclprofTensor {                                                              \
    (uint32_t)1,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(z.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(z.scalar_type())),   \
        static_cast<uint32_t>(z.sizes().size()), {                             \
      static_cast<uint32_t>(z.sizes().size() > 0 ? z.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(z.sizes().size() > 1 ? z.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 2 ? z.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 3 ? z.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

namespace ascendc_ops {

aclDataType GetAclDataType(at::ScalarType scalarType) {
  switch (scalarType) {
  case at::ScalarType::Float:    return ACL_FLOAT;
  case at::ScalarType::Int:      return ACL_INT32;
  case at::ScalarType::BFloat16: return ACL_BF16;
  case at::ScalarType::Byte:     return ACL_UINT8;
  case at::ScalarType::Char:     return ACL_INT8;
  default:
    TORCH_CHECK(false,
                "Unsupported tensor dtype for profiling report: ", scalarType);
  }
}

aclFormat GetFormat(int64_t dimNum) {
  aclFormat format = ACL_FORMAT_ND;
  if (dimNum == 4) {
    format = ACL_FORMAT_FRACTAL_NZ;
  }
  return format;
}

// ============================================================
// Host 侧拆分为 INT32 和 BF16 两个内部函数
// ============================================================

static at::Tensor launchInt32(const at::Tensor &x1, const at::Tensor &x2,
                              const at::Tensor &scale,
                              c10_npu::NPUStream &aclStream) {
  uint32_t M = static_cast<uint32_t>(x1.size(0));
  uint32_t K = static_cast<uint32_t>(x1.size(1));
  uint32_t N = static_cast<uint32_t>(scale.size(0));

  at::Tensor y = at::empty({M, N}, x1.options().dtype(at::ScalarType::Int));

  QmmCustomTilingData tilingData = CalcQmmTiling(0, M, N, K);
  uint32_t numBlocks = tilingData.cubeTilingData.usedCoreNum;

  at::Tensor workspaceTensor =
      at::empty({static_cast<int64_t>(tilingData.workspaceSize)},
                x1.options().dtype(at::ScalarType::Byte));

  aclprofTensorInfo tensorInfo;
  uint64_t opNameId = aclprofStr2Id("qmm_custom");
  uint64_t opTypeId = aclprofStr2Id("QmmCustom");
  std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale),
                                        OUTPUT(y)};
  tensorInfo = {opNameId, opTypeId, 0, (uint32_t)tensors.size(),
                0, numBlocks, aclStream.stream(true), tensors.data()};

  aclprofEventAttributes attrs{};
  attrs.version = 1;
  attrs.size = sizeof(aclprofEventAttributes);
  attrs.messageType = 0;
  attrs.message.tensorInfo = &tensorInfo;

  aclprofRangePushEx(&attrs);
  qmm_custom_kernel<<<numBlocks, 0, aclStream.stream(true)>>>(
      (uint8_t *)(x1.mutable_data_ptr()),
      (uint8_t *)(x2.mutable_data_ptr()),
      (uint8_t *)(scale.mutable_data_ptr()), nullptr,
      (uint8_t *)(y.mutable_data_ptr()),
      workspaceTensor.data_ptr<uint8_t>(), tilingData);
  aclprofRangePop();
  return y;
}

static at::Tensor launchBf16(const at::Tensor &x1, const at::Tensor &x2,
                             const at::Tensor &scale,
                             const at::Tensor &pertokenScale,
                             c10_npu::NPUStream &aclStream) {
  uint32_t M = static_cast<uint32_t>(x1.size(0));
  uint32_t K = static_cast<uint32_t>(x1.size(1));
  uint32_t N = static_cast<uint32_t>(scale.size(0));

  at::Tensor y =
      at::empty({M, N}, x1.options().dtype(at::ScalarType::BFloat16));

  QmmCustomTilingData tilingData = CalcQmmTiling(1, M, N, K);
  uint32_t numBlocks = tilingData.cubeTilingData.usedCoreNum;

  at::Tensor workspaceTensor =
      at::empty({static_cast<int64_t>(tilingData.workspaceSize)},
                x1.options().dtype(at::ScalarType::Byte));

  aclprofTensorInfo tensorInfo;
  uint64_t opNameId = aclprofStr2Id("qmm_custom");
  uint64_t opTypeId = aclprofStr2Id("QmmCustom");
  uint8_t *pertokenPtr = (uint8_t *)(pertokenScale.mutable_data_ptr());
  std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale),
                                        INPUT(pertokenScale), OUTPUT(y)};
  tensorInfo = {opNameId, opTypeId, 0, (uint32_t)tensors.size(),
                0, numBlocks, aclStream.stream(true), tensors.data()};

  aclprofEventAttributes attrs{};
  attrs.version = 1;
  attrs.size = sizeof(aclprofEventAttributes);
  attrs.messageType = 0;
  attrs.message.tensorInfo = &tensorInfo;

  aclprofRangePushEx(&attrs);
  qmm_custom_kernel<<<numBlocks, 0, aclStream.stream(true)>>>(
      (uint8_t *)(x1.mutable_data_ptr()),
      (uint8_t *)(x2.mutable_data_ptr()),
      (uint8_t *)(scale.mutable_data_ptr()), pertokenPtr,
      (uint8_t *)(y.mutable_data_ptr()),
      workspaceTensor.data_ptr<uint8_t>(), tilingData);
  aclprofRangePop();
  return y;
}

at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2,
                      const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale) {
  TORCH_CHECK(x1.dim() == 2, "x1 must be [M, K]");
  TORCH_CHECK(x2.dim() >= 2, "x2 must represent [K, N]");
  TORCH_CHECK(scale.dim() == 1, "scale must be [N]");

  auto M = static_cast<uint32_t>(x1.size(0));
  auto K = static_cast<uint32_t>(x1.size(1));
  auto N = static_cast<uint32_t>(scale.size(0));
  TORCH_CHECK(x2.numel() == static_cast<int64_t>(K) * static_cast<int64_t>(N),
              "x2 storage size must be K*N for FRACTAL_NZ weight");

  c10_npu::NPUStream aclStream = c10_npu::getCurrentNPUStream();

  bool withPertoken =
      pertoken_scale.has_value() && pertoken_scale.value().defined();

  if (withPertoken) {
    return launchBf16(x1, x2, scale, pertoken_scale.value(), aclStream);
  } else {
    return launchInt32(x1, x2, scale, aclStream);
  }
}

} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m) {
  m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? "
        "pertoken_scale=None) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m) {
  m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}

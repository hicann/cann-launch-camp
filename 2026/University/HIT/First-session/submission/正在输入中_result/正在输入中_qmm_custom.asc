#include "acl/acl_base.h"
#include "acl/acl_prof.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <torch/extension.h>

// TODO: 任务一: 自行设计tilingdata结构体并实现tiling函数
// [TASK1-START] ---------------------------------------------------------
using namespace matmul;

__aicore__ inline int32_t QmmCeilDiv(int32_t value, int32_t factor)
{
    return (value + factor - 1) / factor;
}

// 自适应 baseM/baseN: 小 M 用大 baseN, 大 M 用大 baseM 减少 tile 数
static inline int32_t SelectBaseM(uint32_t M) {
    return (M <= 16U) ? 16 : (M <= 64U ? 32 : 128);
}
static inline int32_t SelectBaseN(uint32_t M, uint32_t N) {
    return (M <= 16U && N != 6144U) ? 256 : 128;
}

static inline int32_t AlignUp(int32_t val, int32_t align)
{
    return (val + align - 1) & ~(align - 1);
}

// 选择能整除 nTileCount 的最大核数 (不超过 maxCores)
static inline int32_t ChooseAlignedDim(int32_t nTileCount, int32_t maxCores) {
    int32_t candidate = (nTileCount < maxCores) ? nTileCount : maxCores;
    while (candidate > 1 && nTileCount % candidate != 0) { --candidate; }
    return candidate;
}

// 核切片: 每核负责 [mStart,mStart+mSize) x [nStart,nStart+nSize)
struct CoreSlice {
    int32_t mStart, nStart, mSize, nSize;
};

__aicore__ inline CoreSlice GetCoreSlice(const TCubeTiling &t) {
    int32_t blockIdx = static_cast<int32_t>(AscendC::GetBlockIdx());
    int32_t mBlocks = QmmCeilDiv(static_cast<int32_t>(t.M),
                                  static_cast<int32_t>(t.singleCoreM));
    int32_t mCoreIdx = blockIdx % mBlocks;
    int32_t nCoreIdx = blockIdx / mBlocks;
    int32_t mStart = mCoreIdx * static_cast<int32_t>(t.singleCoreM);
    int32_t nStart = nCoreIdx * static_cast<int32_t>(t.singleCoreN);
    return {mStart, nStart,
        (mStart + t.singleCoreM <= t.M) ? t.singleCoreM : (t.M - mStart),
        (nStart + t.singleCoreN <= t.N) ? t.singleCoreN : (t.N - nStart)};
}

__aicore__ inline uint32_t MinU32(uint32_t a, uint32_t b) { return a < b ? a : b; }

template <typename DstT, typename SrcT>
__aicore__ inline void CastInSegments(
    const AscendC::LocalTensor<DstT> &dst,
    const AscendC::LocalTensor<SrcT> &src,
    AscendC::RoundMode roundMode, uint32_t count) {
    constexpr uint32_t kMaxCast = 255U * 64U;
    uint32_t first = MinU32(count, kMaxCast);
    AscendC::Cast(dst, src, roundMode, first);
    if (count > first) {
        AscendC::Cast(dst[first], src[first], roundMode, count - first);
    }
}
// [TASK1-END] -----------------------------------------------------------

#pragma pack(push, 8)
struct alignas(8) QmmCustomTilingData {
  // TODO: 自行设计tilingData结构体
  // [TASK1-START] -------------------------------------------------------
  TCubeTiling cubeTilingData;
  uint32_t isPertoken;
  uint32_t workspaceSize;
  uint32_t M;
  uint32_t N;
  uint32_t K;
  // [TASK1-END] ---------------------------------------------------------
};
#pragma pack(pop)

// 计算QmmCustom tiling参数,返回tilingData结构体
static QmmCustomTilingData CalcQmmTiling(uint32_t isPertoken, uint32_t M,
                                         uint32_t N, uint32_t K) {
  QmmCustomTilingData tilingData;
  auto ascendcPlatform =
      platform_ascendc::PlatformAscendCManager::GetInstance();
  // [TASK1-START] -------------------------------------------------------
  tilingData.isPertoken = isPertoken;
  tilingData.M = M;
  tilingData.N = N;
  tilingData.K = K;

  // Grid-stride 多核: 自适应 baseM/baseN, 用 aivNum 核数
  matmul_tiling::MultiCoreMatmulTiling cubeTiling(*ascendcPlatform);
  int32_t aicCores = static_cast<int32_t>(ascendcPlatform->GetCoreNumAic());
  int32_t aivCores = static_cast<int32_t>(ascendcPlatform->GetCoreNumAiv());

  // A: INT8 ND [M,K];  B: INT8 FRACTAL_NZ [K,N]
  cubeTiling.SetAType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT8);
  cubeTiling.SetBType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::NZ,
                      matmul_tiling::DataType::DT_INT8);

  int32_t baseM = SelectBaseM(M);
  int32_t baseN = SelectBaseN(M, N);
  int32_t mTiles = (static_cast<int32_t>(M) + baseM - 1) / baseM;
  int32_t nTiles = (static_cast<int32_t>(N) + baseN - 1) / baseN;
  // 核数选择: __aicore__ 模式最多 aicCores (24) 个 block
  int32_t usedCores;
  if (M <= 64U) {
    usedCores = ChooseAlignedDim(nTiles, aicCores);
  } else {
    usedCores = aicCores;
  }
  if (usedCores < 1) { usedCores = 1; }

  cubeTiling.SetDim(usedCores);
  cubeTiling.SetFixSplit(baseM, baseN, -1);
  cubeTiling.SetAlignSplit(-1, baseN, -1);
  cubeTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM);

  if (isPertoken != 0) {
    // Path 2: C 走 VECIN, Cube 结果经 GetTensorC 拉到 AIV LocalTensor 反量化.
    cubeTiling.SetCType(matmul_tiling::TPosition::VECIN,
                        matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_INT32);
  } else {
    // Path 1: C 走 GM, Cube 结果直接写入输出 GM (INT32).
    cubeTiling.SetCType(matmul_tiling::TPosition::GM,
                        matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_INT32);
  }
  cubeTiling.SetBias(false);

  cubeTiling.SetShape(static_cast<int32_t>(M), static_cast<int32_t>(N),
                      static_cast<int32_t>(K));
  cubeTiling.SetOrgShape(static_cast<int32_t>(M), static_cast<int32_t>(N),
                         static_cast<int32_t>(K));
  cubeTiling.SetBufferSpace(-1, -1, -1);

  cubeTiling.GetTiling(tilingData.cubeTilingData);
  // 让库自动计算 usedCoreNum, 不覆盖

  // workspace 仅用于 Matmul 高阶 API 的 KFC 系统工作区
  tilingData.workspaceSize =
      static_cast<uint32_t>(ascendcPlatform->GetLibApiWorkSpaceSize());
  // [TASK1-END] ---------------------------------------------------------
  return tilingData;
}

// TODO: 任务二: 实现A8W8输入INT32输出的kernel
// [TASK2-START] ---------------------------------------------------------
// Path 1: 纯 Cube 路径, INT8 x INT8 -> INT32, 结果直接写入输出 GM
// GetCoreSlice: 每核负责一段 M×N, 外层 N-tile 循环, SetTensorA 仅设一次.
class QmmCubeBasicKernel {
public:
    __aicore__ inline QmmCubeBasicKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y,
                                GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData, TPipe *tPipe);

    __aicore__ inline void Process();

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>>
        matmulObj;
    TCubeTiling tiling;

private:
    AscendC::GlobalTensor<int8_t> x1Global;
    AscendC::GlobalTensor<int8_t> x2Global;
    AscendC::GlobalTensor<int32_t> yGlobal;
    TPipe *pipe;
    CoreSlice slice_{};
};

__aicore__ inline void QmmCubeBasicKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y,
    GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData, TPipe *tPipe)
{
    // [TASK2-START] ---------------------------------------------------
    this->tiling = tilingData->cubeTilingData;
    this->pipe = tPipe;
    this->slice_ = GetCoreSlice(tiling);
    x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1),
                              tiling.M * tiling.Ka);
    x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2),
                              tiling.Kb * tiling.N);
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y),
                              tiling.M * tiling.N);
    x1Global = x1Global[static_cast<uint64_t>(slice_.mStart) * tiling.Ka];
    x2Global = x2Global[static_cast<uint64_t>(slice_.nStart) * tiling.Kb];
    yGlobal = yGlobal[static_cast<uint64_t>(slice_.mStart) * tiling.N + slice_.nStart];
    // [TASK2-END] -----------------------------------------------------
}

__aicore__ inline void QmmCubeBasicKernel::Process()
{
    // [TASK2-START] ---------------------------------------------------
    REGIST_MATMUL_OBJ(pipe, GetSysWorkSpacePtr(), matmulObj, &tiling);
    matmulObj.SetOrgShape(tiling.M, tiling.N, tiling.Ka);

    matmulObj.SetTensorA(x1Global);
    for (int32_t nOff = 0; nOff < slice_.nSize; nOff += tiling.baseN) {
        int32_t tileN = (nOff + tiling.baseN < slice_.nSize) ? tiling.baseN : (slice_.nSize - nOff);
        matmulObj.SetTensorB(x2Global[static_cast<uint64_t>(nOff) * tiling.Kb]);
        matmulObj.SetSingleShape(slice_.mSize, tileN, tiling.Ka);
        matmulObj.IterateAll(yGlobal[nOff]);
    }
    matmulObj.End();
    // [TASK2-END] -----------------------------------------------------
}
// [TASK2-END] -----------------------------------------------------------
// TODO: 任务三: 实现A8W8输入, 经过perChannelScale和perTokenScale反量化输出BF16的kernel
// [TASK3-START] ---------------------------------------------------------
// Path 2: Cube+Vector 协作路径 (VECIN C 类型)
//   GetCoreSlice: 每核负责一段 M×N, 外层 N-tile 循环.
//   SetTensorA 仅设一次 (M 段不变), SetTensorB per N-tile.
class QmmPertokenKernel {
public:
    __aicore__ inline QmmPertokenKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
                                GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData,
                                TPipe *tPipe);

    __aicore__ inline void Process();

    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>,
           MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, int32_t>>
        matmulObj;
    TCubeTiling tiling;

private:
    AscendC::GlobalTensor<int8_t> x1Global;
    AscendC::GlobalTensor<int8_t> x2Global;
    AscendC::GlobalTensor<bfloat16_t> yGlobal;
    AscendC::GlobalTensor<float> scaleGlobal;
    AscendC::GlobalTensor<float> pertokenScaleGlobal;
    TPipe *pipe;
    CoreSlice slice_{};
    AscendC::TEventID mte2ToScalarEvent{};

    AscendC::TQue<AscendC::TPosition::VECIN, 1> intQueue;
    AscendC::TBuf<AscendC::TPosition::VECCALC> floatBuf;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outQueue;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> scaleNQueue;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> scaleMQueue;

    __aicore__ inline void DequantizeAndCopyOut(
        const AscendC::LocalTensor<int32_t> &matmulLocal, int32_t round,
        int32_t nChunkStart, int32_t nChunkSize);
};

__aicore__ inline void QmmPertokenKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
    GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData,
    TPipe *tPipe)
{
    // [TASK3-START] ---------------------------------------------------
    this->tiling = tilingData->cubeTilingData;
    this->pipe = tPipe;
    this->slice_ = GetCoreSlice(tiling);

    int32_t M = static_cast<int32_t>(tilingData->M);
    int32_t N = static_cast<int32_t>(tilingData->N);
    int32_t K = static_cast<int32_t>(tilingData->K);
    x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1), M * K);
    // FRACTAL_NZ 格式: K 维已对齐为 tiling.Kb, 必须用对齐后的大小
    x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2), tiling.Kb * N);
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y), M * N);
    scaleGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), N);
    pertokenScaleGlobal.SetGlobalBuffer(
        reinterpret_cast<__gm__ float *>(pertokenScale), M);

    x1Global = x1Global[static_cast<uint64_t>(slice_.mStart) * K];
    x2Global = x2Global[static_cast<uint64_t>(slice_.nStart) * tiling.Kb];

    int32_t baseM = static_cast<int32_t>(tiling.baseM);
    int32_t baseN = static_cast<int32_t>(tiling.baseN);
    // __aicore__ 模式: AIC 直接运行 kernel (Cube+Vector), 无需 AIV guard
    pipe->InitBuffer(intQueue, 1, baseM * baseN * sizeof(int32_t));
    pipe->InitBuffer(floatBuf, baseM * baseN * sizeof(float));
    pipe->InitBuffer(outQueue, 1, baseM * baseN * sizeof(bfloat16_t));
    pipe->InitBuffer(scaleNQueue, 1, baseN * sizeof(float));
    pipe->InitBuffer(scaleMQueue, 1, baseM * sizeof(float));
    mte2ToScalarEvent = pipe->AllocEventID<AscendC::HardEvent::MTE2_S>();
    // [TASK3-END] -----------------------------------------------------
}

__aicore__ inline void QmmPertokenKernel::DequantizeAndCopyOut(
    const AscendC::LocalTensor<int32_t> &matmulLocal, int32_t round,
    int32_t nChunkStart, int32_t nChunkSize)
{
    int32_t baseM = tiling.baseM;
    int32_t baseN = tiling.baseN;
    int32_t roundM = QmmCeilDiv(slice_.mSize, baseM);
    int32_t tileMIdx = round % roundM;
    int32_t tileNIdx = round / roundM;
    int32_t tileMStart = tileMIdx * baseM;
    int32_t tileNInChunk = tileNIdx * baseN;
    if (tileMStart >= slice_.mSize || tileNInChunk >= nChunkSize) return;
    int32_t tileNStart = nChunkStart + tileNInChunk;
    int32_t tileM = (tileMStart + baseM < slice_.mSize) ? baseM : (slice_.mSize - tileMStart);
    int32_t tileN = (tileNInChunk + baseN < nChunkSize) ? baseN : (nChunkSize - tileNInChunk);
    uint32_t validElements = static_cast<uint32_t>(tileM * tileN);

    // Scale 加载
    AscendC::LocalTensor<float> scaleNLocal = scaleNQueue.AllocTensor<float>();
    AscendC::DataCopyPad(scaleNLocal, scaleGlobal[slice_.nStart + tileNStart],
                         AscendC::DataCopyExtParams(1, static_cast<uint32_t>(tileN) * sizeof(float), 0, 0, 0),
                         AscendC::DataCopyPadExtParams<float>());
    scaleNQueue.EnQue(scaleNLocal);
    scaleNLocal = scaleNQueue.DeQue<float>();

    AscendC::LocalTensor<float> scaleMLocal = scaleMQueue.AllocTensor<float>();
    AscendC::DataCopyPad(scaleMLocal, pertokenScaleGlobal[slice_.mStart + tileMStart],
                         AscendC::DataCopyExtParams(1, static_cast<uint32_t>(tileM) * sizeof(float), 0, 0, 0),
                         AscendC::DataCopyPadExtParams<float>());
    scaleMQueue.EnQue(scaleMLocal);
    scaleMLocal = scaleMQueue.DeQue<float>();

    AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(mte2ToScalarEvent);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(mte2ToScalarEvent);

    // INT32 -> F32 (分段 Cast 防止超过 255*64 限制)
    AscendC::LocalTensor<float> floatLocal = floatBuf.Get<float>();
    CastInSegments(floatLocal, matmulLocal, AscendC::RoundMode::CAST_NONE, validElements);

    // 反量化: perChannelScale * perTokenScale
    for (int32_t row = 0; row < tileM; ++row) {
        AscendC::Mul(floatLocal[row * baseN], floatLocal[row * baseN],
                     scaleNLocal, tileN);
    }
    for (int32_t row = 0; row < tileM; ++row) {
        AscendC::Muls(floatLocal[row * baseN], floatLocal[row * baseN],
                      scaleMLocal.GetValue(row), tileN);
    }

    // F32 -> BF16 并写回 GM
    AscendC::LocalTensor<bfloat16_t> outLocal = outQueue.AllocTensor<bfloat16_t>();
    CastInSegments(outLocal, floatLocal, AscendC::RoundMode::CAST_RINT, validElements);
    outQueue.EnQue(outLocal);
    outLocal = outQueue.DeQue<bfloat16_t>();
    AscendC::DataCopyPad(yGlobal[static_cast<uint64_t>(slice_.mStart + tileMStart) * tiling.N +
                                 slice_.nStart + tileNStart], outLocal,
                         AscendC::DataCopyExtParams(static_cast<uint16_t>(tileM),
                                  static_cast<uint32_t>(tileN) * sizeof(bfloat16_t), 0,
                                  static_cast<uint32_t>(tiling.N - tileN) * sizeof(bfloat16_t), 0));
    outQueue.FreeTensor(outLocal);
    scaleNQueue.FreeTensor(scaleNLocal);
    scaleMQueue.FreeTensor(scaleMLocal);
}

__aicore__ inline void QmmPertokenKernel::Process()
{
    // [TASK3-START] ---------------------------------------------------
    // __aicore__ 模式: REGIST_MATMUL_OBJ 直接在 AIC 上注册
    REGIST_MATMUL_OBJ(pipe, GetSysWorkSpacePtr(), matmulObj, &tiling);
    matmulObj.SetOrgShape(tiling.M, tiling.N, tiling.Ka);

    matmulObj.SetTensorA(x1Global, false);
    for (int32_t nOff = 0; nOff < slice_.nSize; nOff += tiling.baseN) {
        int32_t tileN = (nOff + tiling.baseN < slice_.nSize) ? tiling.baseN : (slice_.nSize - nOff);
        matmulObj.SetTensorB(x2Global[static_cast<uint64_t>(nOff) * tiling.Kb], false);
        matmulObj.SetSingleShape(slice_.mSize, tileN, tiling.Ka);

        int32_t computeRound = 0;
        while (matmulObj.Iterate<true>()) {
            AscendC::LocalTensor<int32_t> intLocal = intQueue.AllocTensor<int32_t>();
            matmulObj.GetTensorC<true>(intLocal, false, true);
            DequantizeAndCopyOut(intLocal, computeRound, nOff, tileN);
            intQueue.FreeTensor(intLocal);
            ++computeRound;
        }
    }
    matmulObj.End();
    pipe->ReleaseEventID<AscendC::HardEvent::MTE2_S>(mte2ToScalarEvent);
    // [TASK3-END] -----------------------------------------------------
}
// [TASK3-END] -----------------------------------------------------------


__global__ __mix__(1, 2) __aicore__
    void qmm_custom_kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                           GM_ADDR pertoken_scale, GM_ADDR y, GM_ADDR __kfc_workspace__ workspace,
                           QmmCustomTilingData tilingData) {
  if (workspace == nullptr) {
    return;
  }
  TPipe pipe;

  if (tilingData.isPertoken == 0) {
    QmmCubeBasicKernel kernel;
    kernel.Init(x1, x2, scale, y, workspace, &tilingData, &pipe);
    kernel.Process();
    pipe.Destroy();
  } else {
    QmmPertokenKernel kernel;
    kernel.Init(x1, x2, scale, pertoken_scale, y, workspace, &tilingData,
                &pipe);
    kernel.Process();
    pipe.Destroy();
  }
}

#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor {
  uint32_t type;     // Tensor类型: 0表示输入, 1表示输出。
  uint32_t format;   // Format类型, 对应aclFormat。
  uint32_t dataType; // 数据类型, 对应aclDataType。
  uint32_t shapeDim; // Shape维度数量, 最大支持8维。
  uint32_t shape[8]; // Shape信息。
};

struct aclprofTensorInfo {
  uint64_t opNameId; // 通过uint64_t aclprofStr2Id(const char *message)转化
  uint64_t opTypeId; // 通过uint64_t aclprofStr2Id(const char *message)转化
  uint32_t resv;
  uint32_t tensorNum;
  uint32_t kernelType;
  uint32_t blockNums;
  void *stream;
  aclprofTensor *tensors;
};

struct aclprofEventAttributes {
  uint16_t version;
  uint16_t size;
  uint32_t messageType;
  union message {
    aclprofTensorInfo *tensorInfo;
  } message;
};
#endif // ACL_PROF_TENSOR_INFO_DEFINED

#define INPUT(x)                                                               \
  aclprofTensor {                                                              \
    (uint32_t)0,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(x.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(x.scalar_type())),   \
        static_cast<uint32_t>(x.sizes().size()), {                             \
      static_cast<uint32_t>(x.sizes().size() > 0 ? x.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(x.sizes().size() > 1 ? x.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 2 ? x.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 3 ? x.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define OUTPUT(z)                                                              \
  aclprofTensor {                                                              \
    (uint32_t)1,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(z.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(z.scalar_type())),   \
        static_cast<uint32_t>(z.sizes().size()), {                             \
      static_cast<uint32_t>(z.sizes().size() > 0 ? z.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(z.sizes().size() > 1 ? z.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 2 ? z.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 3 ? z.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define INIT_ACL_PROF_TENSOR_INFO(opName, opType, blockdim, kernelType,        \
                                  tensorInfo, stream, ...)                     \
  uint64_t opNameId = aclprofStr2Id(opName);                                   \
  uint64_t opTypeId = aclprofStr2Id(opType);                                   \
  struct aclprofTensor tensors[] = {__VA_ARGS__};                              \
  tensorInfo = {                                                               \
      opNameId,   opTypeId, 0,      sizeof(tensors) / sizeof(aclprofTensor),   \
      kernelType, blockdim, stream, tensors}

namespace ascendc_ops {

aclDataType GetAclDataType(at::ScalarType scalarType) {
  switch (scalarType) {
  case at::ScalarType::Float:
    return ACL_FLOAT;
  case at::ScalarType::Int:
    return ACL_INT32;
  case at::ScalarType::BFloat16:
    return ACL_BF16;
  case at::ScalarType::Byte:
    return ACL_UINT8;
  case at::ScalarType::Char:
    return ACL_INT8;
  default:
    TORCH_CHECK(false,
                "Unsupported tensor dtype for profiling report: ", scalarType);
  }
}

aclFormat GetFormat(int64_t dimNum) {
  aclFormat format = ACL_FORMAT_ND;
  if (dimNum == 4) {
    format = ACL_FORMAT_FRACTAL_NZ;
  }
  return format;
}

at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2,
                      const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale) {
  auto aclStream = c10_npu::getCurrentNPUStream().stream(true);

  auto M = x1.size(0);
  auto K = x1.size(1);
  auto N = x2.size(1);

  uint32_t isPertoken =
      pertoken_scale.has_value() && pertoken_scale.value().defined() ? 1 : 0;
  at::ScalarType output_dtype =
      isPertoken ? at::ScalarType::BFloat16 : at::ScalarType::Int;
  at::Tensor y = at::empty({M, N}, x1.options().dtype(output_dtype));

  QmmCustomTilingData tilingData = CalcQmmTiling(isPertoken, M, N, K);
  uint32_t numBlocks = tilingData.cubeTilingData.usedCoreNum;

  at::Tensor workspaceTensor =
      at::empty({static_cast<int64_t>(tilingData.workspaceSize)},
                x1.options().dtype(at::ScalarType::Byte));

  aclprofTensorInfo tensorInfo;
  uint64_t opNameId = aclprofStr2Id("qmm_custom");
  uint64_t opTypeId = aclprofStr2Id("QmmCustom");
  uint8_t *pertokenPtr =
      isPertoken ? (uint8_t *)(pertoken_scale.value().mutable_data_ptr())
                 : nullptr;
  std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale)};
  if (isPertoken) {
    tensors.push_back(INPUT(pertoken_scale.value()));
  }
  tensors.push_back(OUTPUT(y));
  tensorInfo = {opNameId, opTypeId,  0,         (uint32_t)tensors.size(),
                0,        numBlocks, aclStream, tensors.data()};

  aclprofEventAttributes attrs = {1, sizeof(aclprofEventAttributes::message), 0,
                                  &tensorInfo};

  aclprofRangePushEx(&attrs);
  qmm_custom_kernel<<<numBlocks, 0, aclStream>>>(
      (uint8_t *)(x1.mutable_data_ptr()), (uint8_t *)(x2.mutable_data_ptr()),
      (uint8_t *)(scale.mutable_data_ptr()), pertokenPtr,
      (uint8_t *)(y.mutable_data_ptr()), workspaceTensor.data_ptr<uint8_t>(),
      tilingData);
  aclprofRangePop();
  return y;
}
} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m) {
  m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? "
        "pertoken_scale=None) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m) {
  m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}

// Reference implementation for notebook 06:
// Custom A8W8 matmul for Qwen3-8B shapes.
//
// Paste this file body into the %%writefile {QMM_CUSTOM_DIR}/qmm_custom.asc
// cell, replacing the scaffold implementation section.

#define ASCENDC_CUBE_ONLY

#include "acl/acl_base.h"
#include "acl/acl_prof.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "lib/matmul/bmm_tiling.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <algorithm>
#include <cstdint>
#include <map>
#include <mutex>
#include <torch/extension.h>
#include <tuple>
#include <vector>

using namespace AscendC;

static inline uint32_t CeilDivHost(uint32_t x, uint32_t y) {
  return (x + y - 1) / y;
}

static inline uint32_t AlignUpHost(uint32_t x, uint32_t align) {
  return ((x + align - 1) / align) * align;
}

static inline uint32_t MinHost(uint32_t a, uint32_t b) {
  return a < b ? a : b;
}

static inline uint32_t MaxHost(uint32_t a, uint32_t b) {
  return a > b ? a : b;
}

#pragma pack(push, 8)
struct alignas(8) QmmCustomTilingData {
  TCubeTiling cubeTilingData;
  uint32_t isPertoken;
  uint32_t workspaceSize;
  uint32_t M;
  uint32_t N;
  uint32_t K;
  uint32_t mBlockNum;
  uint32_t nBlockNum;
  uint32_t singleM;
  uint32_t singleN;
};
#pragma pack(pop)

static QmmCustomTilingData CalcQmmTiling(uint32_t isPertoken, uint32_t M,
                                         uint32_t N, uint32_t K) {
  // Tiling cache: LLM inference repeats the same shapes (decode M=1,
  // prefill M=50/4096). Avoid recomputing expensive GetTiling().
  static std::mutex s_cacheMutex;
  static std::map<std::tuple<uint32_t, uint32_t, uint32_t, uint32_t>,
                  QmmCustomTilingData> s_tilingCache;

  {
    std::lock_guard<std::mutex> lock(s_cacheMutex);
    auto it = s_tilingCache.find({isPertoken, M, N, K});
    if (it != s_tilingCache.end()) {
      return it->second;
    }
  }

  QmmCustomTilingData tilingData{};
  auto ascendcPlatform =
      platform_ascendc::PlatformAscendCManager::GetInstance();

  uint32_t aicCoreNum = ascendcPlatform->GetCoreNumAic();
  if (aicCoreNum == 0) {
    aicCoreNum = ascendcPlatform->GetCoreNum();
  }
  aicCoreNum = MaxHost(1, aicCoreNum);

  // The Qwen3-8B hot shapes are N-heavy. For M <= 64, split only N so
  // decode/prefill small-M calls can use many cube cores. For large M, split
  // both M and N.
  const uint32_t baseM = (M <= 16) ? 16 : (M < 128 ? 32 : 128);
  // INT8 + FRACTAL_NZ 路径在当前 Matmul Tiling 实现中使用 256 的
  // baseN。小 M 使用 128 会使部分 single-core N 形状读取后续 NZ 块错误。
  const uint32_t baseN = 256;
  const uint32_t baseK = 128;

  uint32_t mBlocks = 1;
  uint32_t nBlocks = 1;
  if (M <= 64) {
    nBlocks = MinHost(aicCoreNum, CeilDivHost(N, baseN));
  } else {
    uint32_t preferredNBlocks = 4;
    if (N >= 24576) {
      preferredNBlocks = 10;
    } else if (N >= 6144) {
      preferredNBlocks = 6;
    }
    preferredNBlocks = MinHost(preferredNBlocks, CeilDivHost(N, baseN));
    preferredNBlocks = MinHost(preferredNBlocks, aicCoreNum);
    // 优先选择可整除 AIC 数量的 N 分块，避免例如 20 核设备上的 3x6
    // 仅使用 18 核。对 24 核设备则仍可保留 4x6 的划分。
    while (preferredNBlocks > 1 &&
           aicCoreNum % preferredNBlocks != 0) {
      --preferredNBlocks;
    }
    nBlocks = MaxHost(1, preferredNBlocks);
    mBlocks = MinHost(CeilDivHost(M, 128), MaxHost(1, aicCoreNum / nBlocks));
    nBlocks = MinHost(CeilDivHost(N, baseN), MaxHost(1, aicCoreNum / mBlocks));
  }

  uint32_t singleM = MinHost(M, AlignUpHost(CeilDivHost(M, mBlocks), 16));
  // x2 为 FRACTAL_NZ。各逻辑核的 N 起始偏移必须保持 32 对齐；16 对齐
  // 会令首块看似正确，但后续分块从错误的 NZ 位置读取权重。
  uint32_t singleN = MinHost(N, AlignUpHost(CeilDivHost(N, nBlocks), 32));
  mBlocks = CeilDivHost(M, singleM);
  nBlocks = CeilDivHost(N, singleN);
  uint32_t usedCoreNum = mBlocks * nBlocks;

  matmul_tiling::MultiCoreMatmulTiling tilingApi(*ascendcPlatform);
  tilingApi.SetDim(usedCoreNum);
  tilingApi.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                     matmul_tiling::DataType::DT_INT8);
  tilingApi.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::NZ,
                     matmul_tiling::DataType::DT_INT8);
  tilingApi.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                     matmul_tiling::DataType::DT_INT32);
  tilingApi.SetOrgShape(M, N, K, K);
  tilingApi.SetSingleShape(singleM, singleN, K);
  tilingApi.SetFixSplit(baseM, baseN, baseK);
  tilingApi.SetBufferSpace(-1, -1, -1);
  tilingApi.EnableBias(false);
  int64_t ret = tilingApi.GetTiling(tilingData.cubeTilingData);
  TORCH_CHECK(ret != -1, "QmmCustom GetTiling failed for M=", M,
              ", N=", N, ", K=", K);

  tilingData.isPertoken = isPertoken;
  tilingData.M = M;
  tilingData.N = N;
  tilingData.K = K;
  tilingData.singleM = tilingData.cubeTilingData.singleCoreM;
  tilingData.singleN = tilingData.cubeTilingData.singleCoreN;
  tilingData.mBlockNum = CeilDivHost(M, tilingData.singleM);
  tilingData.nBlockNum = CeilDivHost(N, tilingData.singleN);
  tilingData.cubeTilingData.usedCoreNum =
      tilingData.mBlockNum * tilingData.nBlockNum;

  uint64_t wsBytes = isPertoken ? (uint64_t)M * (uint64_t)N * sizeof(int32_t)
                                : 32;
  wsBytes = AlignUpHost((uint32_t)wsBytes, 512);
  tilingData.workspaceSize = (uint32_t)wsBytes;

  {
    std::lock_guard<std::mutex> lock(s_cacheMutex);
    s_tilingCache[{isPertoken, M, N, K}] = tilingData;
  }
  return tilingData;
}

__aicore__ inline uint32_t MinDev(uint32_t a, uint32_t b) {
  return a < b ? a : b;
}

__aicore__ inline void CalcTile(const QmmCustomTilingData *tiling,
                                uint32_t logicBlockIdx, uint32_t &mOffset,
                                uint32_t &nOffset, uint32_t &curM,
                                uint32_t &curN) {
  uint32_t mBlockIdx = logicBlockIdx % tiling->mBlockNum;
  uint32_t nBlockIdx = logicBlockIdx / tiling->mBlockNum;
  mOffset = mBlockIdx * tiling->singleM;
  nOffset = nBlockIdx * tiling->singleN;
  curM = MinDev(tiling->singleM, tiling->M - mOffset);
  curN = MinDev(tiling->singleN, tiling->N - nOffset);
}

using QmmAType = MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
using QmmBType = MatmulType<TPosition::GM, CubeFormat::NZ, int8_t>;
using QmmCType = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using QmmBiasType = MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;

class QmmCubeBasicKernel {
public:
  __aicore__ inline QmmCubeBasicKernel() {}

  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                              GM_ADDR y, GM_ADDR workSpace,
                              const QmmCustomTilingData *__restrict tilingData,
                              TPipe *tPipe);

  __aicore__ inline void Process();

private:
  GlobalTensor<int8_t> x1Gm_;
  GlobalTensor<int8_t> x2Gm_;
  GlobalTensor<int32_t> yGm_;
  const QmmCustomTilingData *tilingData_;
  TPipe *pipe_;
};

__aicore__ inline void QmmCubeBasicKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y, GM_ADDR workSpace,
    const QmmCustomTilingData *__restrict tilingData, TPipe *tPipe) {
  x1Gm_.SetGlobalBuffer((__gm__ int8_t *)x1, tilingData->M * tilingData->K);
  x2Gm_.SetGlobalBuffer((__gm__ int8_t *)x2, tilingData->K * tilingData->N);
  yGm_.SetGlobalBuffer((__gm__ int32_t *)y, tilingData->M * tilingData->N);
  tilingData_ = tilingData;
  pipe_ = tPipe;
}

__aicore__ inline void QmmCubeBasicKernel::Process() {
  if ASCEND_IS_AIV {
    return;
  }
  uint32_t blockIdx = GetBlockIdx();
  if (blockIdx >= tilingData_->cubeTilingData.usedCoreNum) {
    return;
  }

  uint32_t mOffset = 0;
  uint32_t nOffset = 0;
  uint32_t curM = 0;
  uint32_t curN = 0;
  CalcTile(tilingData_, blockIdx, mOffset, nOffset, curM, curN);

  uint64_t aOffset = (uint64_t)mOffset * tilingData_->K;
  uint64_t bOffset = (uint64_t)nOffset * tilingData_->K;
  uint64_t cOffset = (uint64_t)mOffset * tilingData_->N + nOffset;

  Matmul<QmmAType, QmmBType, QmmCType, QmmBiasType> mm;
  REGIST_MATMUL_OBJ(pipe_, GetSysWorkSpacePtr(), mm,
                    &tilingData_->cubeTilingData);
  mm.SetTail(curM, curN, tilingData_->K);
  mm.SetTensorA(x1Gm_[aOffset]);
  mm.SetTensorB(x2Gm_[bOffset]);
  mm.IterateAll(yGm_[cOffset]);
  mm.End();
}

class QmmPertokenKernel {
public:
  __aicore__ inline QmmPertokenKernel() {}

  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                              GM_ADDR pertokenScale, GM_ADDR y,
                              GM_ADDR workSpace,
                              const QmmCustomTilingData *__restrict tilingData,
                              TPipe *tPipe);

  __aicore__ inline void Process();

private:
  static constexpr uint32_t VEC_LEN = 2048;
  GlobalTensor<int8_t> x1Gm_;
  GlobalTensor<int8_t> x2Gm_;
  GlobalTensor<float> scaleGm_;
  GlobalTensor<float> pertokenScaleGm_;
  GlobalTensor<int32_t> workspaceGm_;
  GlobalTensor<bfloat16_t> yGm_;
  const QmmCustomTilingData *tilingData_;
  TPipe *pipe_;
  TQue<QuePosition::VECIN, 1> intQueue_;
  TQue<QuePosition::VECIN, 1> scaleQueue_;
  TQue<QuePosition::VECOUT, 1> outQueue_;
  TBuf<TPosition::VECCALC> fp32Buf_;
};

__aicore__ inline void QmmPertokenKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
    GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData,
    TPipe *tPipe) {
  x1Gm_.SetGlobalBuffer((__gm__ int8_t *)x1, tilingData->M * tilingData->K);
  x2Gm_.SetGlobalBuffer((__gm__ int8_t *)x2, tilingData->K * tilingData->N);
  scaleGm_.SetGlobalBuffer((__gm__ float *)scale, tilingData->N);
  pertokenScaleGm_.SetGlobalBuffer((__gm__ float *)pertokenScale,
                                   tilingData->M);
  workspaceGm_.SetGlobalBuffer((__gm__ int32_t *)workSpace,
                               tilingData->M * tilingData->N);
  yGm_.SetGlobalBuffer((__gm__ bfloat16_t *)y, tilingData->M * tilingData->N);
  tilingData_ = tilingData;
  pipe_ = tPipe;

  if ASCEND_IS_AIV {
    pipe_->InitBuffer(intQueue_, 2, VEC_LEN * sizeof(int32_t));
    pipe_->InitBuffer(scaleQueue_, 1, VEC_LEN * sizeof(float));
    pipe_->InitBuffer(outQueue_, 2, VEC_LEN * sizeof(bfloat16_t));
    pipe_->InitBuffer(fp32Buf_, VEC_LEN * sizeof(float));
  }
}

__aicore__ inline void QmmPertokenKernel::Process() {
  if ASCEND_IS_AIC {
    uint32_t blockIdx = GetBlockIdx();
    if (blockIdx >= tilingData_->cubeTilingData.usedCoreNum) {
      return;
    }

    uint32_t mOffset = 0;
    uint32_t nOffset = 0;
    uint32_t curM = 0;
    uint32_t curN = 0;
    CalcTile(tilingData_, blockIdx, mOffset, nOffset, curM, curN);

    uint64_t aOffset = (uint64_t)mOffset * tilingData_->K;
    uint64_t bOffset = (uint64_t)nOffset * tilingData_->K;
    uint64_t cOffset = (uint64_t)mOffset * tilingData_->N + nOffset;

    Matmul<QmmAType, QmmBType, QmmCType, QmmBiasType> mm;
    REGIST_MATMUL_OBJ(pipe_, GetSysWorkSpacePtr(), mm,
                      &tilingData_->cubeTilingData);
    mm.SetTail(curM, curN, tilingData_->K);
    mm.SetTensorA(x1Gm_[aOffset]);
    mm.SetTensorB(x2Gm_[bOffset]);
    mm.IterateAll(workspaceGm_[cOffset]);
    mm.End();

    CrossCoreSetFlag<0x2, PIPE_FIX>(0x8);
    CrossCoreSetFlag<0x2, PIPE_FIX>(0x9);
    return;
  }

  if ASCEND_IS_AIV {
    uint32_t aivBlockIdx = GetBlockIdx();
    uint32_t logicBlockIdx = aivBlockIdx >> 1;
    uint32_t subBlockIdx = aivBlockIdx & 1;
    if (logicBlockIdx >= tilingData_->cubeTilingData.usedCoreNum) {
      return;
    }

    CrossCoreWaitFlag<0x2>(0x8 + subBlockIdx);

    uint32_t mOffset = 0;
    uint32_t nOffset = 0;
    uint32_t curM = 0;
    uint32_t curN = 0;
    CalcTile(tilingData_, logicBlockIdx, mOffset, nOffset, curM, curN);

    uint32_t rowBegin = (curM * subBlockIdx + 1) >> 1;
    uint32_t rowEnd = (curM * (subBlockIdx + 1) + 1) >> 1;
    rowEnd = MinDev(rowEnd, curM);
    // M=1 时第二个 AIV 没有需要处理的行，避免继续搬运 scale。
    if (rowBegin >= rowEnd) {
      return;
    }

    for (uint32_t col = 0; col < curN; col += VEC_LEN) {
      uint32_t len = MinDev(VEC_LEN, curN - col);
      LocalTensor<float> scaleLocal = scaleQueue_.AllocTensor<float>();
      DataCopy(scaleLocal, scaleGm_[nOffset + col], len);
      scaleQueue_.EnQue(scaleLocal);
      scaleLocal = scaleQueue_.DeQue<float>();

      for (uint32_t row = rowBegin; row < rowEnd; ++row) {
        uint32_t globalRow = mOffset + row;
        float tokenScale = pertokenScaleGm_.GetValue(globalRow);
        uint64_t rowOffset = (uint64_t)globalRow * tilingData_->N + nOffset;

        LocalTensor<int32_t> intLocal = intQueue_.AllocTensor<int32_t>();
        LocalTensor<float> fpLocal = fp32Buf_.Get<float>();
        LocalTensor<bfloat16_t> outLocal =
            outQueue_.AllocTensor<bfloat16_t>();

        DataCopy(intLocal, workspaceGm_[rowOffset + col], len);
        intQueue_.EnQue(intLocal);
        intLocal = intQueue_.DeQue<int32_t>();
        Cast(fpLocal, intLocal, RoundMode::CAST_NONE, len);
        Mul(fpLocal, fpLocal, scaleLocal, len);
        Muls(fpLocal, fpLocal, tokenScale, len);
        Cast(outLocal, fpLocal, RoundMode::CAST_RINT, len);
        outQueue_.EnQue(outLocal);

        outLocal = outQueue_.DeQue<bfloat16_t>();
        DataCopy(yGm_[rowOffset + col], outLocal, len);

        intQueue_.FreeTensor(intLocal);
        outQueue_.FreeTensor(outLocal);
      }
      scaleQueue_.FreeTensor(scaleLocal);
    }
  }
}

__global__ __mix__(1, 2) __aicore__
    void qmm_custom_kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                           GM_ADDR pertoken_scale, GM_ADDR y, GM_ADDR workspace,
                           QmmCustomTilingData tilingData) {
  if (workspace == nullptr) {
    return;
  }
  TPipe pipe;

  if (tilingData.isPertoken == 0) {
    QmmCubeBasicKernel kernel;
    kernel.Init(x1, x2, scale, y, workspace, &tilingData, &pipe);
    kernel.Process();
    pipe.Destroy();
  } else {
    QmmPertokenKernel kernel;
    kernel.Init(x1, x2, scale, pertoken_scale, y, workspace, &tilingData,
                &pipe);
    kernel.Process();
    pipe.Destroy();
  }
}

#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor {
  uint32_t type;
  uint32_t format;
  uint32_t dataType;
  uint32_t shapeDim;
  uint32_t shape[8];
};

struct aclprofTensorInfo {
  uint64_t opNameId;
  uint64_t opTypeId;
  uint32_t resv;
  uint32_t tensorNum;
  uint32_t kernelType;
  uint32_t blockNums;
  void *stream;
  aclprofTensor *tensors;
};

struct aclprofEventAttributes {
  uint16_t version;
  uint16_t size;
  uint32_t messageType;
  union message {
    aclprofTensorInfo *tensorInfo;
  } message;
};
#endif

#define INPUT(x)                                                               \
  aclprofTensor {                                                              \
    (uint32_t)0,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(x.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(x.scalar_type())),   \
        static_cast<uint32_t>(x.sizes().size()), {                             \
      static_cast<uint32_t>(x.sizes().size() > 0 ? x.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(x.sizes().size() > 1 ? x.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 2 ? x.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 3 ? x.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define OUTPUT(z)                                                              \
  aclprofTensor {                                                              \
    (uint32_t)1,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(z.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(z.scalar_type())),   \
        static_cast<uint32_t>(z.sizes().size()), {                             \
      static_cast<uint32_t>(z.sizes().size() > 0 ? z.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(z.sizes().size() > 1 ? z.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 2 ? z.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 3 ? z.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

namespace ascendc_ops {

aclDataType GetAclDataType(at::ScalarType scalarType) {
  switch (scalarType) {
  case at::ScalarType::Float:
    return ACL_FLOAT;
  case at::ScalarType::Int:
    return ACL_INT32;
  case at::ScalarType::BFloat16:
    return ACL_BF16;
  case at::ScalarType::Byte:
    return ACL_UINT8;
  case at::ScalarType::Char:
    return ACL_INT8;
  default:
    TORCH_CHECK(false,
                "Unsupported tensor dtype for profiling report: ", scalarType);
  }
}

aclFormat GetFormat(int64_t dimNum) {
  aclFormat format = ACL_FORMAT_ND;
  if (dimNum == 4) {
    format = ACL_FORMAT_FRACTAL_NZ;
  }
  return format;
}

at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2,
                      const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale) {
  TORCH_CHECK(x1.dim() == 2, "x1 must be [M, K]");
  TORCH_CHECK(x2.dim() >= 2, "x2 must represent [K, N]");
  TORCH_CHECK(scale.dim() == 1, "scale must be [N]");

  auto aclStream = c10_npu::getCurrentNPUStream().stream(true);

  auto M = static_cast<uint32_t>(x1.size(0));
  auto K = static_cast<uint32_t>(x1.size(1));
  auto N = static_cast<uint32_t>(scale.size(0));
  TORCH_CHECK(x2.numel() == static_cast<int64_t>(K) * static_cast<int64_t>(N),
              "x2 storage size must be K*N for FRACTAL_NZ weight");

  uint32_t isPertoken =
      pertoken_scale.has_value() && pertoken_scale.value().defined() ? 1 : 0;
  at::ScalarType output_dtype =
      isPertoken ? at::ScalarType::BFloat16 : at::ScalarType::Int;
  at::Tensor y = at::empty({M, N}, x1.options().dtype(output_dtype));

  QmmCustomTilingData tilingData = CalcQmmTiling(isPertoken, M, N, K);
  uint32_t numBlocks = tilingData.cubeTilingData.usedCoreNum;

  at::Tensor workspaceTensor =
      at::empty({static_cast<int64_t>(tilingData.workspaceSize)},
                x1.options().dtype(at::ScalarType::Byte));

  aclprofTensorInfo tensorInfo;
  uint64_t opNameId = aclprofStr2Id("qmm_custom");
  uint64_t opTypeId = aclprofStr2Id("QmmCustom");
  uint8_t *pertokenPtr =
      isPertoken ? (uint8_t *)(pertoken_scale.value().mutable_data_ptr())
                 : nullptr;
  std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale)};
  if (isPertoken) {
    tensors.push_back(INPUT(pertoken_scale.value()));
  }
  tensors.push_back(OUTPUT(y));
  tensorInfo = {opNameId, opTypeId,  0,         (uint32_t)tensors.size(),
                0,        numBlocks, aclStream, tensors.data()};

  aclprofEventAttributes attrs{};
  attrs.version = 1;
  attrs.size = sizeof(aclprofEventAttributes);
  attrs.messageType = 0;
  attrs.message.tensorInfo = &tensorInfo;

  aclprofRangePushEx(&attrs);
  qmm_custom_kernel<<<numBlocks, 0, aclStream>>>(
      (uint8_t *)(x1.mutable_data_ptr()), (uint8_t *)(x2.mutable_data_ptr()),
      (uint8_t *)(scale.mutable_data_ptr()), pertokenPtr,
      (uint8_t *)(y.mutable_data_ptr()), workspaceTensor.data_ptr<uint8_t>(),
      tilingData);
  aclprofRangePop();
  return y;
}
} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m) {
  m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? "
        "pertoken_scale=None) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m) {
  m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}

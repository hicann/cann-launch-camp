using namespace AscendC;
using namespace matmul;

namespace {

constexpr uint32_t QMM_VECTOR_TILE_N = 2048;

__aicore__ inline uint32_t QmmCeilDiv(uint32_t value, uint32_t divisor) {
  return (value + divisor - 1) / divisor;
}

__aicore__ inline uint32_t QmmMin(uint32_t lhs, uint32_t rhs) {
  return lhs < rhs ? lhs : rhs;
}

} // namespace

#pragma pack(push, 8)
struct alignas(8) QmmCustomTilingData {
  TCubeTiling cubeTilingData;
  uint32_t isPertoken;
  uint32_t workspaceSize;
  uint32_t userWorkspaceSize;
  uint32_t systemWorkspaceSize;
  uint32_t M;
  uint32_t N;
  uint32_t K;
  uint32_t vectorTileN;
  uint32_t vectorCoreNum;
};
#pragma pack(pop)

static QmmCustomTilingData CalcQmmTiling(uint32_t isPertoken, uint32_t M,
                                         uint32_t N, uint32_t K) {
  QmmCustomTilingData tilingData{};
  auto ascendcPlatform =
      platform_ascendc::PlatformAscendCManager::GetInstance();
  TORCH_CHECK(ascendcPlatform != nullptr,
              "QmmCustom: failed to obtain AscendC platform information");

  // 当前 CANNLab 的 MIX(1,2) 在 16 个逻辑组内稳定；同时 16 可保证
  // 课程全部 N 规格的 FRACTAL_NZ 切分起点对齐。
  const uint32_t selectedCoreNum =
      std::min<uint32_t>(ascendcPlatform->GetCoreNumAic(), 16);
  TORCH_CHECK(selectedCoreNum > 0, "QmmCustom: no AI Core is available");

  matmul_tiling::MultiCoreMatmulTiling cubeTiling(*ascendcPlatform);
  cubeTiling.SetDim(selectedCoreNum);
  cubeTiling.SetAType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT8);
  cubeTiling.SetBType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::NZ,
                      matmul_tiling::DataType::DT_INT8);
  cubeTiling.SetCType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT32);
  cubeTiling.SetShape(M, N, K);
  cubeTiling.SetOrgShape(M, N, K);
  cubeTiling.SetBias(false);
  cubeTiling.SetBufferSpace(-1, -1, -1);

  TORCH_CHECK(cubeTiling.GetTiling(tilingData.cubeTilingData) != -1,
              "QmmCustom: failed to generate Matmul tiling for M=", M,
              ", N=", N, ", K=", K);
  if (std::getenv("QMM_DEBUG_TILING") != nullptr) {
    std::cerr << "QmmCustom tiling: M=" << M << ", N=" << N << ", K=" << K
              << ", usedCoreNum=" << tilingData.cubeTilingData.usedCoreNum
              << ", selectedCoreNum=" << selectedCoreNum
              << ", singleCoreM=" << tilingData.cubeTilingData.singleCoreM
              << ", singleCoreN=" << tilingData.cubeTilingData.singleCoreN
              << ", baseM=" << tilingData.cubeTilingData.baseM
              << ", baseN=" << tilingData.cubeTilingData.baseN << std::endl;
  }

  const uint64_t userWorkspaceSize =
      isPertoken == 0
          ? 0
          : static_cast<uint64_t>(M) * N * sizeof(int32_t);
  const uint64_t systemWorkspaceSize =
      ascendcPlatform->GetLibApiWorkSpaceSize();
  // 系统 workspace 必须通过 __kfc_workspace__ 独立传给 Matmul KFC。
  // INT32 中间结果由单独的 Tensor 承载，避免算子返回后运行时无法
  // 正确追踪手工拼接 workspace 中仍在使用的用户区。
  const uint64_t workspaceSize = systemWorkspaceSize;
  TORCH_CHECK(workspaceSize <= std::numeric_limits<uint32_t>::max(),
              "QmmCustom: workspace exceeds uint32 range");

  tilingData.isPertoken = isPertoken;
  tilingData.workspaceSize = static_cast<uint32_t>(workspaceSize);
  tilingData.userWorkspaceSize = static_cast<uint32_t>(userWorkspaceSize);
  tilingData.systemWorkspaceSize =
      static_cast<uint32_t>(systemWorkspaceSize);
  tilingData.M = M;
  tilingData.N = N;
  tilingData.K = K;
  tilingData.vectorTileN = QMM_VECTOR_TILE_N;
  tilingData.vectorCoreNum = std::min<uint32_t>(
      ascendcPlatform->GetCoreNumAiv(), M);
  TORCH_CHECK(tilingData.vectorCoreNum > 0,
              "QmmCustom: no AI Vector Core is available");
  return tilingData;
}

using QmmMatmul =
    Matmul<MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>,
           MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>>;

struct QmmCoreSlice {
  uint32_t mStart;
  uint32_t nStart;
  uint32_t actualM;
  uint32_t actualN;
  uint64_t offsetA;
  uint64_t offsetB;
  uint64_t offsetC;
};

__aicore__ inline QmmCoreSlice
CalcQmmCoreSlice(uint32_t logicalCoreId, const TCubeTiling &tiling) {
  QmmCoreSlice slice{};
  const uint32_t mCoreCount = QmmCeilDiv(tiling.M, tiling.singleCoreM);
  const uint32_t mCoreIndex = logicalCoreId % mCoreCount;
  const uint32_t nCoreIndex = logicalCoreId / mCoreCount;

  slice.mStart = mCoreIndex * tiling.singleCoreM;
  slice.nStart = nCoreIndex * tiling.singleCoreN;
  slice.actualM =
      slice.mStart < tiling.M
          ? QmmMin(tiling.singleCoreM, tiling.M - slice.mStart)
          : 0;
  slice.actualN =
      slice.nStart < tiling.N
          ? QmmMin(tiling.singleCoreN, tiling.N - slice.nStart)
          : 0;
  slice.offsetA = static_cast<uint64_t>(slice.mStart) * tiling.Ka;
  // FRACTAL_NZ 的 N 方向分块在物理内存中以 K * nStart 为起点。
  slice.offsetB = static_cast<uint64_t>(slice.nStart) * tiling.Kb;
  slice.offsetC = static_cast<uint64_t>(slice.mStart) * tiling.N +
                  slice.nStart;
  return slice;
}

class QmmCubeBasicKernel {
public:
  __aicore__ inline QmmCubeBasicKernel() {}

  __aicore__ inline void
  Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y, GM_ADDR workSpace,
       const QmmCustomTilingData *__restrict tilingData, TPipe *tPipe);

  __aicore__ inline void Process();

  QmmMatmul matmulObj;
  TCubeTiling cubeTiling;

private:
  GlobalTensor<int8_t> x1Global;
  GlobalTensor<int8_t> x2Global;
  GlobalTensor<int32_t> yGlobal;
};

__aicore__ inline void QmmCubeBasicKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y, GM_ADDR workSpace,
    const QmmCustomTilingData *__restrict tilingData, TPipe *tPipe) {
  cubeTiling = tilingData->cubeTilingData;
  if ASCEND_IS_AIV {
    // MIX(1,2) 的两个 AIV 客户端共享一个 Cube，只由偶数客户端发起
    // Matmul；AIV blockIdx / 2 对应原来的逻辑 Cube 编号。
    if ((AscendC::GetBlockIdx() & 1U) != 0U) {
      return;
    }
    const QmmCoreSlice slice =
        CalcQmmCoreSlice(AscendC::GetBlockIdx() / 2U, cubeTiling);
    x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1),
                             static_cast<uint64_t>(cubeTiling.M) *
                                 cubeTiling.Ka);
    x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2),
                             static_cast<uint64_t>(cubeTiling.Kb) *
                                 cubeTiling.N);
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y),
                            static_cast<uint64_t>(cubeTiling.M) *
                                cubeTiling.N);
    x1Global = x1Global[slice.offsetA];
    x2Global = x2Global[slice.offsetB];
    yGlobal = yGlobal[slice.offsetC];
  }
}

__aicore__ inline void QmmCubeBasicKernel::Process() {
  if ASCEND_IS_AIV {
    if ((AscendC::GetBlockIdx() & 1U) != 0U) {
      return;
    }
    matmulObj.SetOrgShape(cubeTiling.M, cubeTiling.N, cubeTiling.Ka,
                          cubeTiling.Kb);
    matmulObj.SetTensorA(x1Global);
    matmulObj.SetTensorB(x2Global);
    matmulObj.IterateAll(yGlobal);
    matmulObj.End();
  }
}

#if 0
// 历史融合实现：保留作问题定位对照，不参与编译。
class QmmPertokenKernel {
public:
  __aicore__ inline QmmPertokenKernel() {}

  __aicore__ inline void
  Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale,
       GM_ADDR y, GM_ADDR workSpace,
       const QmmCustomTilingData *__restrict tilingData, TPipe *tPipe);

  __aicore__ inline void Process();

  QmmMatmul matmulObj;
  TCubeTiling cubeTiling;

private:
  __aicore__ inline void ProcessCube();
  __aicore__ inline void ProcessVector();

  GlobalTensor<int8_t> x1Global;
  GlobalTensor<int8_t> x2Global;
  GlobalTensor<int32_t> workspaceGlobal;
  GlobalTensor<float> scaleGlobal;
  GlobalTensor<float> pertokenScaleGlobal;
  GlobalTensor<bfloat16_t> yGlobal;

  TBuf<QuePosition::VECCALC> int32Buffer;
  TBuf<QuePosition::VECCALC> floatBuffer;
  TBuf<QuePosition::VECCALC> scaleBuffer;
  TBuf<QuePosition::VECCALC> combinedScaleBuffer;
  TBuf<QuePosition::VECCALC> bf16Buffer;

  QmmCoreSlice slice;
  uint32_t vectorTileN = QMM_VECTOR_TILE_N;
};

__aicore__ inline void QmmPertokenKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
    GM_ADDR workSpace,
    const QmmCustomTilingData *__restrict tilingData, TPipe *tPipe) {
  cubeTiling = tilingData->cubeTilingData;
  vectorTileN = tilingData->vectorTileN;

  uint32_t logicalCoreId = 0;
  if ASCEND_IS_AIC {
    logicalCoreId = AscendC::GetBlockIdx();
  }
  if ASCEND_IS_AIV {
    const uint32_t vectorTaskRatio = cubeTiling.M == 1 ? 1 : 2;
    logicalCoreId = AscendC::GetBlockIdx() / vectorTaskRatio;
  }
  slice = CalcQmmCoreSlice(logicalCoreId, cubeTiling);

  workspaceGlobal.SetGlobalBuffer(
      reinterpret_cast<__gm__ int32_t *>(workSpace),
      static_cast<uint64_t>(cubeTiling.M) * cubeTiling.N);
  workspaceGlobal = workspaceGlobal[slice.offsetC];

  if ASCEND_IS_AIC {
    x1Global.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1),
                             static_cast<uint64_t>(cubeTiling.M) *
                                 cubeTiling.Ka);
    x2Global.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2),
                             static_cast<uint64_t>(cubeTiling.Kb) *
                                 cubeTiling.N);
    x1Global = x1Global[slice.offsetA];
    x2Global = x2Global[slice.offsetB];
  }

  if ASCEND_IS_AIV {
    scaleGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale),
                                cubeTiling.N);
    pertokenScaleGlobal.SetGlobalBuffer(
        reinterpret_cast<__gm__ float *>(pertokenScale), cubeTiling.M);
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y),
                            static_cast<uint64_t>(cubeTiling.M) *
                                cubeTiling.N);
    scaleGlobal = scaleGlobal[slice.nStart];
    yGlobal = yGlobal[slice.offsetC];

    tPipe->InitBuffer(int32Buffer, vectorTileN * sizeof(int32_t));
    tPipe->InitBuffer(floatBuffer, vectorTileN * sizeof(float));
    tPipe->InitBuffer(scaleBuffer, vectorTileN * sizeof(float));
    tPipe->InitBuffer(combinedScaleBuffer, vectorTileN * sizeof(float));
    tPipe->InitBuffer(bf16Buffer, vectorTileN * sizeof(bfloat16_t));
  }
}

__aicore__ inline void QmmPertokenKernel::ProcessCube() {
  matmulObj.SetOrgShape(cubeTiling.M, cubeTiling.N, cubeTiling.Ka,
                        cubeTiling.Kb);
  matmulObj.SetTensorA(x1Global);
  matmulObj.SetTensorB(x2Global);
  matmulObj.IterateAll(workspaceGlobal);
  matmulObj.End();

  // PIPE_FIX 保证 INT32 结果写入 GM 后，配对 AIV 才开始读取。
  AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(QMM_CUBE_TO_VECTOR_FLAG);
}

__aicore__ inline void QmmPertokenKernel::ProcessVector() {
  AscendC::CrossCoreWaitFlag(QMM_CUBE_TO_VECTOR_FLAG);

  const uint32_t subBlockIndex = AscendC::GetSubBlockIdx() % 2;
  const uint32_t firstHalfRows = (slice.actualM + 1) / 2;
  const uint32_t localRowStart =
      subBlockIndex == 0 ? 0 : firstHalfRows;
  const uint32_t localRows =
      subBlockIndex == 0 ? firstHalfRows : slice.actualM - firstHalfRows;
  if (localRows == 0 || slice.actualN == 0) {
    return;
  }

  LocalTensor<int32_t> int32Local = int32Buffer.Get<int32_t>();
  LocalTensor<float> floatLocal = floatBuffer.Get<float>();
  LocalTensor<float> scaleLocal = scaleBuffer.Get<float>();
  LocalTensor<float> combinedScaleLocal = combinedScaleBuffer.Get<float>();
  LocalTensor<bfloat16_t> bf16Local = bf16Buffer.Get<bfloat16_t>();

  for (uint32_t colOffset = 0; colOffset < slice.actualN;
       colOffset += vectorTileN) {
    const uint32_t tileN =
        QmmMin(vectorTileN, slice.actualN - colOffset);
    AscendC::DataCopy(scaleLocal, scaleGlobal[colOffset], tileN);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

    for (uint32_t localRow = 0; localRow < localRows; ++localRow) {
      const uint32_t rowInSlice = localRowStart + localRow;
      const uint64_t rowOffset =
          static_cast<uint64_t>(rowInSlice) * cubeTiling.N + colOffset;
      AscendC::DataCopy(int32Local, workspaceGlobal[rowOffset], tileN);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID1);

      AscendC::Cast(floatLocal, int32Local,
                    AscendC::RoundMode::CAST_NONE, tileN);
      // int32Local 下一行会由 MTE2 覆盖；必须等待本行 Cast 读完。
      AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID2);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID2);
      AscendC::PipeBarrier<PIPE_V>();
      const float pertokenScale =
          pertokenScaleGlobal.GetValue(slice.mStart + rowInSlice);
      // 先合并 per-token 与 channel scale，再乘 INT32，避免两个 scale
      // 依次作用于 INT32 时改变 FP32 结合顺序。
      AscendC::Muls(combinedScaleLocal, scaleLocal, pertokenScale, tileN);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Mul(floatLocal, floatLocal, combinedScaleLocal, tileN);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast(bf16Local, floatLocal,
                    AscendC::RoundMode::CAST_RINT, tileN);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

      AscendC::DataCopy(yGlobal[rowOffset], bf16Local, tileN);
      // 下一行会复用 bf16Local，先等待当前 MTE3 搬出完成。
      AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
    }
    // 下一列分块会覆盖 scaleLocal，等待当前分块的所有向量计算结束。
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
  }
}

__aicore__ inline void QmmPertokenKernel::Process() {
  if ASCEND_IS_AIC {
    ProcessCube();
  }
  if ASCEND_IS_AIV {
    ProcessVector();
  }
}

__global__ __mix__(1, 2) __aicore__ void qmm_custom_kernel_mix_1_2(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertoken_scale, GM_ADDR y,
    GM_ADDR intermediate, __kfc_workspace__ GM_ADDR workspace,
    QmmCustomTilingData tilingData) {
  if (workspace == nullptr) {
    return;
  }
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
  TPipe pipe;
  if (tilingData.isPertoken == 0) {
    QmmCubeBasicKernel kernel;
    kernel.Init(x1, x2, scale, y, intermediate, &tilingData, &pipe);
    if ASCEND_IS_AIC {
      REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.matmulObj,
                        &kernel.cubeTiling);
    }
    kernel.Process();
  } else {
    QmmPertokenKernel kernel;
    kernel.Init(x1, x2, scale, pertoken_scale, y, intermediate, &tilingData,
                &pipe);
    if ASCEND_IS_AIC {
      REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.matmulObj,
                        &kernel.cubeTiling);
    }
    kernel.Process();
  }
  pipe.Destroy();
}

__global__ __mix__(1, 1) __aicore__ void qmm_custom_kernel_mix_1_1(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertoken_scale, GM_ADDR y,
    GM_ADDR intermediate, __kfc_workspace__ GM_ADDR workspace,
    QmmCustomTilingData tilingData) {
  if (workspace == nullptr) {
    return;
  }
  TPipe pipe;
  QmmPertokenKernel kernel;
  kernel.Init(x1, x2, scale, pertoken_scale, y, intermediate, &tilingData,
              &pipe);
  if ASCEND_IS_AIC {
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.matmulObj,
                      &kernel.cubeTiling);
  }
  kernel.Process();
  pipe.Destroy();
}
#endif

// Cube 与 Vector 分成两个同流顺序 Kernel。第二次 launch 天然等待前一次
// Matmul 写回完成，避免在 MIX Kernel 内依赖脆弱的 AIC/AIV CrossCore 标志。
class QmmDequantKernel {
public:
  __aicore__ inline QmmDequantKernel() {}

  __aicore__ inline void
  Init(GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y, GM_ADDR intermediate,
       const QmmCustomTilingData *__restrict tilingData, TPipe *tPipe);

  __aicore__ inline void Process();

private:
  GlobalTensor<int32_t> intermediateGlobal;
  GlobalTensor<float> scaleGlobal;
  GlobalTensor<float> pertokenScaleGlobal;
  GlobalTensor<bfloat16_t> yGlobal;

  TBuf<QuePosition::VECCALC> int32Buffer;
  TBuf<QuePosition::VECCALC> floatBuffer;
  TBuf<QuePosition::VECCALC> scaleBuffer;
  TBuf<QuePosition::VECCALC> combinedScaleBuffer;
  TBuf<QuePosition::VECCALC> bf16Buffer;

  uint32_t M = 0;
  uint32_t N = 0;
  uint32_t vectorTileN = QMM_VECTOR_TILE_N;
  uint32_t vectorCoreNum = 1;
};

__aicore__ inline void QmmDequantKernel::Init(
    GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y, GM_ADDR intermediate,
    const QmmCustomTilingData *__restrict tilingData, TPipe *tPipe) {
  M = tilingData->M;
  N = tilingData->N;
  vectorTileN = tilingData->vectorTileN;
  vectorCoreNum = tilingData->vectorCoreNum;

  intermediateGlobal.SetGlobalBuffer(
      reinterpret_cast<__gm__ int32_t *>(intermediate),
      static_cast<uint64_t>(M) * N);
  scaleGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), N);
  pertokenScaleGlobal.SetGlobalBuffer(
      reinterpret_cast<__gm__ float *>(pertokenScale), M);
  yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y),
                          static_cast<uint64_t>(M) * N);

  tPipe->InitBuffer(int32Buffer, vectorTileN * sizeof(int32_t));
  tPipe->InitBuffer(floatBuffer, vectorTileN * sizeof(float));
  tPipe->InitBuffer(scaleBuffer, vectorTileN * sizeof(float));
  tPipe->InitBuffer(combinedScaleBuffer, vectorTileN * sizeof(float));
  tPipe->InitBuffer(bf16Buffer, vectorTileN * sizeof(bfloat16_t));
}

__aicore__ inline void QmmDequantKernel::Process() {
  const uint32_t rowsPerCore = QmmCeilDiv(M, vectorCoreNum);
  const uint32_t rowStart = AscendC::GetBlockIdx() * rowsPerCore;
  if (rowStart >= M) {
    return;
  }
  const uint32_t rows = QmmMin(rowsPerCore, M - rowStart);

  LocalTensor<int32_t> int32Local = int32Buffer.Get<int32_t>();
  LocalTensor<float> floatLocal = floatBuffer.Get<float>();
  LocalTensor<float> scaleLocal = scaleBuffer.Get<float>();
  LocalTensor<float> combinedScaleLocal = combinedScaleBuffer.Get<float>();
  LocalTensor<bfloat16_t> bf16Local = bf16Buffer.Get<bfloat16_t>();

  for (uint32_t localRow = 0; localRow < rows; ++localRow) {
    const uint32_t row = rowStart + localRow;
    const float pertokenScale = pertokenScaleGlobal.GetValue(row);
    for (uint32_t colOffset = 0; colOffset < N;
         colOffset += vectorTileN) {
      const uint32_t tileN = QmmMin(vectorTileN, N - colOffset);
      const uint64_t offset =
          static_cast<uint64_t>(row) * N + colOffset;

      AscendC::DataCopy(int32Local, intermediateGlobal[offset], tileN);
      AscendC::DataCopy(scaleLocal, scaleGlobal[colOffset], tileN);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

      AscendC::Cast(floatLocal, int32Local,
                    AscendC::RoundMode::CAST_NONE, tileN);
      AscendC::PipeBarrier<PIPE_V>();
      // 与 npu_quant_matmul 一致：INT32 * (channelScale * tokenScale)。
      AscendC::Muls(combinedScaleLocal, scaleLocal, pertokenScale, tileN);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Mul(floatLocal, floatLocal, combinedScaleLocal, tileN);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast(bf16Local, floatLocal,
                    AscendC::RoundMode::CAST_RINT, tileN);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

      AscendC::DataCopy(yGlobal[offset], bf16Local, tileN);
      AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
      AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
    }
  }
}

__global__ __mix__(1, 2) __aicore__ void qmm_cube_kernel(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y,
    __kfc_workspace__ GM_ADDR workspace,
    QmmCustomTilingData tilingData) {
  if (workspace == nullptr) {
    return;
  }
  TPipe pipe;
  QmmCubeBasicKernel kernel;
  kernel.Init(x1, x2, scale, y, nullptr, &tilingData, &pipe);
  REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.matmulObj,
                    &kernel.cubeTiling);
  kernel.Process();
  pipe.Destroy();
}

__global__ __aicore__ void qmm_dequant_kernel(
    GM_ADDR scale, GM_ADDR pertoken_scale, GM_ADDR y, GM_ADDR intermediate,
    QmmCustomTilingData tilingData) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  if (intermediate == nullptr) {
    return;
  }
  TPipe pipe;
  QmmDequantKernel kernel;
  kernel.Init(scale, pertoken_scale, y, intermediate, &tilingData, &pipe);
  kernel.Process();
  pipe.Destroy();
}

#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor {
  uint32_t type;
  uint32_t format;
  uint32_t dataType;
  uint32_t shapeDim;
  uint32_t shape[8];
};

struct aclprofTensorInfo {
  uint64_t opNameId;
  uint64_t opTypeId;
  uint32_t resv;
  uint32_t tensorNum;
  uint32_t kernelType;
  uint32_t blockNums;
  void *stream;
  aclprofTensor *tensors;
};

struct aclprofEventAttributes {
  uint16_t version;
  uint16_t size;
  uint32_t messageType;
  union message {
    aclprofTensorInfo *tensorInfo;
  } message;
};
#endif

namespace ascendc_ops {

aclDataType GetAclDataType(at::ScalarType scalarType) {
  switch (scalarType) {
  case at::ScalarType::Float:
    return ACL_FLOAT;
  case at::ScalarType::Int:
    return ACL_INT32;
  case at::ScalarType::BFloat16:
    return ACL_BF16;
  case at::ScalarType::Byte:
    return ACL_UINT8;
  case at::ScalarType::Char:
    return ACL_INT8;
  default:
    TORCH_CHECK(false,
                "Unsupported tensor dtype for profiling report: ", scalarType);
  }
}

aclFormat GetFormat(int64_t dimNum) {
  return dimNum == 4 ? ACL_FORMAT_FRACTAL_NZ : ACL_FORMAT_ND;
}

#define INPUT(x)                                                               \
  aclprofTensor {                                                              \
    static_cast<uint32_t>(0),                                                  \
        static_cast<uint32_t>(GetFormat(static_cast<int64_t>(x.dim()))),       \
        static_cast<uint32_t>(GetAclDataType(x.scalar_type())),                \
        static_cast<uint32_t>(x.dim()),                                        \
        {static_cast<uint32_t>(x.dim() > 0 ? x.size(0) : 0),                   \
         static_cast<uint32_t>(x.dim() > 1 ? x.size(1) : 0),                   \
         static_cast<uint32_t>(x.dim() > 2 ? x.size(2) : 0),                   \
         static_cast<uint32_t>(x.dim() > 3 ? x.size(3) : 0)}                   \
  }

#define OUTPUT(x)                                                              \
  aclprofTensor {                                                              \
    static_cast<uint32_t>(1),                                                  \
        static_cast<uint32_t>(GetFormat(static_cast<int64_t>(x.dim()))),       \
        static_cast<uint32_t>(GetAclDataType(x.scalar_type())),                \
        static_cast<uint32_t>(x.dim()),                                        \
        {static_cast<uint32_t>(x.dim() > 0 ? x.size(0) : 0),                   \
         static_cast<uint32_t>(x.dim() > 1 ? x.size(1) : 0),                   \
         static_cast<uint32_t>(x.dim() > 2 ? x.size(2) : 0),                   \
         static_cast<uint32_t>(x.dim() > 3 ? x.size(3) : 0)}                   \
  }

at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2,
                      const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale) {
  TORCH_CHECK(x1.dim() == 2 && x2.dim() == 2,
              "QmmCustom: x1 and x2 must be logical 2-D tensors");
  TORCH_CHECK(x1.scalar_type() == at::ScalarType::Char &&
                  x2.scalar_type() == at::ScalarType::Char,
              "QmmCustom: x1 and x2 must be INT8");
  TORCH_CHECK(scale.dim() == 1 &&
                  scale.scalar_type() == at::ScalarType::Float,
              "QmmCustom: scale must be a FLOAT32 vector");
  TORCH_CHECK(x1.size(1) == x2.size(0),
              "QmmCustom: K dimensions do not match");
  TORCH_CHECK(scale.size(0) == x2.size(1),
              "QmmCustom: scale length must equal N");

  const bool hasPertoken = pertoken_scale.has_value() &&
                           pertoken_scale.value().defined();
  if (hasPertoken) {
    TORCH_CHECK(pertoken_scale.value().dim() == 1 &&
                    pertoken_scale.value().scalar_type() ==
                        at::ScalarType::Float,
                "QmmCustom: pertoken_scale must be a FLOAT32 vector");
    TORCH_CHECK(pertoken_scale.value().size(0) == x1.size(0),
                "QmmCustom: pertoken_scale length must equal M");
  }

  TORCH_CHECK(x1.size(0) <= std::numeric_limits<uint32_t>::max() &&
                  x1.size(1) <= std::numeric_limits<uint32_t>::max() &&
                  x2.size(1) <= std::numeric_limits<uint32_t>::max(),
              "QmmCustom: tensor shape exceeds uint32 range");

  const uint32_t M = static_cast<uint32_t>(x1.size(0));
  const uint32_t K = static_cast<uint32_t>(x1.size(1));
  const uint32_t N = static_cast<uint32_t>(x2.size(1));
  const uint32_t isPertoken = hasPertoken ? 1 : 0;
  const at::ScalarType outputDtype =
      hasPertoken ? at::ScalarType::BFloat16 : at::ScalarType::Int;
  at::Tensor y = at::empty({M, N}, x1.options().dtype(outputDtype));

  QmmCustomTilingData tilingData = CalcQmmTiling(isPertoken, M, N, K);
  const uint32_t numBlocks = tilingData.cubeTilingData.usedCoreNum;
  at::Tensor workspaceTensor =
      at::empty({static_cast<int64_t>(tilingData.workspaceSize)},
                x1.options().dtype(at::ScalarType::Byte));
  const int64_t intermediateElements =
      hasPertoken ? static_cast<int64_t>(M) * static_cast<int64_t>(N) : 1;
  at::Tensor intermediateTensor =
      at::empty({intermediateElements},
                x1.options().dtype(at::ScalarType::Int));

  auto aclStream = c10_npu::getCurrentNPUStream().stream(true);
  uint8_t *pertokenPtr =
      hasPertoken
          ? reinterpret_cast<uint8_t *>(
                pertoken_scale.value().mutable_data_ptr())
          : nullptr;

  std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale)};
  if (hasPertoken) {
    tensors.push_back(INPUT(pertoken_scale.value()));
  }
  tensors.push_back(OUTPUT(y));
  aclprofTensorInfo tensorInfo = {
      aclprofStr2Id("qmm_custom"), aclprofStr2Id("QmmCustom"), 0,
      static_cast<uint32_t>(tensors.size()), 0, numBlocks, aclStream,
      tensors.data()};
  aclprofEventAttributes attrs = {
      1, static_cast<uint16_t>(sizeof(aclprofEventAttributes::message)), 0,
      &tensorInfo};

  aclprofRangePushEx(&attrs);
  uint8_t *x1Ptr = reinterpret_cast<uint8_t *>(x1.mutable_data_ptr());
  uint8_t *x2Ptr = reinterpret_cast<uint8_t *>(x2.mutable_data_ptr());
  uint8_t *scalePtr = reinterpret_cast<uint8_t *>(scale.mutable_data_ptr());
  uint8_t *yPtr = reinterpret_cast<uint8_t *>(y.mutable_data_ptr());
  uint8_t *intermediatePtr = reinterpret_cast<uint8_t *>(
      intermediateTensor.data_ptr<int32_t>());
  uint8_t *workspacePtr = workspaceTensor.data_ptr<uint8_t>();
  uint8_t *matmulOutPtr = hasPertoken ? intermediatePtr : yPtr;
  qmm_cube_kernel<<<numBlocks, 0, aclStream>>>(
      x1Ptr, x2Ptr, scalePtr, matmulOutPtr, workspacePtr, tilingData);
  if (hasPertoken) {
    qmm_dequant_kernel<<<tilingData.vectorCoreNum, 0, aclStream>>>(
        scalePtr, pertokenPtr, yPtr, intermediatePtr, tilingData);
  }
  // 两个 Kernel 在同一流中顺序执行；返回前同步也保证临时 INT32 Tensor
  // 在 Vector Kernel 完成前不会被分配器复用。
  const aclError syncRet = aclrtSynchronizeStream(aclStream);
  TORCH_CHECK(syncRet == ACL_SUCCESS,
              "QmmCustom: aclrtSynchronizeStream failed, error=", syncRet);
  aclprofRangePop();
  return y;
}

} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m) {
  m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? "
        "pertoken_scale=None) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m) {
  m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}

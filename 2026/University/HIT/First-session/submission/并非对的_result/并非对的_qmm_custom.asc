#include "acl/acl_base.h"
#include "acl/acl_prof.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <torch/extension.h>
#include <algorithm>

using namespace AscendC;

// === QmmCustom 自定义量化 Matmul 算子 ===
// 实现 A8W8 (Activation INT8 + Weight INT8) 量化矩阵乘法的 Tiling + Kernel
// Path 1 (isPertoken=0): Cube-only, INT8@INT8 -> INT32, 无反量化
// Path 2 (isPertoken=1): Cube+Vector, INT8@INT8 -> INT32 -> dequant -> BF16

// A decode token has M=1.  Split its independent output-channel tiles across
// AICs; splitting M would leave the kernel with a single block.

// === 分块常量 ===
// QMM_BASE_M=16: M方向基本分块 (对齐硬件 Cube 单元)
// QMM_BASE_N=256: N方向基本分块 (对齐 Cube 单元)
constexpr int32_t QMM_BASE_M = 16;
constexpr int32_t QMM_BASE_N = 256;
constexpr int32_t QMM_NZ_N0 = 32;
constexpr int32_t QMM_NZ_K0 = 16;

// 向上取整除法 (用于计算分块数量)
__aicore__ inline int32_t QmmCeilDiv(int32_t value, int32_t factor)
{
    return (value + factor - 1) / factor;
}

// 对齐到 alignment 的整数倍 (用于计算 NZ 格式偏移量)
__aicore__ inline int32_t QmmAlign(int32_t value, int32_t alignment)
{
    return QmmCeilDiv(value, alignment) * alignment;
}

// 根据 M 选择 baseM: M<16 -> 16 (最小分块), M>=16 -> 64 (提升 prefill 效率)
static inline int32_t SelectBaseM(uint32_t M)
{
    return M < QMM_BASE_M ? QMM_BASE_M : 64;
}

#pragma pack(push, 8)
// TilingData 结构体: 存储多核分块参数 (8字节对齐确保 Host/Device 传递兼容)
struct alignas(8) QmmCustomTilingData {
    TCubeTiling cubeTilingData;
    uint32_t isPertoken;
    uint32_t workspaceSize;
    uint32_t M;
    uint32_t N;
    uint32_t K;
    uint32_t useNBlockSplit;
    uint32_t nTileCount;
    uint32_t usedCoreNum;
};

// QmmCustomTilingData 成员:
//   cubeTilingData: 标准 Tiling 结构 (含 baseM/baseN/baseK/usedCoreNum)
//   isPertoken:     反量化标志 (0=INT32输出, 1=BF16输出)
//   workspaceSize:   INT32 中间结果的 GM workspace 大小
//   M/N/K:          矩阵维度
//   useNBlockSplit:  N 多核分块标志 (decode M=1)
//   nTileCount:      N 分块总数
//   usedCoreNum:     AI Core 数量
#pragma pack(pop)


// CalcQmmTiling: 根据 M/N/K 和 isPertoken 计算多核分块参数
// 返回填充完毕的 QmmCustomTilingData
static QmmCustomTilingData CalcQmmTiling(uint32_t isPertoken, uint32_t M,
                                         uint32_t N, uint32_t K)
{
    QmmCustomTilingData tilingData {};
    auto ascendcPlatform = platform_ascendc::PlatformAscendCManager::GetInstance();

    // The full-matrix Iterate API handles prefill safely.  Decode is the hot
    // path and has a contiguous M=1 output, so it can be split by N tiles.
// Step 1: 判断分块策略 (decode M=1 沿N多核, prefill M>1 全矩阵单核)
    const bool useNBlockSplit = M == 1;
    const uint32_t nTileCount = (N + QMM_BASE_N - 1) / QMM_BASE_N;
    const uint32_t coreCount = useNBlockSplit
        ? std::min<uint32_t>(ascendcPlatform->GetCoreNumAic(), nTileCount)
        : 1;

// Step 2: MatmulApiTiling 自动计算 Cube 分块参数 (baseM/baseN/baseK)
    matmul_tiling::MatmulApiTiling cubeTiling(*ascendcPlatform);
    cubeTiling.SetOrgShape(M, N, K);
    cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_INT8);
    cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::NZ,
                        matmul_tiling::DataType::DT_INT8);
    cubeTiling.SetCType(isPertoken != 0 ? matmul_tiling::TPosition::VECIN
                                         : matmul_tiling::TPosition::GM,
                        matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_INT32);
    cubeTiling.SetBias(false);
// Step 3: 设置分块策略 (decode:FIRSTN, prefill+量化:FIRSTM)

    if (useNBlockSplit) {
        // A single Matmul API invocation computes one tile.  The outer
        // grid-stride loop below distributes these tiles over all AICs.
        cubeTiling.SetFixSplit(QMM_BASE_M, QMM_BASE_N, -1);
        cubeTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTN);
    } else if (isPertoken != 0) {
        cubeTiling.SetFixSplit(SelectBaseM(M), QMM_BASE_N, -1);
        cubeTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM);
    }

// Step 4: 获取 Tiling 结果并填充自定义字段
    cubeTiling.GetTiling(tilingData.cubeTilingData);
    if (useNBlockSplit) {
        // MatmulApiTiling does not expose SetSingleShape on CANN 9.  These
        // fields are the same per-tile contract consumed by SetSingleShape
        // in the kernel below.
        tilingData.cubeTilingData.singleCoreM = QMM_BASE_M;
        tilingData.cubeTilingData.singleCoreN = QMM_BASE_N;
    }
    tilingData.cubeTilingData.usedCoreNum = coreCount;
    tilingData.isPertoken = isPertoken;
    tilingData.workspaceSize = static_cast<uint32_t>(ascendcPlatform->GetLibApiWorkSpaceSize());
    tilingData.M = M;
    tilingData.N = N;
    tilingData.K = K;
    tilingData.useNBlockSplit = useNBlockSplit;
    tilingData.nTileCount = nTileCount;
    tilingData.usedCoreNum = coreCount;
    return tilingData;
}


// Matmul 类型别名: 定义 A/B/C 的存储位置 (GM/VECIN), 格式 (ND/NZ), 数据类型
// QMM_CTYPE_VECIN: C 输出到 VECIN, 供 Vector 单元读取进行反量化
using QMM_ATYPE = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
using QMM_BTYPE = matmul::MatmulType<TPosition::GM, CubeFormat::NZ, int8_t>;
using QMM_CTYPE = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;
using QMM_CTYPE_VECIN = matmul::MatmulType<TPosition::VECIN, CubeFormat::ND, int32_t>;


// === Path 1: QmmCubeBasicKernel ===
// 纯 Cube 路径: A8W8 输入, INT32 输出, 不涉及 Vector
// 支持: (1) prefill 全矩阵 IterateAll (2) decode N 分块多核并行
class QmmCubeBasicKernel {
public:
// 绑定 GM 地址, 读取 Tiling 参数, 设置矩阵维度和分块策略
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR y,
                                QmmCustomTilingData *tilingData, TPipe *tPipe)
    {
        tiling = &tilingData->cubeTilingData;
        pipe = tPipe;
        M = static_cast<int32_t>(tilingData->M);
        N = static_cast<int32_t>(tilingData->N);
        K = static_cast<int32_t>(tilingData->K);
        useNBlockSplit = tilingData->useNBlockSplit != 0;
        nTileCount = static_cast<int32_t>(tilingData->nTileCount);
        usedCoreNum = static_cast<int32_t>(tilingData->usedCoreNum);
        coreIdx = static_cast<int32_t>(GetBlockIdx());

        x1GM.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1), M * K);
        x2GM.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2), K * N);
        yGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y), M * N);
    }

// matmul 主流程: useNBlockSplit? decode分块 : prefill全矩阵 IterateAll
    __aicore__ inline void Process()
    {
        REGIST_MATMUL_OBJ(pipe, GetSysWorkSpacePtr(), mm, tiling);
        mm.SetOrgShape(M, N, K);
        if (useNBlockSplit) {
            ProcessNBlockSplit();
        } else {
            mm.SetTensorA(x1GM, false);
            mm.SetTensorB(x2GM, false);
            mm.IterateAll(yGM);
        }
        mm.End();
    }

    matmul::Matmul<QMM_ATYPE, QMM_BTYPE, QMM_CTYPE> mm;

private:
// 计算 FRACTAL_NZ 格式 [N1,K1,K0,N0] 中第 col0 列的字节偏移
    __aicore__ inline uint64_t GetWeightNzOffset(int32_t col0) const
    {
        // B is [N1, K1, K0, N0] for the non-transposed FRACTAL_NZ weight.
        return static_cast<uint64_t>(QmmAlign(col0, QMM_NZ_N0)) *
               static_cast<uint64_t>(QmmAlign(K, QMM_NZ_K0));
    }

// N 维度多核分块: grid-stride 循环, SetSingleShape 指定子矩阵大小, 结果写入对应列偏移
    __aicore__ inline void ProcessNBlockSplit()
    {
        for (int32_t tileN = coreIdx; tileN < nTileCount; tileN += usedCoreNum) {
            const int32_t col0 = tileN * QMM_BASE_N;
            const int32_t validCols = (col0 + QMM_BASE_N < N) ? QMM_BASE_N : (N - col0);
            mm.SetSingleShape(1, validCols, K);
            mm.SetTensorA(x1GM, false);
            mm.SetTensorB(x2GM[GetWeightNzOffset(col0)], false);
            mm.IterateAll(yGM[col0]);
        }
    }

// -- 成员变量 --
// tiling:        Cube Tiling 参数指针
// pipe:          管线对象
// M/N/K:         矩阵维度
// useNBlockSplit: 沿 N 多核分块标志
// nTileCount:     N 分块数
// usedCoreNum:    AI Core 数量
// coreIdx:        当前核编号
// x1GM/x2GM/yGM:  GM 缓冲区引用
    TCubeTiling *tiling;
    TPipe *pipe;
    int32_t M;
    int32_t N;
    int32_t K;
    int32_t useNBlockSplit;
    int32_t nTileCount;
    int32_t usedCoreNum;
    int32_t coreIdx;
    GlobalTensor<int8_t> x1GM;
    GlobalTensor<int8_t> x2GM;
    GlobalTensor<int32_t> yGM;
};


// === Path 2: QmmPertokenKernel ===
// Cube INT8@INT8 -> INT32 (Cube) -> Cast F32 -> x scale -> Cast BF16 (Vector)
// C 输出到 VECIN 位置, 供 Vector 单元后续读取并反量化
class QmmPertokenKernel {
public:
// 绑定所有 GM 地址, 读取 Tiling 参数, 在 AIV 核上初始化 UB Queue/Buffer
    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale,
                                GM_ADDR y, QmmCustomTilingData *tilingData, TPipe *tPipe)
    {
        tiling = &tilingData->cubeTilingData;
        pipe = tPipe;
        M = static_cast<int32_t>(tilingData->M);
        N = static_cast<int32_t>(tilingData->N);
        K = static_cast<int32_t>(tilingData->K);
        baseM = static_cast<int32_t>(tiling->baseM);
        baseN = static_cast<int32_t>(tiling->baseN);
        singleCoreM = static_cast<int32_t>(tiling->singleCoreM);
        singleCoreN = static_cast<int32_t>(tiling->singleCoreN);
        useNBlockSplit = tilingData->useNBlockSplit != 0;
        nTileCount = static_cast<int32_t>(tilingData->nTileCount);
        usedCoreNum = static_cast<int32_t>(tilingData->usedCoreNum);
        coreIdx = static_cast<int32_t>(GetBlockIdx());

        x1GM.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1), M * K);
        x2GM.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2), K * N);
        yGM.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y), M * N);
        scaleGM.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), N);
        pertokenGM.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(pertokenScale), M);

        if ASCEND_IS_AIV {
            pipe->InitBuffer(intQueue, 1, baseM * baseN * sizeof(int32_t));
            pipe->InitBuffer(floatBuf, baseM * baseN * sizeof(float));
            pipe->InitBuffer(outQueue, 1, baseM * baseN * sizeof(bfloat16_t));
            pipe->InitBuffer(scaleNQueue, 1, baseN * sizeof(float));
            pipe->InitBuffer(scaleMQueue, 1, baseM * sizeof(float));
        }
    }

    __aicore__ inline void Process()
    {
        REGIST_MATMUL_OBJ(pipe, GetSysWorkSpacePtr(), mm, tiling);
        mm.SetOrgShape(M, N, K);
        if (useNBlockSplit) {
            ProcessNBlockSplit();
        } else {
            ProcessSingleBlock();
        }
        mm.End();
    }

    matmul::Matmul<QMM_ATYPE, QMM_BTYPE, QMM_CTYPE_VECIN> mm;

private:
    __aicore__ inline uint64_t GetWeightNzOffset(int32_t col0) const
    {
        return static_cast<uint64_t>(QmmAlign(col0, QMM_NZ_N0)) *
               static_cast<uint64_t>(QmmAlign(K, QMM_NZ_K0));
    }


// 反量化流程 (5 步):
//   1) GM->UB 加载 perChannelScale
//   2) Cast INT32 -> FLOAT32
//   3) 逐行乘以 perTokenScale (标量广播) 和 perChannelScale (逐元素)
//   4) Cast FLOAT32 -> BF16
//   5) UB->GM 搬出 BF16 结果
    __aicore__ inline void DequantAndStore(LocalTensor<int32_t> intLocal,
                                            int32_t row0, int32_t col0,
                                            int32_t validRows, int32_t validCols,
                                            LocalTensor<float> scaleMLocal)
    {
        LocalTensor<float> scaleNLocal = scaleNQueue.AllocTensor<float>();
        DataCopyPad(scaleNLocal, scaleGM[col0],
                    DataCopyExtParams(1, validCols * sizeof(float), 0, 0, 0),
                    DataCopyPadExtParams<float>());
        scaleNQueue.EnQue(scaleNLocal);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        scaleNLocal = scaleNQueue.DeQue<float>();

        LocalTensor<float> floatLocal = floatBuf.Get<float>();
        const int32_t vectorRows = validRows;
        Cast(floatLocal, intLocal, RoundMode::CAST_NONE, vectorRows * baseN);
        intQueue.FreeTensor(intLocal);
        PipeBarrier<PIPE_V>();
        for (int32_t i = 0; i < validRows; ++i) {
            Muls(floatLocal[i * baseN], floatLocal[i * baseN],
                 scaleMLocal.GetValue(i), validCols);
            Mul(floatLocal[i * baseN], floatLocal[i * baseN], scaleNLocal, validCols);
        }
        PipeBarrier<PIPE_V>();

        LocalTensor<bfloat16_t> outLocal = outQueue.AllocTensor<bfloat16_t>();
        Cast(outLocal, floatLocal, RoundMode::CAST_RINT, vectorRows * baseN);
        outQueue.EnQue(outLocal);
        scaleNQueue.FreeTensor(scaleNLocal);

        SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
        outLocal = outQueue.DeQue<bfloat16_t>();
        DataCopyPad(yGM[row0 * N + col0], outLocal,
                    DataCopyExtParams(static_cast<uint16_t>(validRows),
                                      validCols * sizeof(bfloat16_t), 0,
                                      (N - validCols) * sizeof(bfloat16_t), 0));
        outQueue.FreeTensor(outLocal);
        SetFlag<HardEvent::MTE3_V>(EVENT_ID2);
        WaitFlag<HardEvent::MTE3_V>(EVENT_ID2);
    }

// 从 GM 加载 perTokenScale 到 UB Queue, 等待 MTE2->V 搬数完成后返回
    __aicore__ inline LocalTensor<float> LoadPertokenScale(int32_t row0, int32_t validRows)
    {
        LocalTensor<float> scaleMLocal = scaleMQueue.AllocTensor<float>();
        DataCopyPad(scaleMLocal, pertokenGM[row0],
                    DataCopyExtParams(1, validRows * sizeof(float), 0, 0, 0),
                    DataCopyPadExtParams<float>());
        scaleMQueue.EnQue(scaleMLocal);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        return scaleMQueue.DeQue<float>();
    }

// decode 路径 (M=1): N 维度多核分块, perTokenScale 只加载一次, 各核 grid-stride 循环处理分配到的 N 分块
    __aicore__ inline void ProcessNBlockSplit()
    {
        // M=1 in this path.  Keep its scale in UB while this core processes
        // one or more independent N tiles.
        LocalTensor<float> scaleMLocal = LoadPertokenScale(0, 1);
        for (int32_t tileN = coreIdx; tileN < nTileCount; tileN += usedCoreNum) {
            const int32_t col0 = tileN * QMM_BASE_N;
            const int32_t validCols = (col0 + QMM_BASE_N < N) ? QMM_BASE_N : (N - col0);
            mm.SetSingleShape(1, validCols, K);
            mm.SetTensorA(x1GM, false);
            mm.SetTensorB(x2GM[GetWeightNzOffset(col0)], false);
            while (mm.Iterate<true>()) {
                LocalTensor<int32_t> intLocal = intQueue.AllocTensor<int32_t>();
                mm.GetTensorC<true>(intLocal, false, true);
                DequantAndStore(intLocal, 0, col0, 1, validCols, scaleMLocal);
            }
        }
        scaleMQueue.FreeTensor(scaleMLocal);
    }

// prefill 路径: 单核遍历 MxN 矩阵, 每次迭代处理 baseM x baseN 分块, 逐行加载 perTokenScale
    __aicore__ inline void ProcessSingleBlock()
    {
        mm.SetTensorA(x1GM, false);
        mm.SetTensorB(x2GM, false);
        const int32_t roundM = QmmCeilDiv(singleCoreM, baseM);
        int32_t computeRound = 0;
        while (mm.Iterate<true>()) {
            const int32_t tm = computeRound % roundM;
            const int32_t tn = computeRound / roundM;
            const int32_t row0 = tm * baseM;
            const int32_t col0 = tn * baseN;
            const int32_t validRows = (row0 + baseM < M) ? baseM : (M - row0);
            const int32_t validCols = (col0 + baseN < N) ? baseN : (N - col0);
            LocalTensor<float> scaleMLocal = LoadPertokenScale(row0, validRows);
            LocalTensor<int32_t> intLocal = intQueue.AllocTensor<int32_t>();
            mm.GetTensorC<true>(intLocal, false, true);
            DequantAndStore(intLocal, row0, col0, validRows, validCols, scaleMLocal);
            scaleMQueue.FreeTensor(scaleMLocal);
            ++computeRound;
        }
    }

// -- UB 资源 (仅 Vector 核) --
// intQueue:   Cube输出INT32 -> Vector读取
// floatBuf:   FLOAT32 工作缓冲区
// outQueue:   BF16输出 -> MTE3搬出到GM
// scaleNQueue: perChannelScale 输入
// scaleMQueue: perTokenScale 输入
    TCubeTiling *tiling;
    TPipe *pipe;
    int32_t M;
    int32_t N;
    int32_t K;
    int32_t baseM;
    int32_t baseN;
    int32_t singleCoreM;
    int32_t singleCoreN;
    int32_t useNBlockSplit;
    int32_t nTileCount;
    int32_t usedCoreNum;
    int32_t coreIdx;
    TQue<TPosition::VECOUT, 1> intQueue;
    TBuf<TPosition::VECCALC> floatBuf;
    TQue<TPosition::VECOUT, 1> outQueue;
    TQue<TPosition::VECIN, 1> scaleNQueue;
    TQue<TPosition::VECIN, 1> scaleMQueue;
    GlobalTensor<int8_t> x1GM;
    GlobalTensor<int8_t> x2GM;
    GlobalTensor<bfloat16_t> yGM;
    GlobalTensor<float> scaleGM;
    GlobalTensor<float> pertokenGM;
};


// === Kernel 入口 ===
// __mix__(1,2): 每 Block 1 个 Cube 核 + 2 个 Vector 核
// isPertoken==0 -> QmmCubeBasicKernel (纯Cube, INT32输出)
// isPertoken==1 -> QmmPertokenKernel (Cube+Vector反量化, BF16输出)
__global__ __mix__(1, 2) __aicore__
void qmm_custom_kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                       GM_ADDR pertoken_scale, GM_ADDR y,
                       GM_ADDR __kfc_workspace__ workspace,
                       QmmCustomTilingData tilingData)
{
    TPipe pipe;
    if (tilingData.isPertoken == 0) {
        QmmCubeBasicKernel kernel;
        kernel.Init(x1, x2, y, &tilingData, &pipe);
        kernel.Process();
    } else {
        QmmPertokenKernel kernel;
        kernel.Init(x1, x2, scale, pertoken_scale, y, &tilingData, &pipe);
        kernel.Process();
    }
    pipe.Destroy();
}

#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor { uint32_t type; uint32_t format; uint32_t dataType; uint32_t shapeDim; uint32_t shape[8]; };
struct aclprofTensorInfo { uint64_t opNameId; uint64_t opTypeId; uint32_t resv; uint32_t tensorNum; uint32_t kernelType; uint32_t blockNums; void *stream; aclprofTensor *tensors; };
struct aclprofEventAttributes { uint16_t version; uint16_t size; uint32_t messageType; union { aclprofTensorInfo *tensorInfo; } message; };
#endif

#define INPUT(x) aclprofTensor { (uint32_t)0, static_cast<uint32_t>(ascendc_ops::GetFormat(static_cast<int64_t>(x.sizes().size()))), static_cast<uint32_t>(ascendc_ops::GetAclDataType(x.scalar_type())), static_cast<uint32_t>(x.sizes().size()), { static_cast<uint32_t>(x.sizes().size()>0?x.sizes().data()[0]:0), static_cast<uint32_t>(x.sizes().size()>1?x.sizes().data()[1]:0), static_cast<uint32_t>(x.sizes().size()>2?x.sizes().data()[2]:0), static_cast<uint32_t>(x.sizes().size()>3?x.sizes().data()[3]:0) } }
#define OUTPUT(z) aclprofTensor { (uint32_t)1, static_cast<uint32_t>(ascendc_ops::GetFormat(static_cast<int64_t>(z.sizes().size()))), static_cast<uint32_t>(ascendc_ops::GetAclDataType(z.scalar_type())), static_cast<uint32_t>(z.sizes().size()), { static_cast<uint32_t>(z.sizes().size()>0?z.sizes().data()[0]:0), static_cast<uint32_t>(z.sizes().size()>1?z.sizes().data()[1]:0), static_cast<uint32_t>(z.sizes().size()>2?z.sizes().data()[2]:0), static_cast<uint32_t>(z.sizes().size()>3?z.sizes().data()[3]:0) } }

namespace ascendc_ops {
aclDataType GetAclDataType(at::ScalarType t)
// 将 Torch ScalarType 映射为 ACL 数据类型枚举 (用于 Profiling)
{
    switch (t) {
    case at::ScalarType::Float: return ACL_FLOAT;
    case at::ScalarType::Int: return ACL_INT32;
    case at::ScalarType::BFloat16: return ACL_BF16;
    case at::ScalarType::Byte: return ACL_UINT8;
    case at::ScalarType::Char: return ACL_INT8;
    default: TORCH_CHECK(false, "unsupported dtype: ", t);
    }
}

aclFormat GetFormat(int64_t dimNum)
{
    return dimNum == 4 ? ACL_FORMAT_FRACTAL_NZ : ACL_FORMAT_ND;
}


// qmm_custom: 量化 matmul 算子的 Torch Host 侧接口
// 参数: x1=INT8[M,K], x2=INT8 FRACTAL_NZ[K,N], scale=F32[N], pertoken_scale=可选F32[M]
// 返回: 有 pertoken_scale -> BF16[M,N], 无 -> INT32[M,N]
at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2, const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale)
{
    auto aclStream = c10_npu::getCurrentNPUStream().stream(true);
    const auto M = x1.size(0);
    const auto K = x1.size(1);
    const auto N = x2.size(1);
    const uint32_t isPertoken = pertoken_scale.has_value() && pertoken_scale.value().defined() ? 1 : 0;
    const at::ScalarType outDt = isPertoken ? at::ScalarType::BFloat16 : at::ScalarType::Int;
    at::Tensor y = at::empty({M, N}, x1.options().dtype(outDt));
    QmmCustomTilingData td = CalcQmmTiling(isPertoken, M, N, K);
    at::Tensor ws = at::empty({static_cast<int64_t>(td.workspaceSize)},
                              x1.options().dtype(at::ScalarType::Byte));

    aclprofTensorInfo tensorInfo;
    const uint64_t opNameId = aclprofStr2Id("qmm_custom");
    const uint64_t opTypeId = aclprofStr2Id("QmmCustom");
    uint8_t *ptPtr = isPertoken ? reinterpret_cast<uint8_t *>(pertoken_scale.value().mutable_data_ptr()) : nullptr;
    std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale)};
    if (isPertoken) tensors.push_back(INPUT(pertoken_scale.value()));
    tensors.push_back(OUTPUT(y));
    tensorInfo = {opNameId, opTypeId, 0, static_cast<uint32_t>(tensors.size()),
                  0, td.usedCoreNum, aclStream, tensors.data()};
    aclprofEventAttributes attrs = {1, sizeof(aclprofEventAttributes::message), 0, &tensorInfo};

    aclprofRangePushEx(&attrs);
    qmm_custom_kernel<<<td.usedCoreNum, 0, aclStream>>>(
        reinterpret_cast<uint8_t *>(x1.mutable_data_ptr()), reinterpret_cast<uint8_t *>(x2.mutable_data_ptr()),
        reinterpret_cast<uint8_t *>(scale.mutable_data_ptr()), ptPtr,
        reinterpret_cast<uint8_t *>(y.mutable_data_ptr()), ws.data_ptr<uint8_t>(), td);
    aclprofRangePop();
    return y;
}
} // namespace ascendc_ops

// 将 qmm_custom 注册为 Torch 自定义算子，通过 torch.ops.ascendc_ops.qmm_custom 调用
TORCH_LIBRARY(ascendc_ops, m)
{
    m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? pertoken_scale=None) -> Tensor");
}
TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m)
{
    m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}


#include "acl/acl_base.h"
#include "acl/acl_prof.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <torch/extension.h>
#include <algorithm>
#define ASCENDC_CUBE_ONLY

using namespace AscendC;

using AType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int8_t>;
using BType = matmul::MatmulType<TPosition::GM, CubeFormat::NZ, int8_t>;
using CType = matmul::MatmulType<TPosition::GM, CubeFormat::ND, int32_t>;

constexpr uint64_t kQmmSystemWorkspaceBytes = 16ULL * 1024 * 1024;

#pragma pack(push, 8)
struct alignas(8) QmmCustomTilingData {
  TCubeTiling cubeTilingData;
  uint32_t isPertoken;
  int32_t M;
  int32_t N;
  int32_t K;
  int32_t singleCoreM;
  int32_t singleCoreN;
  uint64_t workspaceSize;
};
#pragma pack(pop)

__aicore__ inline int32_t CeilDivQmm(int32_t value, int32_t factor) {
  return (value + factor - 1) / factor;
}

// ================== Cube 基础 Kernel ==================
class QmmCubeBasicKernel {
public:
  __aicore__ inline QmmCubeBasicKernel() {}

  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                              GM_ADDR y, GM_ADDR workSpace,
                              const QmmCustomTilingData *__restrict tiling,
                              TPipe *pipe);

  __aicore__ inline void Process();

  matmul::Matmul<AType, BType, CType> mm;

private:
  int32_t m_m_ = 0;
  int32_t m_n_ = 0;
  int32_t m_k_ = 0;
  int32_t m_single_core_m_ = 0;
  int32_t m_single_core_n_ = 0;
  int32_t m_iterate_order_ = 0;

  GlobalTensor<int8_t> m_x1_global_;
  GlobalTensor<int8_t> m_x2_global_;
  GlobalTensor<int32_t> m_y_global_;
};

__aicore__ inline void QmmCubeBasicKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y, GM_ADDR workSpace,
    const QmmCustomTilingData *__restrict tiling, TPipe *pipe) {
  m_m_ = tiling->M;
  m_n_ = tiling->N;
  m_k_ = tiling->K;
  m_single_core_m_ = tiling->singleCoreM;
  m_single_core_n_ = tiling->singleCoreN;
  m_iterate_order_ = tiling->cubeTilingData.iterateOrder;

  m_x1_global_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1),
                               m_m_ * m_k_);
  m_x2_global_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2),
                               m_k_ * m_n_);
  m_y_global_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y),
                              m_m_ * m_n_);

  mm.SetOrgShape(m_m_, m_n_, m_k_);
}

__aicore__ inline void QmmCubeBasicKernel::Process() {
  const int32_t core_id = static_cast<int32_t>(GetBlockIdx());
  const int32_t m_blocks = CeilDivQmm(m_m_, m_single_core_m_);
  const int32_t n_blocks = CeilDivQmm(m_n_, m_single_core_n_);

  int32_t m_block_idx = 0;
  int32_t n_block_idx = 0;
  if (m_iterate_order_ == 0) {
    m_block_idx = core_id % m_blocks;
    n_block_idx = core_id / m_blocks;
  } else {
    m_block_idx = core_id / n_blocks;
    n_block_idx = core_id % n_blocks;
  }

  const int32_t row_start = m_block_idx * m_single_core_m_;
  const int32_t col_start = n_block_idx * m_single_core_n_;

  if (row_start >= m_m_ || col_start >= m_n_) {
    mm.End();
    return;
  }

  const int32_t cur_m = (row_start + m_single_core_m_ <= m_m_)
                            ? m_single_core_m_
                            : m_m_ - row_start;
  const int32_t cur_n = (col_start + m_single_core_n_ <= m_n_)
                            ? m_single_core_n_
                            : m_n_ - col_start;

  mm.SetSingleShape(cur_m, cur_n, m_k_);
  mm.SetTensorA(m_x1_global_[row_start * m_k_], false);
  mm.SetTensorB(m_x2_global_[col_start * m_k_], false);
  mm.IterateAll(m_y_global_[row_start * m_n_ + col_start]);
  mm.End();
}

// ================== Per‑Token Kernel（混合 AIC+AIV） ==================
class QmmPertokenKernel {
public:
  __aicore__ inline QmmPertokenKernel() {}

  __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                              GM_ADDR pertoken_scale, GM_ADDR y,
                              GM_ADDR workSpace,
                              const QmmCustomTilingData *__restrict tiling,
                              TPipe *pipe);

  __aicore__ inline void Process();

  matmul::Matmul<AType, BType, CType> mm;

private:
  static constexpr int32_t kTileN = 6144;
  static constexpr int32_t kTokenTileM = 416;

  TPipe *m_pipe_ = nullptr;
  int32_t m_m_ = 0;
  int32_t m_n_ = 0;
  int32_t m_k_ = 0;
  int32_t m_single_core_m_ = 0;
  int32_t m_single_core_n_ = 0;
  int32_t m_iterate_order_ = 0;

  TQue<TPosition::VECIN, 3> m_int_queue_;
  TBuf<TPosition::VECCALC> m_float_buf_;
  TBuf<TPosition::VECCALC> m_scale_buf_;
  TBuf<TPosition::VECCALC> m_scaled_scale_buf_;
  TBuf<TPosition::VECCALC> m_token_buf_;
  TQue<TPosition::VECOUT, 3> m_out_queue_;

  GlobalTensor<int8_t> m_x1_global_;
  GlobalTensor<int8_t> m_x2_global_;
  GlobalTensor<float> m_scale_global_;
  GlobalTensor<float> m_pertoken_global_;
  GlobalTensor<int32_t> m_workspace_global_;
  GlobalTensor<bfloat16_t> m_y_global_;
};

__aicore__ inline void QmmPertokenKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertoken_scale, GM_ADDR y,
    GM_ADDR workSpace, const QmmCustomTilingData *__restrict tiling,
    TPipe *pipe) {
  m_pipe_ = pipe;
  m_m_ = tiling->M;
  m_n_ = tiling->N;
  m_k_ = tiling->K;
  m_single_core_m_ = tiling->singleCoreM;
  m_single_core_n_ = tiling->singleCoreN;
  m_iterate_order_ = tiling->cubeTilingData.iterateOrder;

  m_x1_global_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1),
                               m_m_ * m_k_);
  m_x2_global_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2),
                               m_k_ * m_n_);
  m_scale_global_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale),
                                  m_n_);
  m_pertoken_global_.SetGlobalBuffer(
      reinterpret_cast<__gm__ float *>(pertoken_scale), m_m_);
  m_workspace_global_.SetGlobalBuffer(
      reinterpret_cast<__gm__ int32_t *>(workSpace), m_m_ * m_n_);
  m_y_global_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y),
                              m_m_ * m_n_);

  if ASCEND_IS_AIC {
    mm.SetOrgShape(m_m_, m_n_, m_k_);
  }

  if ASCEND_IS_AIV {
    m_pipe_->InitBuffer(m_int_queue_, 3, kTileN * sizeof(int32_t));
    m_pipe_->InitBuffer(m_float_buf_, kTileN * sizeof(float));
    m_pipe_->InitBuffer(m_scale_buf_, kTileN * sizeof(float));
    m_pipe_->InitBuffer(m_scaled_scale_buf_, kTileN * sizeof(float));
    m_pipe_->InitBuffer(m_token_buf_, kTokenTileM * sizeof(float));
    m_pipe_->InitBuffer(m_out_queue_, 3, kTileN * sizeof(bfloat16_t));
  }
}

__aicore__ inline void QmmPertokenKernel::Process() {
  if ASCEND_IS_AIC {
    const int32_t core_id = static_cast<int32_t>(GetBlockIdx());
    const int32_t m_blocks = CeilDivQmm(m_m_, m_single_core_m_);
    const int32_t n_blocks = CeilDivQmm(m_n_, m_single_core_n_);

    int32_t m_block_idx = 0;
    int32_t n_block_idx = 0;
    if (m_iterate_order_ == 0) {
      m_block_idx = core_id % m_blocks;
      n_block_idx = core_id / m_blocks;
    } else {
      m_block_idx = core_id / n_blocks;
      n_block_idx = core_id % n_blocks;
    }

    const int32_t row_start = m_block_idx * m_single_core_m_;
    const int32_t col_start = n_block_idx * m_single_core_n_;
    const int32_t cur_m = (row_start + m_single_core_m_ <= m_m_)
                              ? m_single_core_m_
                              : m_m_ - row_start;
    const int32_t cur_n = (col_start + m_single_core_n_ <= m_n_)
                              ? m_single_core_n_
                              : m_n_ - col_start;

    mm.SetSingleShape(cur_m, cur_n, m_k_);
    mm.SetTensorA(m_x1_global_[row_start * m_k_], false);
    mm.SetTensorB(m_x2_global_[col_start * m_k_], false);
    mm.IterateAll(m_workspace_global_[row_start * m_n_ + col_start]);
    mm.End();

    // 0x8 在 Matmul KFC 协议内部使用的事件范围之外，保证 AIV 不会观察到过期事件
    CrossCoreSetFlag<0x2, PIPE_FIX>(0x8);
  }

  if ASCEND_IS_AIV {
    CrossCoreWaitFlag(0x8);

    const int32_t paired_aic_id =
        static_cast<int32_t>(GetBlockIdx() / GetTaskRation());
    const int32_t aiv_sub_id = static_cast<int32_t>(GetSubBlockIdx());
    const int32_t m_blocks = CeilDivQmm(m_m_, m_single_core_m_);
    const int32_t n_blocks = CeilDivQmm(m_n_, m_single_core_n_);

    int32_t m_block_idx = 0;
    int32_t n_block_idx = 0;
    if (m_iterate_order_ == 0) {
      m_block_idx = paired_aic_id % m_blocks;
      n_block_idx = paired_aic_id / m_blocks;
    } else {
      m_block_idx = paired_aic_id / n_blocks;
      n_block_idx = paired_aic_id % n_blocks;
    }

    const int32_t core_row_start = m_block_idx * m_single_core_m_;
    const int32_t core_row_end = (core_row_start + m_single_core_m_ < m_m_)
                                     ? core_row_start + m_single_core_m_
                                     : m_m_;
    const int32_t core_col_start = n_block_idx * m_single_core_n_;
    const int32_t core_col_end = (core_col_start + m_single_core_n_ < m_n_)
                                     ? core_col_start + m_single_core_n_
                                     : m_n_;

    const int32_t rows_for_core = core_row_end - core_row_start;
    const int32_t rows_per_aiv = CeilDivQmm(
        rows_for_core, static_cast<int32_t>(GetTaskRation()));
    const int32_t row_start = core_row_start + aiv_sub_id * rows_per_aiv;
    const int32_t candidate_row_end = row_start + rows_per_aiv;
    const int32_t row_end =
        candidate_row_end < core_row_end ? candidate_row_end : core_row_end;

    LocalTensor<float> token_local = m_token_buf_.Get<float>();
    if (m_m_ > 64) {
      DataCopy(token_local, m_pertoken_global_[row_start], row_end - row_start);
    }

    for (int32_t col = core_col_start; col < core_col_end; col += kTileN) {
      const int32_t cur_tile =
          (col + kTileN <= core_col_end) ? kTileN : core_col_end - col;

      LocalTensor<float> scale_local = m_scale_buf_.Get<float>();
      DataCopy(scale_local, m_scale_global_[col], cur_tile);

      event_t event_mte2_to_v = static_cast<event_t>(
          GetTPipePtr()->FetchEventID(HardEvent::MTE2_V));
      SetFlag<HardEvent::MTE2_V>(event_mte2_to_v);
      WaitFlag<HardEvent::MTE2_V>(event_mte2_to_v);

      LocalTensor<float> scaled_scale_local = m_scaled_scale_buf_.Get<float>();

      const int32_t max_batch_rows = kTileN / cur_tile;
      const int32_t gm_input_stride_bytes =
          (m_n_ - cur_tile) * static_cast<int32_t>(sizeof(int32_t));

      if (max_batch_rows == 1 || row_end - row_start == 1 ||
          gm_input_stride_bytes > 65535) {
        for (int32_t row = row_start; row < row_end; ++row) {
          const float token_scale = m_m_ > 64
              ? token_local.GetValue(row - row_start)
              : m_pertoken_global_.GetValue(row);

          LocalTensor<int32_t> int_local = m_int_queue_.AllocTensor<int32_t>();
          DataCopy(int_local, m_workspace_global_[row * m_n_ + col], cur_tile);
          m_int_queue_.EnQue(int_local);

          int_local = m_int_queue_.DeQue<int32_t>();
          LocalTensor<float> float_local = m_float_buf_.Get<float>();
          LocalTensor<bfloat16_t> out_local =
              m_out_queue_.AllocTensor<bfloat16_t>();

          Muls(scaled_scale_local, scale_local, token_scale, cur_tile);
          Cast(float_local, int_local, RoundMode::CAST_NONE, cur_tile);
          PipeBarrier<PIPE_V>();
          Mul(float_local, float_local, scaled_scale_local, cur_tile);
          PipeBarrier<PIPE_V>();
          Cast(out_local, float_local, RoundMode::CAST_RINT, cur_tile);

          m_out_queue_.EnQue(out_local);
          m_int_queue_.FreeTensor(int_local);

          out_local = m_out_queue_.DeQue<bfloat16_t>();
          DataCopy(m_y_global_[row * m_n_ + col], out_local, cur_tile);
          m_out_queue_.FreeTensor(out_local);
        }
      } else {
        for (int32_t batch_row_start = row_start; batch_row_start < row_end;
             batch_row_start += max_batch_rows) {
          const int32_t batch_row_end = batch_row_start + max_batch_rows < row_end
              ? batch_row_start + max_batch_rows : row_end;
          const int32_t batch_rows = batch_row_end - batch_row_start;
          const int32_t batch_count = batch_rows * cur_tile;

          LocalTensor<int32_t> int_local = m_int_queue_.AllocTensor<int32_t>();
          DataCopyParams gm2ub_params{1, 0, 0, 0};
          gm2ub_params.blockCount = batch_rows;
          gm2ub_params.blockLen = cur_tile * sizeof(int32_t);
          gm2ub_params.srcStride = gm_input_stride_bytes;
          DataCopyPad(int_local,
                      m_workspace_global_[batch_row_start * m_n_ + col],
                      gm2ub_params, DataCopyPadParams{});
          m_int_queue_.EnQue(int_local);

          int_local = m_int_queue_.DeQue<int32_t>();
          LocalTensor<float> float_local = m_float_buf_.Get<float>();
          LocalTensor<bfloat16_t> out_local =
              m_out_queue_.AllocTensor<bfloat16_t>();

          for (int32_t row = batch_row_start; row < batch_row_end; ++row) {
            const float token_scale = m_m_ > 64
                ? token_local.GetValue(row - row_start)
                : m_pertoken_global_.GetValue(row);
            Muls(scaled_scale_local[(row - batch_row_start) * cur_tile],
                 scale_local, token_scale, cur_tile);
          }
          Cast(float_local, int_local, RoundMode::CAST_NONE, batch_count);
          PipeBarrier<PIPE_V>();
          Mul(float_local, float_local, scaled_scale_local, batch_count);
          PipeBarrier<PIPE_V>();
          Cast(out_local, float_local, RoundMode::CAST_RINT, batch_count);

          m_out_queue_.EnQue(out_local);
          m_int_queue_.FreeTensor(int_local);

          out_local = m_out_queue_.DeQue<bfloat16_t>();
          DataCopyExtParams ub2gm_params{1, 0, 0, 0, 0};
          ub2gm_params.blockCount = batch_rows;
          ub2gm_params.blockLen = cur_tile * sizeof(bfloat16_t);
          ub2gm_params.dstStride = (m_n_ - cur_tile) * sizeof(bfloat16_t);
          DataCopyPad(m_y_global_[batch_row_start * m_n_ + col], out_local,
                      ub2gm_params);
          m_out_queue_.FreeTensor(out_local);
        }
      }

      if (col + kTileN < core_col_end) {
        event_t event_v_to_mte2 = static_cast<event_t>(
            GetTPipePtr()->FetchEventID(HardEvent::V_MTE2));
        SetFlag<HardEvent::V_MTE2>(event_v_to_mte2);
        WaitFlag<HardEvent::V_MTE2>(event_v_to_mte2);
      }
    }
  }
}

// ================== Tiling 计算 ==================
static QmmCustomTilingData ComputeQmmTiling(uint32_t is_per_token,
                                            uint32_t M, uint32_t N,
                                            uint32_t K) {
  auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
  TORCH_CHECK(platform != nullptr,
              "QmmCustom: failed to acquire AscendC platform information");

  const auto ceil_div = [](uint32_t val, uint32_t fac) {
    return (val + fac - 1) / fac;
  };
  const auto align_up = [&](uint32_t val, uint32_t alignment) {
    return ceil_div(val, alignment) * alignment;
  };

  const uint32_t core_num = platform->GetCoreNumAic();
  uint32_t m_tiles = 1;
  uint32_t n_tiles = 1;

  if (M <= 64) {
    if (N == 6144) {
      n_tiles = std::min(core_num, M == 1 ? 16U : 12U);
    } else {
      n_tiles = std::min(core_num, ceil_div(N, 256U));
    }
  } else {
    m_tiles = std::min(5U, core_num);
    n_tiles = std::min(4U, core_num / m_tiles);
  }

  const uint32_t rows_per_core = align_up(ceil_div(M, m_tiles), 16U);
  const uint32_t cols_per_core = align_up(ceil_div(N, n_tiles), 32U);

  matmul_tiling::MultiCoreMatmulTiling tiling_api(*platform);
  tiling_api.SetDim(static_cast<int32_t>(m_tiles * n_tiles));
  tiling_api.SetSingleShape(static_cast<int32_t>(rows_per_core),
                            static_cast<int32_t>(cols_per_core),
                            static_cast<int32_t>(K));
  tiling_api.SetAlignSplit(16, 32, -1);
  tiling_api.SetOrgShape(M, N, K);
  tiling_api.SetShape(M, N, K);
  tiling_api.SetAType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT8);
  tiling_api.SetBType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::NZ,
                      matmul_tiling::DataType::DT_INT8);
  tiling_api.SetCType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT32);
  tiling_api.SetBias(false);

  QmmCustomTilingData tiling_data{};
  TORCH_CHECK(tiling_api.GetTiling(tiling_data.cubeTilingData) != -1,
              "QmmCustom: MatmulApiTiling::GetTiling failed for M=", M,
              ", N=", N, ", K=", K);

  tiling_data.isPertoken = is_per_token;
  tiling_data.M = static_cast<int32_t>(M);
  tiling_data.N = static_cast<int32_t>(N);
  tiling_data.K = static_cast<int32_t>(K);
  tiling_data.singleCoreM = tiling_data.cubeTilingData.singleCoreM;
  tiling_data.singleCoreN = tiling_data.cubeTilingData.singleCoreN;
  // 为 Matmul KFC 协议预留 16 MiB 工作空间
  tiling_data.workspaceSize = kQmmSystemWorkspaceBytes;
  return tiling_data;
}

// ================== Global 内核入口 ==================
__global__ __aicore__ void qmm_custom_kernel_cube(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertoken_scale, GM_ADDR y,
    GM_ADDR intermediate, __kfc_workspace__ GM_ADDR workspace,
    QmmCustomTilingData tiling_data) {
  if (workspace == nullptr) {
    return;
  }
  TPipe pipe;
  QmmCubeBasicKernel kernel;
  REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.mm,
                    &tiling_data.cubeTilingData);
  kernel.Init(x1, x2, scale, y, intermediate, &tiling_data, &pipe);
  kernel.Process();
  pipe.Destroy();
}

__global__ __mix__(1, 2) __aicore__ void qmm_custom_kernel_mix_1_2(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertoken_scale, GM_ADDR y,
    GM_ADDR intermediate, __kfc_workspace__ GM_ADDR workspace,
    QmmCustomTilingData tiling_data) {
  if (workspace == nullptr) {
    return;
  }
  TPipe pipe;
  QmmPertokenKernel kernel;
  if ASCEND_IS_AIC {
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.mm,
                      &tiling_data.cubeTilingData);
  }
  kernel.Init(x1, x2, scale, pertoken_scale, y, intermediate, &tiling_data,
              &pipe);
  kernel.Process();
  pipe.Destroy();
}

__global__ __mix__(1, 1) __aicore__ void qmm_custom_kernel_mix_1_1(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertoken_scale, GM_ADDR y,
    GM_ADDR intermediate, __kfc_workspace__ GM_ADDR workspace,
    QmmCustomTilingData tiling_data) {
  if (workspace == nullptr) {
    return;
  }
  TPipe pipe;
  QmmPertokenKernel kernel;
  if ASCEND_IS_AIC {
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.mm,
                      &tiling_data.cubeTilingData);
  }
  kernel.Init(x1, x2, scale, pertoken_scale, y, intermediate, &tiling_data,
              &pipe);
  kernel.Process();
  pipe.Destroy();
}

// ================== Profiling 辅助 ==================
#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor {
  uint32_t type;
  uint32_t format;
  uint32_t dataType;
  uint32_t shapeDim;
  uint32_t shape[8];
};

struct aclprofTensorInfo {
  uint64_t opNameId;
  uint64_t opTypeId;
  uint32_t resv;
  uint32_t tensorNum;
  uint32_t kernelType;
  uint32_t blockNums;
  void *stream;
  aclprofTensor *tensors;
};

struct aclprofEventAttributes {
  uint16_t version;
  uint16_t size;
  uint32_t messageType;
  union message {
    aclprofTensorInfo *tensorInfo;
  } message;
};
#endif

#define INPUT(t)                                                               \
  aclprofTensor {                                                              \
    (uint32_t)0,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(t.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(t.scalar_type())),   \
        static_cast<uint32_t>(t.sizes().size()), {                             \
      static_cast<uint32_t>(t.sizes().size() > 0 ? t.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(t.sizes().size() > 1 ? t.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(t.sizes().size() > 2 ? t.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(t.sizes().size() > 3 ? t.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define OUTPUT(z)                                                              \
  aclprofTensor {                                                              \
    (uint32_t)1,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(z.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(z.scalar_type())),   \
        static_cast<uint32_t>(z.sizes().size()), {                             \
      static_cast<uint32_t>(z.sizes().size() > 0 ? z.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(z.sizes().size() > 1 ? z.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 2 ? z.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 3 ? z.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

namespace ascendc_ops {

aclDataType GetAclDataType(at::ScalarType scalar_type) {
  switch (scalar_type) {
  case at::ScalarType::Float:
    return ACL_FLOAT;
  case at::ScalarType::Int:
    return ACL_INT32;
  case at::ScalarType::BFloat16:
    return ACL_BF16;
  case at::ScalarType::Byte:
    return ACL_UINT8;
  case at::ScalarType::Char:
    return ACL_INT8;
  default:
    TORCH_CHECK(false,
                "Unsupported tensor dtype for profiling report: ", scalar_type);
  }
}

aclFormat GetFormat(int64_t dim_num) {
  return dim_num == 4 ? ACL_FORMAT_FRACTAL_NZ : ACL_FORMAT_ND;
}

at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2,
                      const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale) {
  TORCH_CHECK(x1.dim() == 2 && x2.dim() == 2,
              "QmmCustom expects two logical rank-2 matrices");
  TORCH_CHECK(x1.scalar_type() == at::ScalarType::Char &&
                  x2.scalar_type() == at::ScalarType::Char,
              "QmmCustom expects INT8 x1 and x2");
  TORCH_CHECK(scale.scalar_type() == at::ScalarType::Float,
              "QmmCustom expects FLOAT32 per-channel scale");

  const int64_t M = x1.size(0);
  const int64_t K = x1.size(1);
  const int64_t N = x2.size(1);
  TORCH_CHECK(x2.size(0) == K, "QmmCustom K mismatch: x1 K=", K,
              ", x2 K=", x2.size(0));
  TORCH_CHECK(scale.numel() == N,
              "QmmCustom scale length must equal N (", N, ")");
  TORCH_CHECK(M > 0 && N > 0 && K > 0 &&
                  M <= static_cast<int64_t>(UINT32_MAX) &&
                  N <= static_cast<int64_t>(UINT32_MAX) &&
                  K <= static_cast<int64_t>(UINT32_MAX),
              "QmmCustom received an invalid or oversized shape");

  const bool has_per_token =
      pertoken_scale.has_value() && pertoken_scale.value().defined();
  if (has_per_token) {
    TORCH_CHECK(pertoken_scale.value().scalar_type() == at::ScalarType::Float,
                "QmmCustom expects FLOAT32 per-token scale");
    TORCH_CHECK(pertoken_scale.value().numel() == M,
                "QmmCustom per-token scale length must equal M (", M, ")");
  }

  auto acl_stream = c10_npu::getCurrentNPUStream().stream(true);
  const at::ScalarType output_dtype =
      has_per_token ? at::ScalarType::BFloat16 : at::ScalarType::Int;
  at::Tensor y = at::empty({M, N}, x1.options().dtype(output_dtype));

  QmmCustomTilingData tiling_data =
      ComputeQmmTiling(has_per_token ? 1U : 0U, static_cast<uint32_t>(M),
                       static_cast<uint32_t>(N), static_cast<uint32_t>(K));
  const uint32_t num_blocks = tiling_data.cubeTilingData.usedCoreNum;

  at::Tensor workspace_tensor =
      at::empty({static_cast<int64_t>(tiling_data.workspaceSize)},
                x1.options().dtype(at::ScalarType::Byte));
  at::Tensor intermediate_tensor =
      at::empty({has_per_token ? M * N : 1},
                x1.options().dtype(at::ScalarType::Int));

  // 构造 profiling 信息
  aclprofTensorInfo tensor_info;
  const uint64_t op_name_id = aclprofStr2Id("qmm_custom");
  const uint64_t op_type_id = aclprofStr2Id("QmmCustom");
  uint8_t *pertoken_ptr =
      has_per_token
          ? reinterpret_cast<uint8_t *>(
                pertoken_scale.value().mutable_data_ptr())
          : nullptr;

  std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale)};
  if (has_per_token) {
    tensors.push_back(INPUT(pertoken_scale.value()));
  }
  tensors.push_back(OUTPUT(y));
  tensor_info = {op_name_id,
                 op_type_id,
                 0,
                 static_cast<uint32_t>(tensors.size()),
                 0,
                 num_blocks,
                 acl_stream,
                 tensors.data()};

  aclprofEventAttributes attrs = {1, sizeof(aclprofEventAttributes::message), 0,
                                  &tensor_info};

  uint8_t *x1_ptr = reinterpret_cast<uint8_t *>(x1.mutable_data_ptr());
  uint8_t *x2_ptr = reinterpret_cast<uint8_t *>(x2.mutable_data_ptr());
  uint8_t *scale_ptr = reinterpret_cast<uint8_t *>(scale.mutable_data_ptr());
  uint8_t *y_ptr = reinterpret_cast<uint8_t *>(y.mutable_data_ptr());
  uint8_t *intermediate_ptr =
      reinterpret_cast<uint8_t *>(intermediate_tensor.data_ptr<int32_t>());
  uint8_t *workspace_ptr = workspace_tensor.data_ptr<uint8_t>();

  aclprofRangePushEx(&attrs);
  if (!has_per_token) {
    qmm_custom_kernel_cube<<<num_blocks, 0, acl_stream>>>(
        x1_ptr, x2_ptr, scale_ptr, pertoken_ptr, y_ptr, intermediate_ptr,
        workspace_ptr, tiling_data);
  } else if (M == 1) {
    qmm_custom_kernel_mix_1_1<<<num_blocks, 0, acl_stream>>>(
        x1_ptr, x2_ptr, scale_ptr, pertoken_ptr, y_ptr, intermediate_ptr,
        workspace_ptr, tiling_data);
  } else {
    qmm_custom_kernel_mix_1_2<<<num_blocks, 0, acl_stream>>>(
        x1_ptr, x2_ptr, scale_ptr, pertoken_ptr, y_ptr, intermediate_ptr,
        workspace_ptr, tiling_data);
  }
  aclprofRangePop();
  return y;
}

} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m) {
  m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? "
        "pertoken_scale=None) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m) {
  m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}

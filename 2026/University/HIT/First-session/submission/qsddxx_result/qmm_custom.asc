// 宏隔离保护：torch 头文件仅在 Host(g++) 编译时引入，避免 Device(__CCE_AICORE__) 编译失败
#ifndef __CCE_AICORE__
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <torch/extension.h>

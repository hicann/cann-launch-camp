#include "acl/acl_base.h"
#include "acl/acl_prof.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <torch/extension.h>
#include <cstdint>
#include <climits>

using namespace matmul;

using AType =
    MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>;
using BType =
    MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>;
using CTypeGM =
    MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
using CTypeVEC =
    MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, int32_t>;
using BiasType =
    MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;

using BasicMatmul =
    AscendC::Matmul<AType, BType, CTypeGM, BiasType>;
using PertokenMatmul =
    AscendC::Matmul<AType, BType, CTypeVEC, BiasType>;

__aicore__ inline uint32_t QmmCeilDiv(uint32_t value, uint32_t divisor)
{
    return (value + divisor - 1U) / divisor;
}

__aicore__ inline uint32_t QmmMin(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

#pragma pack(push, 8)
struct alignas(8) QmmCustomTilingData {
    TCubeTiling cubeTilingData;
    uint32_t isPertoken;
    uint32_t numBlocks;
    uint64_t workspaceSize;
};
#pragma pack(pop)

static uint32_t ChooseAlignedAivNum(uint32_t nTileCount,
                                    uint32_t availableAivNum)
{
    TORCH_CHECK(nTileCount > 0 && availableAivNum > 0,
                "QmmCustom: invalid N tile/core count");

    uint32_t candidate =
        nTileCount < availableAivNum ? nTileCount : availableAivNum;

    while (nTileCount % candidate != 0U) {
        --candidate;
    }

    return candidate;
}

static QmmCustomTilingData CalcQmmTiling(uint32_t isPertoken,
                                         uint32_t M,
                                         uint32_t N,
                                         uint32_t K)
{
    auto *platform =
        platform_ascendc::PlatformAscendCManager::GetInstance();

    TORCH_CHECK(platform != nullptr,
                "QmmCustom: failed to get Ascend platform");

    const uint32_t aicNum = platform->GetCoreNumAic();
    const uint32_t aivNum = platform->GetCoreNumAiv();

    TORCH_CHECK(aicNum > 0 && aivNum > 0,
                "QmmCustom: invalid core configuration");

    const uint32_t baseM =
        M <= 16U ? 16U :
        (M <= 64U ? 32U : 128U);

    const uint32_t baseN =
        (M <= 16U && N != 6144U) ? 256U : 128U;

    TORCH_CHECK(N > 0 && N % baseN == 0,
                "QmmCustom: N must contain complete baseN tiles");

    const uint32_t tilingAivNum =
        M <= 64U
            ? ChooseAlignedAivNum(N / baseN, aivNum)
            : aivNum;

    matmul_tiling::MultiCoreMatmulTiling cubeTiling(*platform);

    TORCH_CHECK(
        cubeTiling.SetDim(static_cast<int32_t>(tilingAivNum)) == 0,
        "QmmCustom: SetDim failed");

    TORCH_CHECK(
        cubeTiling.SetAType(
            matmul_tiling::TPosition::GM,
            matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_INT8) == 0,
        "QmmCustom: SetAType failed");

    TORCH_CHECK(
        cubeTiling.SetBType(
            matmul_tiling::TPosition::GM,
            matmul_tiling::CubeFormat::NZ,
            matmul_tiling::DataType::DT_INT8) == 0,
        "QmmCustom: SetBType failed");

    TORCH_CHECK(
        cubeTiling.SetCType(
            isPertoken != 0U
                ? matmul_tiling::TPosition::VECIN
                : matmul_tiling::TPosition::GM,
            matmul_tiling::CubeFormat::ND,
            matmul_tiling::DataType::DT_INT32) == 0,
        "QmmCustom: SetCType failed");

    TORCH_CHECK(
        cubeTiling.SetBias(false) == 0,
        "QmmCustom: SetBias failed");

    TORCH_CHECK(
        cubeTiling.SetShape(
            static_cast<int32_t>(M),
            static_cast<int32_t>(N),
            static_cast<int32_t>(K)) == 0,
        "QmmCustom: SetShape failed");

    TORCH_CHECK(
        cubeTiling.SetAlignSplit(
            -1,
            static_cast<int32_t>(baseN),
            -1) == 0,
        "QmmCustom: SetAlignSplit failed");

    TORCH_CHECK(
        cubeTiling.SetOrgShape(
            static_cast<int32_t>(M),
            static_cast<int32_t>(N),
            static_cast<int32_t>(K)) == 0,
        "QmmCustom: SetOrgShape failed");

    TORCH_CHECK(
        cubeTiling.SetFixSplit(
            static_cast<int32_t>(baseM),
            static_cast<int32_t>(baseN),
            -1) == 0,
        "QmmCustom: SetFixSplit failed");

    TORCH_CHECK(
        cubeTiling.SetTraverse(
            matmul_tiling::MatrixTraverse::FIRSTM) == 0,
        "QmmCustom: SetTraverse failed");

    TORCH_CHECK(
        cubeTiling.SetBufferSpace(-1, -1, -1) == 0,
        "QmmCustom: SetBufferSpace failed");

    QmmCustomTilingData tilingData{};

    TORCH_CHECK(
        cubeTiling.GetTiling(
            tilingData.cubeTilingData) != -1,
        "QmmCustom: failed to generate Matmul tiling");

    const uint32_t singleCoreM =
        static_cast<uint32_t>(
            tilingData.cubeTilingData.singleCoreM);

    const uint32_t singleCoreN =
        static_cast<uint32_t>(
            tilingData.cubeTilingData.singleCoreN);

    TORCH_CHECK(
        singleCoreM > 0 && singleCoreN > 0,
        "QmmCustom: invalid single core shape");

    TORCH_CHECK(
        singleCoreN % baseN == 0,
        "QmmCustom: singleCoreN must be baseN aligned");

    const uint64_t mCoreCount =
        (static_cast<uint64_t>(M) +
         singleCoreM - 1U) /
        singleCoreM;

    const uint64_t nCoreCount =
        (static_cast<uint64_t>(N) +
         singleCoreN - 1U) /
        singleCoreN;

    const uint64_t gridSize =
        mCoreCount * nCoreCount;

    TORCH_CHECK(
        tilingData.cubeTilingData.usedCoreNum > 0 &&
        static_cast<uint64_t>(
            tilingData.cubeTilingData.usedCoreNum) ==
            gridSize &&
        tilingData.cubeTilingData.usedCoreNum <= aivNum,
        "QmmCustom: inconsistent core grid");

    tilingData.isPertoken = isPertoken;

    tilingData.numBlocks =
        platform->CalcTschBlockDim(
            static_cast<uint32_t>(
                tilingData.cubeTilingData.usedCoreNum),
            aicNum,
            aivNum);

    TORCH_CHECK(
        tilingData.numBlocks > 0,
        "QmmCustom: invalid block dim");

    const uint64_t libWorkspaceSize =
        static_cast<uint64_t>(
            platform->GetLibApiWorkSpaceSize());

    tilingData.workspaceSize =
        libWorkspaceSize == 0U
            ? 32U
            : libWorkspaceSize;

    TORCH_CHECK(
        tilingData.workspaceSize <= INT64_MAX,
        "QmmCustom: invalid workspace size");

    return tilingData;
}

struct CoreSlice {
    uint32_t mStart;
    uint32_t nStart;
    uint32_t mSize;
    uint32_t nSize;
};

__aicore__ inline CoreSlice
GetCoreSlice(const TCubeTiling &tiling)
{
    const uint32_t blockIdx =
        AscendC::GetBlockIdx();

    const uint32_t mBlocks =
        QmmCeilDiv(
            static_cast<uint32_t>(tiling.M),
            static_cast<uint32_t>(
                tiling.singleCoreM));

    const uint32_t mCoreIdx =
        blockIdx % mBlocks;

    const uint32_t nCoreIdx =
        blockIdx / mBlocks;

    const uint32_t mStart =
        mCoreIdx *
        static_cast<uint32_t>(
            tiling.singleCoreM);

    const uint32_t nStart =
        nCoreIdx *
        static_cast<uint32_t>(
            tiling.singleCoreN);

    CoreSlice slice;

    slice.mStart = mStart;
    slice.nStart = nStart;

    slice.mSize =
        QmmMin(
            static_cast<uint32_t>(
                tiling.singleCoreM),
            static_cast<uint32_t>(
                tiling.M) - mStart);

    slice.nSize =
        QmmMin(
            static_cast<uint32_t>(
                tiling.singleCoreN),
            static_cast<uint32_t>(
                tiling.N) - nStart);

    return slice;
}

class QmmCubeBasicKernel {
public:
    __aicore__ inline
    QmmCubeBasicKernel()
    {
    }

    __aicore__ inline void Init(
        GM_ADDR x1,
        GM_ADDR x2,
        GM_ADDR y,
        const QmmCustomTilingData *__restrict tilingData)
    {
        tiling_ =
            tilingData->cubeTilingData;

        slice_ =
            GetCoreSlice(tiling_);

        x1Gm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int8_t *>(x1),
            static_cast<uint64_t>(
                tiling_.M) *
                tiling_.Ka);

        x2Gm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int8_t *>(x2),
            static_cast<uint64_t>(
                tiling_.Kb) *
                tiling_.N);

        yGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t *>(y),
            static_cast<uint64_t>(
                tiling_.M) *
                tiling_.N);

        x1Gm_ =
            x1Gm_[
                static_cast<uint64_t>(
                    slice_.mStart) *
                tiling_.Ka];

        x2Gm_ =
            x2Gm_[
                static_cast<uint64_t>(
                    slice_.nStart) *
                tiling_.Kb];

        yGm_ =
            yGm_[
                static_cast<uint64_t>(
                    slice_.mStart) *
                    tiling_.N +
                slice_.nStart];
    }

    __aicore__ inline void Process()
    {
        for (uint32_t nOffset = 0;
             nOffset < slice_.nSize;
             nOffset += tiling_.baseN) {

            const uint32_t tileN =
                QmmMin(
                    tiling_.baseN,
                    slice_.nSize - nOffset);

            matmulObj_.SetTensorA(
                x1Gm_);

            matmulObj_.SetTensorB(
                x2Gm_[
                    static_cast<uint64_t>(
                        nOffset) *
                    tiling_.Kb]);

            matmulObj_.SetSingleShape(
                slice_.mSize,
                tileN,
                tiling_.Ka);

            matmulObj_.IterateAll(
                yGm_[nOffset]);
        }

        matmulObj_.End();
    }

    BasicMatmul matmulObj_;
    TCubeTiling tiling_;

private:
    CoreSlice slice_{};

    AscendC::GlobalTensor<int8_t>
        x1Gm_;

    AscendC::GlobalTensor<int8_t>
        x2Gm_;

    AscendC::GlobalTensor<int32_t>
        yGm_;
};

class QmmPertokenKernel {
public:
    __aicore__ inline
    QmmPertokenKernel()
    {
    }

    __aicore__ inline void Init(
        GM_ADDR x1,
        GM_ADDR x2,
        GM_ADDR scale,
        GM_ADDR pertokenScale,
        GM_ADDR y,
        const QmmCustomTilingData *__restrict tilingData,
        AscendC::TPipe *pipe)
    {
        pipe_ = pipe;

        mte2ToScalarEvent_ =
            pipe_->AllocEventID<
                AscendC::HardEvent::MTE2_S>();

        tiling_ =
            tilingData->cubeTilingData;

        slice_ =
            GetCoreSlice(tiling_);

        x1Gm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int8_t *>(x1),
            static_cast<uint64_t>(
                tiling_.M) *
                tiling_.Ka);

        x2Gm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int8_t *>(x2),
            static_cast<uint64_t>(
                tiling_.Kb) *
                tiling_.N);

        scaleGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ float *>(
                scale),
            static_cast<uint64_t>(
                tiling_.N));

        pertokenGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ float *>(
                pertokenScale),
            static_cast<uint64_t>(
                tiling_.M));

        yGm_.SetGlobalBuffer(
            reinterpret_cast<
                __gm__ bfloat16_t *>(y),
            static_cast<uint64_t>(
                tiling_.M) *
                tiling_.N);

        x1Gm_ =
            x1Gm_[
                static_cast<uint64_t>(
                    slice_.mStart) *
                tiling_.Ka];

        x2Gm_ =
            x2Gm_[
                static_cast<uint64_t>(
                    slice_.nStart) *
                tiling_.Kb];

        const uint32_t tileElements =
            tiling_.baseM *
            tiling_.baseN;

        pipe_->InitBuffer(
            matmulQueue_,
            1,
            tileElements *
                sizeof(int32_t));

        pipe_->InitBuffer(
            fp32Buf_,
            tileElements *
                sizeof(float));

        pipe_->InitBuffer(
            outputQueue_,
            1,
            tileElements *
                sizeof(bfloat16_t));

        pipe_->InitBuffer(
            scaleQueue_,
            1,
            tiling_.baseN *
                sizeof(float));

        pipe_->InitBuffer(
            pertokenQueue_,
            1,
            tiling_.baseM *
                sizeof(float));
    }

    __aicore__ inline void Process()
    {
        for (uint32_t nOffset = 0;
             nOffset < slice_.nSize;
             nOffset += tiling_.baseN) {

            const uint32_t tileN =
                QmmMin(
                    tiling_.baseN,
                    slice_.nSize -
                        nOffset);

            matmulObj_.SetTensorA(
                x1Gm_);

            matmulObj_.SetTensorB(
                x2Gm_[
                    static_cast<uint64_t>(
                        nOffset) *
                    tiling_.Kb]);

            matmulObj_.SetSingleShape(
                slice_.mSize,
                tileN,
                tiling_.Ka);

            uint32_t round = 0;

            while (
                matmulObj_
                    .template Iterate<true>()) {

                auto matmulLocal =
                    matmulQueue_
                        .AllocTensor<int32_t>();

                matmulObj_
                    .template GetTensorC<true>(
                        matmulLocal,
                        false,
                        true);

                DequantizeAndCopyOut(
                    matmulLocal,
                    round,
                    nOffset,
                    tileN);

                matmulQueue_
                    .FreeTensor(
                        matmulLocal);

                ++round;
            }
        }

        matmulObj_.End();

        pipe_->ReleaseEventID<
            AscendC::HardEvent::MTE2_S>(
            mte2ToScalarEvent_);
    }

    PertokenMatmul matmulObj_;
    TCubeTiling tiling_;

private:
    __aicore__ inline void
    DequantizeAndCopyOut(
        const AscendC::LocalTensor<int32_t>
            &matmulLocal,
        uint32_t round,
        uint32_t nChunkStart,
        uint32_t nChunkSize)
    {
        const uint32_t roundM =
            QmmCeilDiv(
                slice_.mSize,
                tiling_.baseM);

        const uint32_t tileMIndex =
            round % roundM;

        const uint32_t tileNIndex =
            round / roundM;

        const uint32_t tileMStart =
            tileMIndex *
            tiling_.baseM;

        const uint32_t tileNInChunk =
            tileNIndex *
            tiling_.baseN;

        if (tileMStart >=
                slice_.mSize ||
            tileNInChunk >=
                nChunkSize) {
            return;
        }

        const uint32_t tileNStart =
            nChunkStart +
            tileNInChunk;

        const uint32_t tileM =
            QmmMin(
                tiling_.baseM,
                slice_.mSize -
                    tileMStart);

        const uint32_t tileN =
            QmmMin(
                tiling_.baseN,
                nChunkSize -
                    tileNInChunk);

        const uint32_t validElements =
            tileM * tileN;

        auto scaleLocal =
            scaleQueue_
                .AllocTensor<float>();

        AscendC::DataCopyExtParams
            scaleCopy{
                1,
                static_cast<uint32_t>(
                    tileN *
                    sizeof(float)),
                0,
                0,
                0};

        AscendC::DataCopyPadExtParams<float>
            scalePad{
                false,
                0,
                0,
                0};

        AscendC::DataCopyPad(
            scaleLocal,
            scaleGm_[
                slice_.nStart +
                tileNStart],
            scaleCopy,
            scalePad);

        scaleQueue_.EnQue(
            scaleLocal);

        scaleLocal =
            scaleQueue_
                .DeQue<float>();

        auto pertokenLocal =
            pertokenQueue_
                .AllocTensor<float>();

        AscendC::DataCopyExtParams
            pertokenCopy{
                1,
                static_cast<uint32_t>(
                    tileM *
                    sizeof(float)),
                0,
                0,
                0};

        AscendC::DataCopyPadExtParams<float>
            pertokenPad{
                false,
                0,
                0,
                0};

        AscendC::DataCopyPad(
            pertokenLocal,
            pertokenGm_[
                slice_.mStart +
                tileMStart],
            pertokenCopy,
            pertokenPad);

        pertokenQueue_
            .EnQue(
                pertokenLocal);

        pertokenLocal =
            pertokenQueue_
                .DeQue<float>();

        AscendC::SetFlag<
            AscendC::HardEvent::MTE2_S>(
            mte2ToScalarEvent_);

        AscendC::WaitFlag<
            AscendC::HardEvent::MTE2_S>(
            mte2ToScalarEvent_);

        auto fp32Local =
            fp32Buf_.Get<float>();

        CastInSegments(
            fp32Local,
            matmulLocal,
            AscendC::RoundMode::
                CAST_NONE,
            validElements);

        for (uint32_t row = 0;
             row < tileM;
             ++row) {

            const uint32_t rowOffset =
                row * tileN;

            AscendC::Mul(
                fp32Local[rowOffset],
                fp32Local[rowOffset],
                scaleLocal,
                tileN);
        }

        for (uint32_t row = 0;
             row < tileM;
             ++row) {

            AscendC::Muls(
                fp32Local[
                    row * tileN],
                fp32Local[
                    row * tileN],
                pertokenLocal
                    .GetValue(row),
                tileN);
        }

        auto outputLocal =
            outputQueue_
                .AllocTensor<
                    bfloat16_t>();

        CastInSegments(
            outputLocal,
            fp32Local,
            AscendC::RoundMode::
                CAST_RINT,
            validElements);

        outputQueue_.EnQue(
            outputLocal);

        outputLocal =
            outputQueue_
                .DeQue<bfloat16_t>();

        const uint64_t outputOffset =
            static_cast<uint64_t>(
                slice_.mStart +
                tileMStart) *
                tiling_.N +
            slice_.nStart +
            tileNStart;

        AscendC::DataCopyExtParams
            outputCopy{
                static_cast<uint16_t>(
                    tileM),

                static_cast<uint32_t>(
                    tileN *
                    sizeof(
                        bfloat16_t)),

                0,

                static_cast<uint32_t>(
                    (tiling_.N -
                     tileN) *
                    sizeof(
                        bfloat16_t)),

                0};

        AscendC::DataCopyPad(
            yGm_[outputOffset],
            outputLocal,
            outputCopy);

        outputQueue_
            .FreeTensor(
                outputLocal);

        pertokenQueue_
            .FreeTensor(
                pertokenLocal);

        scaleQueue_
            .FreeTensor(
                scaleLocal);
    }

    template <typename DstT,
              typename SrcT>
    __aicore__ inline void
    CastInSegments(
        const AscendC::LocalTensor<DstT>
            &dst,
        const AscendC::LocalTensor<SrcT>
            &src,
        AscendC::RoundMode roundMode,
        uint32_t count)
    {
        constexpr uint32_t
            kMaxCastElements =
                255U * 64U;

        uint32_t offset = 0;

        while (offset < count) {

            const uint32_t current =
                QmmMin(
                    count - offset,
                    kMaxCastElements);

            AscendC::Cast(
                dst[offset],
                src[offset],
                roundMode,
                current);

            offset += current;
        }
    }

    CoreSlice slice_{};

    AscendC::GlobalTensor<int8_t>
        x1Gm_;

    AscendC::GlobalTensor<int8_t>
        x2Gm_;

    AscendC::GlobalTensor<float>
        scaleGm_;

    AscendC::GlobalTensor<float>
        pertokenGm_;

    AscendC::GlobalTensor<bfloat16_t>
        yGm_;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        1>
        matmulQueue_;

    AscendC::TBuf<
        AscendC::TPosition::VECCALC>
        fp32Buf_;

    AscendC::TQue<
        AscendC::QuePosition::VECOUT,
        1>
        outputQueue_;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        1>
        scaleQueue_;

    AscendC::TQue<
        AscendC::QuePosition::VECIN,
        1>
        pertokenQueue_;

    AscendC::TPipe *pipe_ =
        nullptr;

    AscendC::TEventID
        mte2ToScalarEvent_{};
};

__global__ __mix__(1, 2) __aicore__
void qmm_custom_kernel(
    GM_ADDR x1,
    GM_ADDR x2,
    GM_ADDR scale,
    GM_ADDR pertoken_scale,
    GM_ADDR y,
    GM_ADDR __kfc_workspace__ workspace,
    QmmCustomTilingData tilingData)
{
    if (GetSysWorkSpacePtr() == nullptr ||
        AscendC::GetBlockIdx() >=
            tilingData
                .cubeTilingData
                .usedCoreNum) {
        return;
    }

    AscendC::TPipe pipe;

    if (tilingData.isPertoken == 0U) {

        QmmCubeBasicKernel kernel;

        kernel.Init(
            x1,
            x2,
            y,
            &tilingData);

        REGIST_MATMUL_OBJ(
            &pipe,
            GetSysWorkSpacePtr(),
            kernel.matmulObj_,
            &kernel.tiling_);

        kernel.Process();

    } else {

        QmmPertokenKernel kernel;

        kernel.Init(
            x1,
            x2,
            scale,
            pertoken_scale,
            y,
            &tilingData,
            &pipe);

        REGIST_MATMUL_OBJ(
            &pipe,
            GetSysWorkSpacePtr(),
            kernel.matmulObj_,
            &kernel.tiling_);

        kernel.Process();
    }
}


#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor {
  uint32_t type;     // Tensor类型: 0表示输入, 1表示输出。
  uint32_t format;   // Format类型, 对应aclFormat。
  uint32_t dataType; // 数据类型, 对应aclDataType。
  uint32_t shapeDim; // Shape维度数量, 最大支持8维。
  uint32_t shape[8]; // Shape信息。
};

struct aclprofTensorInfo {
  uint64_t opNameId; // 通过uint64_t aclprofStr2Id(const char *message)转化
  uint64_t opTypeId; // 通过uint64_t aclprofStr2Id(const char *message)转化
  uint32_t resv;
  uint32_t tensorNum;
  uint32_t kernelType;
  uint32_t blockNums;
  void *stream;
  aclprofTensor *tensors;
};

struct aclprofEventAttributes {
  uint16_t version;
  uint16_t size;
  uint32_t messageType;
  union message {
    aclprofTensorInfo *tensorInfo;
  } message;
};
#endif // ACL_PROF_TENSOR_INFO_DEFINED

#define INPUT(x)                                                               \
  aclprofTensor {                                                              \
    (uint32_t)0,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(x.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(x.scalar_type())),   \
        static_cast<uint32_t>(x.sizes().size()), {                             \
      static_cast<uint32_t>(x.sizes().size() > 0 ? x.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(x.sizes().size() > 1 ? x.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 2 ? x.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 3 ? x.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define OUTPUT(z)                                                              \
  aclprofTensor {                                                              \
    (uint32_t)1,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(z.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(z.scalar_type())),   \
        static_cast<uint32_t>(z.sizes().size()), {                             \
      static_cast<uint32_t>(z.sizes().size() > 0 ? z.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(z.sizes().size() > 1 ? z.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 2 ? z.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 3 ? z.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define INIT_ACL_PROF_TENSOR_INFO(opName, opType, blockdim, kernelType,        \
                                  tensorInfo, stream, ...)                     \
  uint64_t opNameId = aclprofStr2Id(opName);                                   \
  uint64_t opTypeId = aclprofStr2Id(opType);                                   \
  struct aclprofTensor tensors[] = {__VA_ARGS__};                              \
  tensorInfo = {                                                               \
      opNameId,   opTypeId, 0,      sizeof(tensors) / sizeof(aclprofTensor),   \
      kernelType, blockdim, stream, tensors}

namespace ascendc_ops {

aclDataType GetAclDataType(at::ScalarType scalarType) {
  switch (scalarType) {
  case at::ScalarType::Float:
    return ACL_FLOAT;
  case at::ScalarType::Int:
    return ACL_INT32;
  case at::ScalarType::BFloat16:
    return ACL_BF16;
  case at::ScalarType::Byte:
    return ACL_UINT8;
  case at::ScalarType::Char:
    return ACL_INT8;
  default:
    TORCH_CHECK(false,
                "Unsupported tensor dtype for profiling report: ", scalarType);
  }
}

aclFormat GetFormat(int64_t dimNum) {
  aclFormat format = ACL_FORMAT_ND;
  if (dimNum == 4) {
    format = ACL_FORMAT_FRACTAL_NZ;
  }
  return format;
}

at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2,
                      const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale) {
  auto aclStream = c10_npu::getCurrentNPUStream().stream(true);

  auto M = x1.size(0);
  auto K = x1.size(1);
  auto N = x2.size(1);

  uint32_t isPertoken =
      pertoken_scale.has_value() && pertoken_scale.value().defined() ? 1 : 0;
  at::ScalarType output_dtype =
      isPertoken ? at::ScalarType::BFloat16 : at::ScalarType::Int;
  at::Tensor y = at::empty({M, N}, x1.options().dtype(output_dtype));

  QmmCustomTilingData tilingData = CalcQmmTiling(isPertoken, M, N, K);
  uint32_t numBlocks = tilingData.numBlocks;

  at::Tensor workspaceTensor =
      at::empty({static_cast<int64_t>(tilingData.workspaceSize)},
                x1.options().dtype(at::ScalarType::Byte));

  aclprofTensorInfo tensorInfo;
  uint64_t opNameId = aclprofStr2Id("qmm_custom");
  uint64_t opTypeId = aclprofStr2Id("QmmCustom");
  uint8_t *pertokenPtr =
      isPertoken ? (uint8_t *)(pertoken_scale.value().mutable_data_ptr())
                 : nullptr;
  std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale)};
  if (isPertoken) {
    tensors.push_back(INPUT(pertoken_scale.value()));
  }
  tensors.push_back(OUTPUT(y));
  tensorInfo = {opNameId, opTypeId,  0,         (uint32_t)tensors.size(),
                0,        numBlocks, aclStream, tensors.data()};

  aclprofEventAttributes attrs = {1, sizeof(aclprofEventAttributes::message), 0,
                                  &tensorInfo};

  aclprofRangePushEx(&attrs);
  qmm_custom_kernel<<<numBlocks, 0, aclStream>>>(
      (uint8_t *)(x1.mutable_data_ptr()), (uint8_t *)(x2.mutable_data_ptr()),
      (uint8_t *)(scale.mutable_data_ptr()), pertokenPtr,
      (uint8_t *)(y.mutable_data_ptr()), workspaceTensor.data_ptr<uint8_t>(),
      tilingData);
  aclprofRangePop();
  return y;
}
} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m) {
  m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? "
        "pertoken_scale=None) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m) {
  m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}

#include <cmath>
#include "acl/acl.h"
#include "kernel_operator.h"

/*
 * GlobalAvgPool — Ascend C 内核（直接 include 使用）
 * 注意: 本文件会被 #include, 不要添加 main() / #pragma once / include guard。
 *
 * 语义: 对 (N, C, H, W) 逐通道求空间均值, 输出 (N, C, 1, 1)。
 * 精度: 统一用 fp32 累加, fp32 输入误差 < 1e-4, fp16 输入误差 < 1e-3。
 *
 * 三条路径:
 *   1) spatial 32B 对齐且能整批放入 UB: B 通道一次 DataCopy + Pattern ReduceSum 批量归约;
 *   2) spatial 非对齐且能整批放入 UB: B 行逐行 DataCopyPad(单块补零) + Pattern ReduceSum 批量归约;
 *   3) spatial 过大(单通道放不下 UB): 双缓冲软件流水线, DataCopy 与 ReduceSum 重叠,
 *      每 tile 独立归约成标量后累加, 无累加器/清零/Add。
 */

constexpr int32_t VEC_BYTES = 32;
constexpr int32_t OUT_BUF = 256;
constexpr int64_t UB_BUDGET = 128 * 1024;
constexpr uint32_t MAX_TILE_F32 = 8192;    // 双缓冲: 2*32KB in + 32KB tmp = 96KB
constexpr uint32_t MAX_TILE_F16 = 8192;    // 2*16KB in + 32KB fp32 + 32KB tmp = 96KB

// ============ 路径 3: spatial 过大, 双缓冲 + 每 tile 独立 ReduceSum ============

__aicore__ inline void F32LoadTile(const AscendC::GlobalTensor<float>& gmX,
                                   AscendC::LocalTensor<float> inL,
                                   int64_t off, uint32_t n)
{
    uint32_t align = (n + 7) / 8 * 8;
    if (n == align) {
        AscendC::DataCopy(inL, gmX[off], n);
    } else {
        AscendC::DataCopyExtParams ext(1, static_cast<uint32_t>(n * sizeof(float)), 0, 0, 0);
        AscendC::DataCopyPadExtParams<float> pad(true, 0, static_cast<uint8_t>(align - n), 0.0f);
        AscendC::DataCopyPad(inL, gmX[off], ext, pad);
    }
}

__aicore__ inline float F32ChanAvg(const AscendC::GlobalTensor<float>& gmX, int64_t ch,
                                   int64_t spatial, uint32_t tileLen,
                                   const AscendC::LocalTensor<uint8_t>& tmpL,
                                   const AscendC::LocalTensor<float>& dstL,
                                   AscendC::TQue<AscendC::QuePosition::VECIN, 2>& qIn)
{
    int64_t base = ch * spatial;
    int64_t rest = spatial;
    float total = 0.0f;

    uint32_t n0 = (rest >= static_cast<int64_t>(tileLen)) ? tileLen : static_cast<uint32_t>(rest);
    uint32_t curAlign = (n0 + 7) / 8 * 8;
    AscendC::LocalTensor<float> inCur = qIn.AllocTensor<float>();
    F32LoadTile(gmX, inCur, base, n0);
    qIn.EnQue(inCur);
    base += n0;
    rest -= n0;

    while (rest > 0) {
        uint32_t n = (rest >= static_cast<int64_t>(tileLen)) ? tileLen : static_cast<uint32_t>(rest);
        uint32_t nxtAlign = (n + 7) / 8 * 8;
        AscendC::LocalTensor<float> inNxt = qIn.AllocTensor<float>();
        F32LoadTile(gmX, inNxt, base, n);
        qIn.EnQue(inNxt);

        inCur = qIn.DeQue<float>();
        uint32_t srcShape[2] = { 1, curAlign };
        AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(dstL, inCur, tmpL, srcShape, true);
        total += dstL.GetValue(0);
        qIn.FreeTensor(inCur);

        inCur = inNxt;
        curAlign = nxtAlign;
        base += n;
        rest -= n;
    }

    inCur = qIn.DeQue<float>();
    uint32_t srcShape[2] = { 1, curAlign };
    AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(dstL, inCur, tmpL, srcShape, true);
    total += dstL.GetValue(0);
    qIn.FreeTensor(inCur);

    return total / static_cast<float>(spatial);
}

__aicore__ inline void F16LoadTile(const AscendC::GlobalTensor<half>& gmX,
                                   AscendC::LocalTensor<half> inH,
                                   int64_t off, uint32_t n)
{
    uint32_t align = (n + 15) / 16 * 16;
    if (n == align) {
        AscendC::DataCopy(inH, gmX[off], n);
    } else {
        AscendC::DataCopyExtParams ext(1, static_cast<uint32_t>(n * sizeof(half)), 0, 0, 0);
        AscendC::DataCopyPadExtParams<half> pad(true, 0, static_cast<uint8_t>(align - n),
                                                static_cast<half>(0.0f));
        AscendC::DataCopyPad(inH, gmX[off], ext, pad);
    }
}

__aicore__ inline float F16ChanAvg(const AscendC::GlobalTensor<half>& gmX, int64_t ch,
                                   int64_t spatial, uint32_t tileLen,
                                   const AscendC::LocalTensor<float>& fp32L,
                                   const AscendC::LocalTensor<uint8_t>& tmpL,
                                   const AscendC::LocalTensor<float>& dstL,
                                   AscendC::TQue<AscendC::QuePosition::VECIN, 2>& qIn)
{
    int64_t base = ch * spatial;
    int64_t rest = spatial;
    float total = 0.0f;

    uint32_t n0 = (rest >= static_cast<int64_t>(tileLen)) ? tileLen : static_cast<uint32_t>(rest);
    uint32_t curAlign = (n0 + 15) / 16 * 16;
    AscendC::LocalTensor<half> inCur = qIn.AllocTensor<half>();
    F16LoadTile(gmX, inCur, base, n0);
    qIn.EnQue(inCur);
    base += n0;
    rest -= n0;

    while (rest > 0) {
        uint32_t n = (rest >= static_cast<int64_t>(tileLen)) ? tileLen : static_cast<uint32_t>(rest);
        uint32_t nxtAlign = (n + 15) / 16 * 16;
        AscendC::LocalTensor<half> inNxt = qIn.AllocTensor<half>();
        F16LoadTile(gmX, inNxt, base, n);
        qIn.EnQue(inNxt);

        inCur = qIn.DeQue<half>();
        AscendC::Cast(fp32L, inCur, AscendC::RoundMode::CAST_NONE, curAlign);
        uint32_t srcShape[2] = { 1, curAlign };
        AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(dstL, fp32L, tmpL, srcShape, true);
        total += dstL.GetValue(0);
        qIn.FreeTensor(inCur);

        inCur = inNxt;
        curAlign = nxtAlign;
        base += n;
        rest -= n;
    }

    inCur = qIn.DeQue<half>();
    AscendC::Cast(fp32L, inCur, AscendC::RoundMode::CAST_NONE, curAlign);
    uint32_t srcShape[2] = { 1, curAlign };
    AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(dstL, fp32L, tmpL, srcShape, true);
    total += dstL.GetValue(0);
    qIn.FreeTensor(inCur);

    return total / static_cast<float>(spatial);
}

// ============ 路径 1: spatial 对齐批量 ============

__aicore__ inline void F32BatchAvg(const AscendC::GlobalTensor<float>& gmX, int64_t c0, int32_t B,
                                   int64_t spatial,
                                   const AscendC::LocalTensor<float>& dstL,
                                   const AscendC::LocalTensor<uint8_t>& tmpL,
                                   const AscendC::LocalTensor<float>& outL, int32_t outOff,
                                   AscendC::TQue<AscendC::QuePosition::VECIN, 1>& qIn)
{
    AscendC::LocalTensor<float> inL = qIn.AllocTensor<float>();
    AscendC::DataCopy(inL, gmX[c0 * spatial], static_cast<uint32_t>(B * spatial));
    qIn.EnQue(inL);
    inL = qIn.DeQue<float>();

    uint32_t srcShape[2] = { static_cast<uint32_t>(B), static_cast<uint32_t>(spatial) };
    AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(dstL, inL, tmpL, srcShape, true);
    qIn.FreeTensor(inL);

    float inv = 1.0f / static_cast<float>(spatial);
    for (int32_t i = 0; i < B; ++i) {
        outL.SetValue(outOff + i, dstL.GetValue(i) * inv);
    }
}

__aicore__ inline void F16BatchAvg(const AscendC::GlobalTensor<half>& gmX, int64_t c0, int32_t B,
                                   int64_t spatial,
                                   const AscendC::LocalTensor<float>& inF32,
                                   const AscendC::LocalTensor<float>& dstL,
                                   const AscendC::LocalTensor<uint8_t>& tmpL,
                                   const AscendC::LocalTensor<float>& outL, int32_t outOff,
                                   AscendC::TQue<AscendC::QuePosition::VECIN, 1>& qIn)
{
    AscendC::LocalTensor<half> inH = qIn.AllocTensor<half>();
    AscendC::DataCopy(inH, gmX[c0 * spatial], static_cast<uint32_t>(B * spatial));
    qIn.EnQue(inH);
    inH = qIn.DeQue<half>();
    AscendC::Cast(inF32, inH, AscendC::RoundMode::CAST_NONE, static_cast<uint32_t>(B * spatial));
    qIn.FreeTensor(inH);

    uint32_t srcShape[2] = { static_cast<uint32_t>(B), static_cast<uint32_t>(spatial) };
    AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(dstL, inF32, tmpL, srcShape, true);

    float inv = 1.0f / static_cast<float>(spatial);
    for (int32_t i = 0; i < B; ++i) {
        outL.SetValue(outOff + i, dstL.GetValue(i) * inv);
    }
}

// ============ 路径 2: spatial 非对齐批量 ============

__aicore__ inline void F32BatchUnaligned(const AscendC::GlobalTensor<float>& gmX, int64_t c0, int32_t B,
                                         int64_t spatial, uint32_t alignedCols,
                                         const AscendC::LocalTensor<float>& dstL,
                                         const AscendC::LocalTensor<uint8_t>& tmpL,
                                         const AscendC::LocalTensor<float>& outL, int32_t outOff,
                                         AscendC::TQue<AscendC::QuePosition::VECIN, 1>& qIn)
{
    AscendC::LocalTensor<float> inL = qIn.AllocTensor<float>();
    AscendC::DataCopyExtParams ext(1, static_cast<uint32_t>(spatial * sizeof(float)), 0, 0, 0);
    AscendC::DataCopyPadExtParams<float> pad(true, 0,
        static_cast<uint8_t>(alignedCols - static_cast<uint32_t>(spatial)), 0.0f);
    for (int32_t i = 0; i < B; ++i) {
        AscendC::DataCopyPad(inL[i * static_cast<int32_t>(alignedCols)], gmX[(c0 + i) * spatial], ext, pad);
    }
    qIn.EnQue(inL);
    inL = qIn.DeQue<float>();

    uint32_t srcShape[2] = { static_cast<uint32_t>(B), alignedCols };
    AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(dstL, inL, tmpL, srcShape, true);
    qIn.FreeTensor(inL);

    float inv = 1.0f / static_cast<float>(spatial);
    for (int32_t i = 0; i < B; ++i) {
        outL.SetValue(outOff + i, dstL.GetValue(i) * inv);
    }
}

__aicore__ inline void F16BatchUnaligned(const AscendC::GlobalTensor<half>& gmX, int64_t c0, int32_t B,
                                         int64_t spatial, uint32_t alignedCols,
                                         const AscendC::LocalTensor<float>& inF32,
                                         const AscendC::LocalTensor<float>& dstL,
                                         const AscendC::LocalTensor<uint8_t>& tmpL,
                                         const AscendC::LocalTensor<float>& outL, int32_t outOff,
                                         AscendC::TQue<AscendC::QuePosition::VECIN, 1>& qIn)
{
    AscendC::LocalTensor<half> inH = qIn.AllocTensor<half>();
    AscendC::DataCopyExtParams ext(1, static_cast<uint32_t>(spatial * sizeof(half)), 0, 0, 0);
    AscendC::DataCopyPadExtParams<half> pad(true, 0,
        static_cast<uint8_t>(alignedCols - static_cast<uint32_t>(spatial)), static_cast<half>(0.0f));
    for (int32_t i = 0; i < B; ++i) {
        AscendC::DataCopyPad(inH[i * static_cast<int32_t>(alignedCols)], gmX[(c0 + i) * spatial], ext, pad);
    }
    qIn.EnQue(inH);
    inH = qIn.DeQue<half>();
    AscendC::Cast(inF32, inH, AscendC::RoundMode::CAST_NONE,
                  static_cast<uint32_t>(B) * alignedCols);
    qIn.FreeTensor(inH);

    uint32_t srcShape[2] = { static_cast<uint32_t>(B), alignedCols };
    AscendC::ReduceSum<float, AscendC::Pattern::Reduce::AR>(dstL, inF32, tmpL, srcShape, true);

    float inv = 1.0f / static_cast<float>(spatial);
    for (int32_t i = 0; i < B; ++i) {
        outL.SetValue(outOff + i, dstL.GetValue(i) * inv);
    }
}

__global__ __vector__ void gap_vec_kernel(GM_ADDR x, GM_ADDR y,
                                          int64_t totalChannels,
                                          int64_t spatial,
                                          int32_t dtype)
{
    int64_t coreIdx = static_cast<int64_t>(AscendC::GetBlockIdx());
    int64_t coreNum = static_cast<int64_t>(AscendC::GetBlockNum());

    int32_t elemSize = (dtype == 0) ? 4 : 2;
    int32_t lanes = VEC_BYTES / elemSize;

    int64_t aligned = totalChannels / lanes * lanes;
    int64_t mainUnits = aligned / lanes;
    int64_t tail = totalChannels - aligned;
    int64_t unitPerCore = (mainUnits + coreNum - 1) / coreNum;
    int64_t u0 = coreIdx * unitPerCore;
    int64_t u1 = u0 + unitPerCore;
    if (u1 > mainUnits) u1 = mainUnits;
    int64_t c0 = u0 * lanes;
    int64_t c1 = u1 * lanes;

    int64_t alignedCols = (spatial + lanes - 1) / lanes * lanes;
    bool alignedSpatial = (spatial % lanes == 0);
    int64_t perRowBytes = (dtype == 0) ? 8 : 10;
    int64_t maxB = (UB_BUDGET / (alignedCols * perRowBytes)) / lanes * lanes;
    if (maxB > OUT_BUF) maxB = OUT_BUF;
    bool batchable = (maxB >= lanes);
    uint32_t aCols = static_cast<uint32_t>(alignedCols);

    AscendC::TPipe pipe;

    if (dtype == 0) {
        AscendC::GlobalTensor<float> gmX;
        AscendC::GlobalTensor<float> gmY;
        gmX.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(x), totalChannels * spatial);
        gmY.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y), totalChannels);

        if (batchable) {
            AscendC::TQue<AscendC::QuePosition::VECIN, 1> qIn;
            AscendC::TBuf<> tmpBuf;
            AscendC::TBuf<> dstBuf;
            AscendC::TBuf<> outBuf;
            pipe.InitBuffer(qIn, 1, maxB * alignedCols * sizeof(float));
            pipe.InitBuffer(tmpBuf, maxB * alignedCols * sizeof(float));
            pipe.InitBuffer(dstBuf, maxB * sizeof(float));
            pipe.InitBuffer(outBuf, OUT_BUF * sizeof(float));
            AscendC::LocalTensor<uint8_t> tmpL = tmpBuf.Get<uint8_t>();
            AscendC::LocalTensor<float> dstL = dstBuf.Get<float>();
            AscendC::LocalTensor<float> outL = outBuf.Get<float>();

            int64_t c = c0;
            int32_t bufCnt = 0;
            while (c < c1) {
                int32_t B = static_cast<int32_t>((c1 - c) < maxB ? (c1 - c) : maxB);
                if (alignedSpatial) {
                    F32BatchAvg(gmX, c, B, spatial, dstL, tmpL, outL, bufCnt, qIn);
                } else {
                    F32BatchUnaligned(gmX, c, B, spatial, aCols, dstL, tmpL, outL, bufCnt, qIn);
                }
                bufCnt += B;
                c += B;
                if (bufCnt == OUT_BUF) {
                    AscendC::DataCopy(gmY[c - OUT_BUF], outL, static_cast<uint32_t>(OUT_BUF));
                    bufCnt = 0;
                }
            }
            if (bufCnt > 0) {
                AscendC::DataCopy(gmY[c - bufCnt], outL, static_cast<uint32_t>(bufCnt));
            }

            if (coreIdx == 0 && tail > 0) {
                int64_t tc = aligned;
                int32_t tCnt = 0;
                while (tc < totalChannels) {
                    int32_t B = static_cast<int32_t>((totalChannels - tc) < maxB ? (totalChannels - tc) : maxB);
                    if (alignedSpatial) {
                        F32BatchAvg(gmX, tc, B, spatial, dstL, tmpL, outL, tCnt, qIn);
                    } else {
                        F32BatchUnaligned(gmX, tc, B, spatial, aCols, dstL, tmpL, outL, tCnt, qIn);
                    }
                    tCnt += B;
                    tc += B;
                }
                int32_t wCnt = (tCnt + lanes - 1) / lanes * lanes;
                AscendC::DataCopy(gmY[aligned], outL, static_cast<uint32_t>(wCnt));
            }
        } else {
            uint32_t tileLen = MAX_TILE_F32;
            if (tileLen > static_cast<uint32_t>(spatial)) tileLen = static_cast<uint32_t>(spatial);

            AscendC::TQue<AscendC::QuePosition::VECIN, 2> qIn;
            AscendC::TBuf<> tmpBuf;
            AscendC::TBuf<> dstBuf;
            AscendC::TBuf<> outBuf;
            pipe.InitBuffer(qIn, 2, tileLen * sizeof(float));
            pipe.InitBuffer(tmpBuf, tileLen * sizeof(float));
            pipe.InitBuffer(dstBuf, 32);
            pipe.InitBuffer(outBuf, OUT_BUF * sizeof(float));
            AscendC::LocalTensor<uint8_t> tmpL = tmpBuf.Get<uint8_t>();
            AscendC::LocalTensor<float> dstL = dstBuf.Get<float>();
            AscendC::LocalTensor<float> outL = outBuf.Get<float>();

            int64_t c = c0;
            int32_t bufCnt = 0;
            while (c < c1) {
                int32_t n = static_cast<int32_t>((c1 - c) < (OUT_BUF - bufCnt) ? (c1 - c) : (OUT_BUF - bufCnt));
                for (int32_t i = 0; i < n; ++i) {
                    outL.SetValue(bufCnt + i, F32ChanAvg(gmX, c + i, spatial, tileLen, tmpL, dstL, qIn));
                }
                bufCnt += n;
                c += n;
                if (bufCnt == OUT_BUF) {
                    AscendC::DataCopy(gmY[c - OUT_BUF], outL, static_cast<uint32_t>(OUT_BUF));
                    bufCnt = 0;
                }
            }
            if (bufCnt > 0) {
                AscendC::DataCopy(gmY[c - bufCnt], outL, static_cast<uint32_t>(bufCnt));
            }

            if (coreIdx == 0 && tail > 0) {
                for (int64_t i = 0; i < tail; ++i) {
                    outL.SetValue(i, F32ChanAvg(gmX, aligned + i, spatial, tileLen, tmpL, dstL, qIn));
                }
                AscendC::DataCopy(gmY[aligned], outL, static_cast<uint32_t>(lanes));
            }
        }
    } else {
        AscendC::GlobalTensor<half> gmX;
        AscendC::GlobalTensor<half> gmY;
        gmX.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(x), totalChannels * spatial);
        gmY.SetGlobalBuffer(reinterpret_cast<__gm__ half *>(y), totalChannels);

        if (batchable) {
            AscendC::TQue<AscendC::QuePosition::VECIN, 1> qIn;
            AscendC::TBuf<> f32Buf;
            AscendC::TBuf<> tmpBuf;
            AscendC::TBuf<> dstBuf;
            AscendC::TBuf<> outBuf;
            AscendC::TBuf<> outHbuf;
            pipe.InitBuffer(qIn, 1, maxB * alignedCols * sizeof(half));
            pipe.InitBuffer(f32Buf, maxB * alignedCols * sizeof(float));
            pipe.InitBuffer(tmpBuf, maxB * alignedCols * sizeof(float));
            pipe.InitBuffer(dstBuf, maxB * sizeof(float));
            pipe.InitBuffer(outBuf, OUT_BUF * sizeof(float));
            pipe.InitBuffer(outHbuf, OUT_BUF * sizeof(half));
            AscendC::LocalTensor<float> inF32 = f32Buf.Get<float>();
            AscendC::LocalTensor<uint8_t> tmpL = tmpBuf.Get<uint8_t>();
            AscendC::LocalTensor<float> dstL = dstBuf.Get<float>();
            AscendC::LocalTensor<float> outL = outBuf.Get<float>();
            AscendC::LocalTensor<half> outH = outHbuf.Get<half>();

            int64_t c = c0;
            int32_t bufCnt = 0;
            while (c < c1) {
                int32_t B = static_cast<int32_t>((c1 - c) < maxB ? (c1 - c) : maxB);
                if (alignedSpatial) {
                    F16BatchAvg(gmX, c, B, spatial, inF32, dstL, tmpL, outL, bufCnt, qIn);
                } else {
                    F16BatchUnaligned(gmX, c, B, spatial, aCols, inF32, dstL, tmpL, outL, bufCnt, qIn);
                }
                bufCnt += B;
                c += B;
                if (bufCnt == OUT_BUF) {
                    AscendC::Cast(outH, outL, AscendC::RoundMode::CAST_ROUND, OUT_BUF);
                    AscendC::DataCopy(gmY[c - OUT_BUF], outH, static_cast<uint32_t>(OUT_BUF));
                    bufCnt = 0;
                }
            }
            if (bufCnt > 0) {
                int32_t wCnt = (bufCnt + lanes - 1) / lanes * lanes;
                AscendC::Cast(outH, outL, AscendC::RoundMode::CAST_ROUND, wCnt);
                AscendC::DataCopy(gmY[c - bufCnt], outH, static_cast<uint32_t>(wCnt));
            }

            if (coreIdx == 0 && tail > 0) {
                int64_t tc = aligned;
                int32_t tCnt = 0;
                while (tc < totalChannels) {
                    int32_t B = static_cast<int32_t>((totalChannels - tc) < maxB ? (totalChannels - tc) : maxB);
                    if (alignedSpatial) {
                        F16BatchAvg(gmX, tc, B, spatial, inF32, dstL, tmpL, outL, tCnt, qIn);
                    } else {
                        F16BatchUnaligned(gmX, tc, B, spatial, aCols, inF32, dstL, tmpL, outL, tCnt, qIn);
                    }
                    tCnt += B;
                    tc += B;
                }
                int32_t wCnt = (tCnt + lanes - 1) / lanes * lanes;
                AscendC::Cast(outH, outL, AscendC::RoundMode::CAST_ROUND, wCnt);
                AscendC::DataCopy(gmY[aligned], outH, static_cast<uint32_t>(wCnt));
            }
        } else {
            uint32_t tileLen = MAX_TILE_F16;
            if (tileLen > static_cast<uint32_t>(spatial)) tileLen = static_cast<uint32_t>(spatial);

            AscendC::TQue<AscendC::QuePosition::VECIN, 2> qIn;
            AscendC::TBuf<> fp32Buf;
            AscendC::TBuf<> tmpBuf;
            AscendC::TBuf<> dstBuf;
            AscendC::TBuf<> outBuf;
            AscendC::TBuf<> outHbuf;
            pipe.InitBuffer(qIn, 2, tileLen * sizeof(half));
            pipe.InitBuffer(fp32Buf, tileLen * sizeof(float));
            pipe.InitBuffer(tmpBuf, tileLen * sizeof(float));
            pipe.InitBuffer(dstBuf, 32);
            pipe.InitBuffer(outBuf, OUT_BUF * sizeof(float));
            pipe.InitBuffer(outHbuf, OUT_BUF * sizeof(half));
            AscendC::LocalTensor<float> fp32L = fp32Buf.Get<float>();
            AscendC::LocalTensor<uint8_t> tmpL = tmpBuf.Get<uint8_t>();
            AscendC::LocalTensor<float> dstL = dstBuf.Get<float>();
            AscendC::LocalTensor<float> outL = outBuf.Get<float>();
            AscendC::LocalTensor<half> outH = outHbuf.Get<half>();

            int64_t c = c0;
            int32_t bufCnt = 0;
            while (c < c1) {
                int32_t n = static_cast<int32_t>((c1 - c) < (OUT_BUF - bufCnt) ? (c1 - c) : (OUT_BUF - bufCnt));
                for (int32_t i = 0; i < n; ++i) {
                    outL.SetValue(bufCnt + i, F16ChanAvg(gmX, c + i, spatial, tileLen, fp32L, tmpL, dstL, qIn));
                }
                bufCnt += n;
                c += n;
                if (bufCnt == OUT_BUF) {
                    AscendC::Cast(outH, outL, AscendC::RoundMode::CAST_ROUND, OUT_BUF);
                    AscendC::DataCopy(gmY[c - OUT_BUF], outH, static_cast<uint32_t>(OUT_BUF));
                    bufCnt = 0;
                }
            }
            if (bufCnt > 0) {
                int32_t wCnt = (bufCnt + lanes - 1) / lanes * lanes;
                AscendC::Cast(outH, outL, AscendC::RoundMode::CAST_ROUND, wCnt);
                AscendC::DataCopy(gmY[c - bufCnt], outH, static_cast<uint32_t>(wCnt));
            }

            if (coreIdx == 0 && tail > 0) {
                for (int64_t i = 0; i < tail; ++i) {
                    outL.SetValue(i, F16ChanAvg(gmX, aligned + i, spatial, tileLen, fp32L, tmpL, dstL, qIn));
                }
                AscendC::Cast(outH, outL, AscendC::RoundMode::CAST_ROUND, static_cast<uint32_t>(lanes));
                AscendC::DataCopy(gmY[aligned], outH, static_cast<uint32_t>(lanes));
            }
        }
    }
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& xInfo = info_x.tensors[0];
    int64_t nd = xInfo.numDims;
    int64_t N = xInfo.shape[0];
    int64_t C = xInfo.shape[1];
    int64_t spatial = 1;
    for (int64_t d = 2; d < nd; ++d) {
        spatial *= xInfo.shape[d];
    }
    int32_t dtype = xInfo.dtype;

    int64_t totalChannels = N * C;
    int64_t coreNum = (totalChannels < availableCoreNum) ? totalChannels : availableCoreNum;
    if (coreNum < 1) coreNum = 1;

    int32_t elemSize = (dtype == 0) ? 4 : 2;
    int32_t lanes = VEC_BYTES / elemSize;
    int64_t paddedElems = ((totalChannels + lanes - 1) / lanes) * lanes;
    int64_t paddedBytes = paddedElems * elemSize;

    void* yPadded = nullptr;
    if (aclrtMalloc(&yPadded, paddedBytes, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
        return;
    }

    gap_vec_kernel<<<coreNum, nullptr, stream>>>(
        x, (GM_ADDR)yPadded, totalChannels, spatial, dtype);

    aclrtMemcpyAsync((void*)y, static_cast<size_t>(totalChannels * elemSize),
                     yPadded, static_cast<size_t>(totalChannels * elemSize),
                     ACL_MEMCPY_DEVICE_TO_DEVICE, stream);
    aclrtSynchronizeStream(stream);
    aclrtFree(yPadded);
}
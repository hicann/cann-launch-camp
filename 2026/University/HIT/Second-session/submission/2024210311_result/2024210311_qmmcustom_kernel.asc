#include <cmath>
#include <cstdint>
#include <cstdio>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"

/*
 * QmmCustom — Ascend C 内核（直接 include 使用）
 * 注意: 本文件会被 #include, 不要添加 main() / #pragma once / include guard。
 *
 * 预定义结构:
 *   TensorInfo      { const int64_t* shape; int64_t numDims; int32_t dtype; }
 *   TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; }
 *
 * 功能: INT8 量化矩阵乘
 *   x1: [M, K] int8 ND            量化激活
 *   x2: [K, N] int8 FRACTAL_NZ    量化权重(内存即 NZ 排布)
 *   scale: [N] fp32               per-channel 缩放
 *   pertoken_scale: [M] fp32(可选) per-token 缩放
 *   y: [M, N] int32(无 pertoken_scale) / bf16(有 pertoken_scale)
 */

// ================= Tiling 参数 =================
#pragma pack(push, 8)
struct QmmTile {
    AscendC::tiling::TCubeTiling cube;
    uint32_t deq;     // 1: BF16 反量化路径; 0: INT32 路径
    uint32_t wsSize;  // 用户 workspace 字节数
};
#pragma pack(pop)

// ================= 设备侧小工具 =================
__aicore__ inline uint32_t CDiv(uint32_t a, uint32_t b)
{
    return (a + b - 1) / b;
}

__aicore__ inline uint32_t AUp(uint32_t a, uint32_t b)
{
    return ((a + b - 1) / b) * b;
}

__aicore__ inline uint32_t MinU(uint32_t a, uint32_t b)
{
    return (a < b) ? a : b;
}

__aicore__ inline uint32_t CurLen(uint32_t total, uint32_t off, uint32_t chunk)
{
    uint32_t rest = total - off;
    return (rest < chunk) ? rest : chunk;
}

struct QmmSlice {
    int32_t offA;
    int32_t offB;
    int32_t offC;
    uint32_t row0;
    uint32_t col0;
};

__aicore__ inline QmmSlice LocateBlock(int32_t coreIdx, const AscendC::tiling::TCubeTiling &t)
{
    uint32_t cols = CDiv((uint32_t)t.M, (uint32_t)t.singleCoreM);
    uint32_t r = (uint32_t)coreIdx % cols;
    uint32_t c = (uint32_t)coreIdx / cols;
    uint32_t m0 = r * (uint32_t)t.singleCoreM;
    uint32_t n0 = c * (uint32_t)t.singleCoreN;

    QmmSlice s;
    s.row0 = m0;
    s.col0 = n0;
    s.offA = (int32_t)(m0 * (uint32_t)t.Ka);
    s.offB = (int32_t)(n0 * AUp((uint32_t)t.Kb, 16));
    s.offC = (int32_t)(m0 * (uint32_t)t.N + n0);
    return s;
}

// ================= Host 侧 Tiling =================
static bool MakeQmmTile(int64_t M, int64_t N, int64_t K, int32_t isPertoken,
                        int64_t availableCoreNum, QmmTile &td)
{
    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (plat == nullptr) {
        return false;
    }

    uint32_t aicNum = (uint32_t)plat->GetCoreNumAic();
    uint32_t useCoreNum = (availableCoreNum > 0 && availableCoreNum < (int64_t)aicNum)
                              ? (uint32_t)availableCoreNum
                              : aicNum;

    matmul_tiling::MultiCoreMatmulTiling cubeTiling(*plat);
    cubeTiling.SetDim((int32_t)useCoreNum);
    cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_INT8);
    cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::NZ,
                        matmul_tiling::DataType::DT_INT8);
    cubeTiling.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_INT32);
    cubeTiling.SetShape((int32_t)M, (int32_t)N, (int32_t)K);
    cubeTiling.SetOrgShape((int32_t)M, (int32_t)N, (int32_t)K);

    // 小 M(单 token/小批量): M 方向不切分(对齐到 16), 所有 core 沿 N 切分,
    // 避免 B 矩阵(x2)被多个 M 块重复搬移
    if (M <= 64) {
        cubeTiling.SetFixSplit((int32_t)((M + 15) / 16 * 16), -1, -1);
    }

    cubeTiling.SetBias(false);
    cubeTiling.SetBufferSpace(-1, -1, -1);

    if (cubeTiling.GetTiling(td.cube) == -1) {
        return false;
    }

    if ((int64_t)td.cube.singleCoreM > M) {
        td.cube.singleCoreM = (int32_t)M;
    }
    if ((int64_t)td.cube.singleCoreN > N) {
        td.cube.singleCoreN = (int32_t)N;
    }
    td.cube.singleCoreN = ((td.cube.singleCoreN + 31) / 32) * 32;

    td.deq = (uint32_t)isPertoken;
    td.wsSize = (uint32_t)(M * N * sizeof(int32_t));
    return true;
}

// ================= INT32 路径 =================
class Int8MatmulKernel {
public:
    __aicore__ inline Int8MatmulKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y,
                                GM_ADDR workSpace, const QmmTile *__restrict td, AscendC::TPipe *pipe);
    __aicore__ inline void Run();

private:
    using MatA = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>;
    using MatB = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>;
    using MatC = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;

    AscendC::MatmulImpl<MatA, MatB, MatC> mm;
    AscendC::GlobalTensor<int8_t> gmA;
    AscendC::GlobalTensor<int8_t> gmB;
    AscendC::GlobalTensor<int32_t> gmC;
    AscendC::tiling::TCubeTiling tiling;
    uint32_t row0 = 0;
    uint32_t col0 = 0;
};

__aicore__ inline void Int8MatmulKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y,
    GM_ADDR workSpace, const QmmTile *__restrict td, AscendC::TPipe *pipe)
{
    this->tiling = td->cube;

    int32_t coreIdx = (int32_t)AscendC::GetBlockIdx() / (int32_t)AscendC::GetTaskRatio();
    QmmSlice s = LocateBlock(coreIdx, tiling);
    row0 = s.row0;
    col0 = s.col0;

    gmA.SetGlobalBuffer((__gm__ int8_t *)x1, tiling.M * tiling.Ka);
    gmB.SetGlobalBuffer((__gm__ int8_t *)x2, tiling.Kb * tiling.N);
    gmC.SetGlobalBuffer((__gm__ int32_t *)y, tiling.M * tiling.N);
    gmA = gmA[s.offA];
    gmB = gmB[s.offB];
    gmC = gmC[s.offC];

    if ASCEND_IS_AIC {
        mm.SetSubBlockIdx(0);
        mm.Init(&this->tiling, pipe);
    }
}

__aicore__ inline void Int8MatmulKernel::Run()
{
    if ASCEND_IS_AIV {
        return;
    }
    uint32_t m = CurLen((uint32_t)tiling.M, row0, (uint32_t)tiling.singleCoreM);
    uint32_t n = CurLen((uint32_t)tiling.N, col0, (uint32_t)tiling.singleCoreN);
    mm.SetSingleShape((int32_t)m, (int32_t)n, (int32_t)tiling.singleCoreK);
    mm.SetTensorA(gmA);
    mm.SetTensorB(gmB);
    mm.IterateAll(gmC);
    mm.End();
}

// ================= BF16 路径(Cube + Vector 反量化) =================
class DequantMatmulKernel {
public:
    __aicore__ inline DequantMatmulKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
                                GM_ADDR workSpace, const QmmTile *__restrict td, AscendC::TPipe *pipe);
    __aicore__ inline void Run();

private:
    using MatA = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>;
    using MatB = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>;
    using MatC = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;

    __aicore__ inline void DoDequant();

    AscendC::MatmulImpl<MatA, MatB, MatC, MatC, CFG_MDL> mm;
    AscendC::GlobalTensor<int8_t> gmA;
    AscendC::GlobalTensor<int8_t> gmB;
    AscendC::GlobalTensor<int32_t> gmWs;
    AscendC::GlobalTensor<float> gmScale;
    AscendC::GlobalTensor<float> gmPtk;
    AscendC::GlobalTensor<bfloat16_t> gmY;
    AscendC::tiling::TCubeTiling tiling;
    uint32_t row0 = 0;
    uint32_t col0 = 0;

    AscendC::TPipe *pipe_ = nullptr;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> qScale;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> qPtk;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> qInt;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> qOut;
    AscendC::TBuf<> bufF32;
};

__aicore__ inline void DequantMatmulKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
    GM_ADDR workSpace, const QmmTile *__restrict td, AscendC::TPipe *pipe)
{
    this->tiling = td->cube;
    this->pipe_ = pipe;

    int32_t coreIdx = (int32_t)AscendC::GetBlockIdx() / (int32_t)AscendC::GetTaskRatio();
    QmmSlice s = LocateBlock(coreIdx, tiling);
    row0 = s.row0;
    col0 = s.col0;

    gmA.SetGlobalBuffer((__gm__ int8_t *)x1, tiling.M * tiling.Ka);
    gmB.SetGlobalBuffer((__gm__ int8_t *)x2, tiling.Kb * tiling.N);
    gmWs.SetGlobalBuffer((__gm__ int32_t *)workSpace, tiling.M * tiling.N);
    gmScale.SetGlobalBuffer((__gm__ float *)scale, tiling.N);
    gmPtk.SetGlobalBuffer((__gm__ float *)pertokenScale, tiling.M);
    gmY.SetGlobalBuffer((__gm__ bfloat16_t *)y, tiling.M * tiling.N);
    gmA = gmA[s.offA];
    gmB = gmB[s.offB];
    gmWs = gmWs[s.offC];
    gmY = gmY[s.offC];

    mm.SetSubBlockIdx(0);
    mm.Init(&this->tiling, pipe);

    if ASCEND_IS_AIV {
        uint32_t n8 = AUp((uint32_t)tiling.singleCoreN, 8);
        uint32_t n16 = AUp((uint32_t)tiling.singleCoreN, 16);
        pipe_->InitBuffer(qScale, 1, n8 * sizeof(float));
        pipe_->InitBuffer(qPtk, 1, AUp((uint32_t)tiling.singleCoreM, 8) * sizeof(float));
        pipe_->InitBuffer(qInt, 1, n8 * sizeof(int32_t));
        pipe_->InitBuffer(qOut, 1, n16 * sizeof(bfloat16_t));
        pipe_->InitBuffer(bufF32, n8 * sizeof(float));
    }
}

__aicore__ inline void DequantMatmulKernel::DoDequant()
{
    uint32_t m = CurLen((uint32_t)tiling.M, row0, (uint32_t)tiling.singleCoreM);
    uint32_t n = CurLen((uint32_t)tiling.N, col0, (uint32_t)tiling.singleCoreN);
    uint32_t n8 = AUp(n, 8);

    // per-channel scale(长度 n)
    AscendC::LocalTensor<float> sL = qScale.AllocTensor<float>();
    AscendC::DataCopyExtParams sExt(1, (uint32_t)(n * sizeof(float)), 0, 0, 0);
    AscendC::DataCopyPadExtParams<float> sPad;
    AscendC::DataCopyPad(sL, gmScale[col0], sExt, sPad);
    qScale.EnQue(sL);
    sL = qScale.DeQue<float>();

    // per-token scale(长度 m)
    AscendC::LocalTensor<float> pL = qPtk.AllocTensor<float>();
    AscendC::DataCopyExtParams pExt(1, (uint32_t)(m * sizeof(float)), 0, 0, 0);
    AscendC::DataCopyPadExtParams<float> pPad;
    AscendC::DataCopyPad(pL, gmPtk[row0], pExt, pPad);
    qPtk.EnQue(pL);
    pL = qPtk.DeQue<float>();

    AscendC::LocalTensor<float> fL = bufF32.Get<float>(n8);

    // 循环外复用搬移参数
    AscendC::DataCopyExtParams iExt(1, (uint32_t)(n * sizeof(int32_t)), 0, 0, 0);
    AscendC::DataCopyPadExtParams<int32_t> iPad;
    AscendC::DataCopyExtParams oExt(1, (uint32_t)(n * sizeof(bfloat16_t)), 0, 0, 0);

    // row 步进累加, 避免每行 i*N 乘法
    uint32_t row = 0;
    for (uint32_t i = 0; i < m; ++i) {
        AscendC::LocalTensor<int32_t> iL = qInt.AllocTensor<int32_t>();
        AscendC::DataCopyPad(iL, gmWs[row], iExt, iPad);
        qInt.EnQue(iL);
        iL = qInt.DeQue<int32_t>();

        // INT32 -> FP32 -> *perChannel -> *perToken -> BF16
        AscendC::Cast(fL, iL, AscendC::RoundMode::CAST_NONE, n8);
        AscendC::Mul(fL, fL, sL, n8);
        AscendC::Muls(fL, fL, pL.GetValue(i), n8);

        AscendC::LocalTensor<bfloat16_t> bL = qOut.AllocTensor<bfloat16_t>();
        AscendC::Cast(bL, fL, AscendC::RoundMode::CAST_RINT, n8);
        qOut.EnQue(bL);
        bL = qOut.DeQue<bfloat16_t>();
        AscendC::DataCopyPad(gmY[row], bL, oExt);
        qOut.FreeTensor(bL);
        qInt.FreeTensor(iL);

        row += (uint32_t)tiling.N;
    }

    qScale.FreeTensor(sL);
    qPtk.FreeTensor(pL);
}

__aicore__ inline void DequantMatmulKernel::Run()
{
    if ASCEND_IS_AIC {
        uint32_t m = CurLen((uint32_t)tiling.M, row0, (uint32_t)tiling.singleCoreM);
        uint32_t n = CurLen((uint32_t)tiling.N, col0, (uint32_t)tiling.singleCoreN);
        mm.SetSingleShape((int32_t)m, (int32_t)n, (int32_t)tiling.singleCoreK);
        mm.SetTensorA(gmA);
        mm.SetTensorB(gmB);
        mm.IterateAll(gmWs);
        AscendC::DataSyncBarrier<AscendC::MemDsbT::DDR>();
        mm.End();
        AscendC::CrossCoreSetFlag<2, PIPE_FIX>(4);
    } else {
        AscendC::CrossCoreWaitFlag(4);
        AscendC::DataSyncBarrier<AscendC::MemDsbT::DDR>();
        DoDequant();
    }
}

// ================= Kernel 入口 =================
extern "C" __global__ __mix__(1, 2) void qmm_entry(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale,
    GM_ADDR y, GM_ADDR workspace,
    __gm__ uint8_t *__kfc_workspace__ kfc,
    QmmTile td)
{
    if (td.deq == 0) {
        AscendC::TPipe pipe;
        Int8MatmulKernel op;
        op.Init(x1, x2, scale, y, workspace, &td, &pipe);
        op.Run();
        pipe.Destroy();
        return;
    }

    if (workspace == nullptr) {
        return;
    }
    AscendC::TPipe pipe;
    DequantMatmulKernel op;
    op.Init(x1, x2, scale, pertokenScale, y, workspace, &td, &pipe);
    op.Run();
    pipe.Destroy();
}

// ================= Host 入口 =================
extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR scale, const TensorGroupInfo& info_scale,
                           GM_ADDR pertoken_scale, const TensorGroupInfo& info_pertoken_scale,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream)
{
    const TensorInfo& x1t = info_x1.tensors[0];
    const TensorInfo& x2t = info_x2.tensors[0];
    int64_t M = x1t.shape[0];
    int64_t K = x1t.shape[1];
    int64_t N = x2t.shape[1];
    int32_t isPertoken = (info_pertoken_scale.numTensors > 0 && pertoken_scale != nullptr) ? 1 : 0;

    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (plat == nullptr) {
        return;
    }

    QmmTile td;
    if (!MakeQmmTile(M, N, K, isPertoken, availableCoreNum, td)) {
        return;
    }

    uint32_t numBlocks = (uint32_t)td.cube.usedCoreNum;
    if (numBlocks < 1) {
        numBlocks = 1;
    }

    size_t sysWs = (size_t)plat->GetLibApiWorkSpaceSize();
    void *kfc = nullptr;
    if (sysWs > 0) {
        if (aclrtMalloc(&kfc, sysWs, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
            return;
        }
    }

    void *userWs = nullptr;
    if (isPertoken) {
        if (aclrtMalloc(&userWs, (size_t)td.wsSize, ACL_MEM_MALLOC_HUGE_FIRST) != 0) {
            if (kfc != nullptr) {
                aclrtFree(kfc);
            }
            return;
        }
    }

    GM_ADDR ptkPtr = isPertoken ? pertoken_scale : nullptr;

    qmm_entry<<<numBlocks, nullptr, stream>>>(
        x1, x2, scale, ptkPtr, y, (GM_ADDR)userWs,
        (__gm__ uint8_t *)kfc, td);

    aclrtSynchronizeStream(stream);

    if (kfc != nullptr) {
        aclrtFree(kfc);
    }
    if (userWs != nullptr) {
        aclrtFree(userWs);
    }
}
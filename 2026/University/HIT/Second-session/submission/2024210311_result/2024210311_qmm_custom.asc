#include "acl/acl_base.h"
#include "acl/acl_prof.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <torch/extension.h>

// ===================== Tiling 数据与计算 =====================

#pragma pack(push, 8)
struct alignas(8) QmmTilingData {
  TCubeTiling cube;   // Matmul 库标准 Tiling 结构, 含 baseM/N/K、singleCoreM/N/K、usedCoreNum
  uint32_t dequant;   // 0: 输出 INT32; 1: 反量化后输出 BF16
  uint32_t wsBytes;   // GM workspace 字节数, dequant=1 时存放 INT32 中间结果
};
#pragma pack(pop)

// 生成 QMM 的 tiling 参数
static QmmTilingData MakeQmmTiling(uint32_t dequant, uint32_t M, uint32_t N,
                                   uint32_t K) {
  QmmTilingData td;
  auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
  TORCH_CHECK(plat != nullptr, "Get platform info failed.");

  uint32_t aicNum = static_cast<uint32_t>(plat->GetCoreNumAic());

  matmul_tiling::MultiCoreMatmulTiling cubeTiling(*plat);
  cubeTiling.SetDim(static_cast<int32_t>(aicNum));

  cubeTiling.SetAType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT8);
  cubeTiling.SetBType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::NZ, // 权重为 FRACTAL_NZ
                      matmul_tiling::DataType::DT_INT8);
  cubeTiling.SetCType(matmul_tiling::TPosition::GM,
                      matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT32);

  cubeTiling.SetShape(static_cast<int32_t>(M), static_cast<int32_t>(N),
                      static_cast<int32_t>(K));
  cubeTiling.SetOrgShape(static_cast<int32_t>(M), static_cast<int32_t>(N),
                         static_cast<int32_t>(K));

  cubeTiling.SetBias(false);
  cubeTiling.SetBufferSpace(-1, -1, -1);

  TORCH_CHECK(cubeTiling.GetTiling(td.cube) != -1,
              "MakeQmmTiling failed for M=", M, ", N=", N, ", K=", K);

  if (M <= 64) {
    // 小批量/单 token: 手动接管切分, M 方向不切分, 所有 core 仅沿 N 均分。
    // 目的: 让 B 矩阵(x2)只被各 core 搬一次, 避免 M 方向切分导致的重复搬移。
    uint32_t nPerCore = (N + aicNum - 1) / aicNum;
    uint32_t sn = ((nPerCore + 31) / 32) * 32;
    if (sn < 32) {
      sn = 32;
    }
    td.cube.singleCoreM = M;
    td.cube.singleCoreN = sn;
    td.cube.usedCoreNum = (N + sn - 1) / sn;
  } else {
    // 常规: 沿用库的切分, 仅收缩分块避免越界
    if (td.cube.singleCoreM > M) {
      td.cube.singleCoreM = M;
    }
    if (td.cube.singleCoreN > N) {
      td.cube.singleCoreN = N;
    }
    // B 是 FRACTAL_NZ(n0=32), 列方向分块必须对齐到 32
    td.cube.singleCoreN = ((td.cube.singleCoreN + 31) / 32) * 32;
  }

  td.dequant = dequant;
  td.wsBytes = static_cast<uint32_t>(M * N * sizeof(int32_t));
  return td;
}

// ===================== 通用小工具 =====================

// 向上取整除法
__aicore__ inline uint32_t CeilDiv(uint32_t a, uint32_t b)
{
    return a / b + ((a % b) != 0 ? 1u : 0u);
}

// 向上对齐到 b 的整数倍
__aicore__ inline uint32_t AlignUp(uint32_t a, uint32_t b)
{
    return ((a + b - 1) / b) * b;
}

// 每个 core 在 A/B/C 中的偏移
struct QmmOffsets {
    int32_t offA;
    int32_t offB;
    int32_t offC;
};

__aicore__ inline QmmOffsets GetCoreOffsets(int32_t coreIdx,
                                            const AscendC::tiling::TCubeTiling &t)
{
    uint32_t cols = CeilDiv(t.M, t.singleCoreM);
    uint32_t rowCore = static_cast<uint32_t>(coreIdx) % cols;
    uint32_t colCore = static_cast<uint32_t>(coreIdx) / cols;
    uint32_t m0 = rowCore * t.singleCoreM;
    uint32_t n0 = colCore * t.singleCoreN;

    QmmOffsets off;
    off.offA = static_cast<int32_t>(m0 * t.Ka);                        // A: [M, K] ND 行主序
    off.offB = static_cast<int32_t>(n0 * AlignUp(t.Kb, 16));           // B: [K, N] FRACTAL_NZ
    off.offC = static_cast<int32_t>(m0 * t.N + n0);                    // C: [M, N] ND 行主序
    return off;
}

// ===================== Path 1: INT32 输出 =====================

class QmmInt32Kernel {
public:
    __aicore__ inline QmmInt32Kernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y,
                                GM_ADDR workSpace, const QmmTilingData *__restrict td,
                                AscendC::TPipe *pipe);
    __aicore__ inline void Run();

private:
    using MatA = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>;
    using MatB = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>;
    using MatC = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;

    AscendC::MatmulImpl<MatA, MatB, MatC> mm;
    AscendC::GlobalTensor<int8_t> gmA;
    AscendC::GlobalTensor<int8_t> gmB;
    AscendC::GlobalTensor<int32_t> gmC;
    AscendC::tiling::TCubeTiling tiling;
    uint32_t rowOff = 0;
    uint32_t colOff = 0;
};

__aicore__ inline void QmmInt32Kernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y,
    GM_ADDR workSpace, const QmmTilingData *__restrict td,
    AscendC::TPipe *pipe)
{
    this->tiling = td->cube;

    int32_t coreIdx = static_cast<int32_t>(AscendC::GetBlockIdx());
    coreIdx /= static_cast<int32_t>(AscendC::GetTaskRatio());

    QmmOffsets off = GetCoreOffsets(coreIdx, tiling);
    uint32_t cols = CeilDiv(tiling.M, tiling.singleCoreM);
    rowOff = (static_cast<uint32_t>(coreIdx) % cols) * tiling.singleCoreM;
    colOff = (static_cast<uint32_t>(coreIdx) / cols) * tiling.singleCoreN;

    gmA.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1), tiling.M * tiling.Ka);
    gmB.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2), tiling.Kb * tiling.N);
    gmC.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y), tiling.M * tiling.N);
    gmA = gmA[off.offA];
    gmB = gmB[off.offB];
    gmC = gmC[off.offC];

    if ASCEND_IS_AIC {
        mm.SetSubBlockIdx(0);
        mm.Init(&this->tiling, pipe);
    }
}

__aicore__ inline void QmmInt32Kernel::Run()
{
    if ASCEND_IS_AIV {
        return;
    }

    uint32_t m = (tiling.M - rowOff) < tiling.singleCoreM ? (tiling.M - rowOff) : tiling.singleCoreM;
    uint32_t n = (tiling.N - colOff) < tiling.singleCoreN ? (tiling.N - colOff) : tiling.singleCoreN;
    mm.SetSingleShape(static_cast<int32_t>(m), static_cast<int32_t>(n),
                      static_cast<int32_t>(tiling.singleCoreK));
    mm.SetTensorA(gmA);
    mm.SetTensorB(gmB);
    mm.IterateAll(gmC);
    mm.End();
}

// ===================== Path 2: 反量化后 BF16 输出 =====================

class QmmBf16Kernel {
public:
    __aicore__ inline QmmBf16Kernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                                GM_ADDR pertokenScale, GM_ADDR y, GM_ADDR workSpace,
                                const QmmTilingData *__restrict td, AscendC::TPipe *pipe);
    __aicore__ inline void Run();
    __aicore__ inline void DoDequant();

private:
    using MatA = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>;
    using MatB = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>;
    using MatC = AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;

    AscendC::MatmulImpl<MatA, MatB, MatC, MatC, CFG_MDL> mm;
    AscendC::GlobalTensor<int8_t> gmA;
    AscendC::GlobalTensor<int8_t> gmB;
    AscendC::GlobalTensor<int32_t> gmWs;
    AscendC::GlobalTensor<float> gmScale;
    AscendC::GlobalTensor<float> gmRowScale;
    AscendC::GlobalTensor<bfloat16_t> gmOut;
    AscendC::tiling::TCubeTiling tiling;
    uint32_t rowOff = 0;
    uint32_t colOff = 0;

    AscendC::TPipe *pipe_ = nullptr;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> qScale;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> qRowScale;
    AscendC::TQue<AscendC::QuePosition::VECIN, 1> qInt;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> qOut;
    AscendC::TBuf<> bufFp32;
    uint32_t rowsPerBatch_ = 1;   // 反量化每批处理的行数
};

__aicore__ inline void QmmBf16Kernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
    GM_ADDR workSpace, const QmmTilingData *__restrict td, AscendC::TPipe *pipe)
{
    this->tiling = td->cube;
    this->pipe_ = pipe;

    int32_t coreIdx = static_cast<int32_t>(AscendC::GetBlockIdx());
    coreIdx /= static_cast<int32_t>(AscendC::GetTaskRatio());

    QmmOffsets off = GetCoreOffsets(coreIdx, tiling);
    uint32_t cols = CeilDiv(tiling.M, tiling.singleCoreM);
    rowOff = (static_cast<uint32_t>(coreIdx) % cols) * tiling.singleCoreM;
    colOff = (static_cast<uint32_t>(coreIdx) / cols) * tiling.singleCoreN;

    gmA.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1), tiling.M * tiling.Ka);
    gmB.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2), tiling.Kb * tiling.N);
    gmWs.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(workSpace), tiling.M * tiling.N);
    gmScale.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), tiling.N);
    gmRowScale.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(pertokenScale), tiling.M);
    gmOut.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y), tiling.M * tiling.N);
    gmA = gmA[off.offA];
    gmB = gmB[off.offB];
    gmWs = gmWs[off.offC];
    gmOut = gmOut[off.offC];

    mm.SetSubBlockIdx(0);
    mm.Init(&this->tiling, pipe);

    if ASCEND_IS_AIV {
        uint32_t n8 = AlignUp(tiling.singleCoreN, 8);
        uint32_t n16 = AlignUp(tiling.singleCoreN, 16);

        // 每批行数: int32 与 fp32 各占 R*n8*4, 按 32KB UB 预算反推
        uint32_t R = 32768 / (n8 * 8);
        if (R < 1) R = 1;
        if (R > 255) R = 255;
        rowsPerBatch_ = R;

        pipe_->InitBuffer(qScale, 1, n8 * sizeof(float));
        pipe_->InitBuffer(qRowScale, 1, AlignUp(tiling.singleCoreM, 8) * sizeof(float));
        pipe_->InitBuffer(qInt, 1, static_cast<uint64_t>(R) * n8 * sizeof(int32_t));
        pipe_->InitBuffer(qOut, 1, n16 * sizeof(bfloat16_t));
        pipe_->InitBuffer(bufFp32, static_cast<uint64_t>(R) * n8 * sizeof(float));
    }
}

__aicore__ inline void QmmBf16Kernel::DoDequant()
{
    uint32_t m = (tiling.M - rowOff) < tiling.singleCoreM ? (tiling.M - rowOff) : tiling.singleCoreM;
    uint32_t n = (tiling.N - colOff) < tiling.singleCoreN ? (tiling.N - colOff) : tiling.singleCoreN;
    uint32_t n8 = AlignUp(n, 8);
    uint32_t R = rowsPerBatch_;

    // 一次性加载 per-channel scale (列方向)
    AscendC::LocalTensor<float> scaleL = qScale.AllocTensor<float>();
    AscendC::DataCopyExtParams sp(1, static_cast<uint32_t>(n * sizeof(float)), 0, 0, 0);
    AscendC::DataCopyPadExtParams<float> spPad(true, 0, static_cast<uint8_t>(n8 - n), 0.0f);
    AscendC::DataCopyPad(scaleL, gmScale[colOff], sp, spPad);
    qScale.EnQue(scaleL);
    scaleL = qScale.DeQue<float>();

    // 一次性加载 per-token scale (行方向)
    uint32_t m8 = AlignUp(m, 8);
    AscendC::LocalTensor<float> rowL = qRowScale.AllocTensor<float>();
    AscendC::DataCopyExtParams rp(1, static_cast<uint32_t>(m * sizeof(float)), 0, 0, 0);
    AscendC::DataCopyPadExtParams<float> rpPad(true, 0, static_cast<uint8_t>(m8 - m), 0.0f);
    AscendC::DataCopyPad(rowL, gmRowScale[rowOff], rp, rpPad);
    qRowScale.EnQue(rowL);
    rowL = qRowScale.DeQue<float>();

    AscendC::LocalTensor<float> fpL = bufFp32.Get<float>(R * n8);

    AscendC::DataCopyExtParams ip(1, static_cast<uint32_t>(n * sizeof(int32_t)), 0, 0, 0);
    AscendC::DataCopyPadExtParams<int32_t> ipPad(true, 0, static_cast<uint8_t>(n8 - n), 0);
    AscendC::DataCopyExtParams op(1, static_cast<uint32_t>(n * sizeof(bfloat16_t)), 0, 0, 0);

    uint32_t r0 = 0;
    while (r0 < m) {
        uint32_t Rc = (m - r0 < R) ? (m - r0) : R;

        // (1) 批量搬入 Rc 行 INT32 中间结果, 排成 [Rc, n8]
        AscendC::LocalTensor<int32_t> intL = qInt.AllocTensor<int32_t>();
        for (uint32_t i = 0; i < Rc; ++i) {
            AscendC::DataCopyPad(intL[i * n8], gmWs[(r0 + i) * tiling.N], ip, ipPad);
        }
        qInt.EnQue(intL);
        intL = qInt.DeQue<int32_t>();

        // (2) 一次把 Rc 行 INT32 提升为 FP32
        AscendC::Cast(fpL, intL, AscendC::RoundMode::CAST_NONE, Rc * n8);
        qInt.FreeTensor(intL);

        // (3) 逐行反量化: *perChannel *perToken -> BF16 写出
        for (uint32_t i = 0; i < Rc; ++i) {
            AscendC::Mul(fpL[i * n8], fpL[i * n8], scaleL, n8);
            AscendC::Muls(fpL[i * n8], fpL[i * n8], rowL.GetValue(r0 + i), n8);

            AscendC::LocalTensor<bfloat16_t> bfL = qOut.AllocTensor<bfloat16_t>();
            AscendC::Cast(bfL, fpL[i * n8], AscendC::RoundMode::CAST_RINT, n8);
            qOut.EnQue(bfL);
            bfL = qOut.DeQue<bfloat16_t>();
            AscendC::DataCopyPad(gmOut[(r0 + i) * tiling.N], bfL, op);
            qOut.FreeTensor(bfL);
        }

        r0 += Rc;
    }

    qScale.FreeTensor(scaleL);
    qRowScale.FreeTensor(rowL);
}

__aicore__ inline void QmmBf16Kernel::Run()
{
    if ASCEND_IS_AIC {
        uint32_t m = (tiling.M - rowOff) < tiling.singleCoreM ? (tiling.M - rowOff) : tiling.singleCoreM;
        uint32_t n = (tiling.N - colOff) < tiling.singleCoreN ? (tiling.N - colOff) : tiling.singleCoreN;
        mm.SetSingleShape(static_cast<int32_t>(m), static_cast<int32_t>(n),
                          static_cast<int32_t>(tiling.singleCoreK));
        mm.SetTensorA(gmA);
        mm.SetTensorB(gmB);
        mm.IterateAll(gmWs);
        AscendC::DataSyncBarrier<AscendC::MemDsbT::DDR>();
        mm.End();
        AscendC::CrossCoreSetFlag<2, PIPE_FIX>(4);
    } else {
        AscendC::CrossCoreWaitFlag(4);
        AscendC::DataSyncBarrier<AscendC::MemDsbT::DDR>();
        DoDequant();
    }
}

// ===================== 入口 kernel =====================

__global__ __mix__(1, 2) __aicore__
    void qmm_run_kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                        GM_ADDR pertokenScale, GM_ADDR y, GM_ADDR workSpace,
                        QmmTilingData td) {
  if (workSpace == nullptr) {
    return;
  }
  AscendC::TPipe pipe;

  if (td.dequant == 0) {
    QmmInt32Kernel kernel;
    kernel.Init(x1, x2, scale, y, workSpace, &td, &pipe);
    kernel.Run();
    pipe.Destroy();
  } else {
    QmmBf16Kernel kernel;
    kernel.Init(x1, x2, scale, pertokenScale, y, workSpace, &td, &pipe);
    kernel.Run();
    pipe.Destroy();
  }
}

// ===================== profiling 信息 =====================

#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor {
  uint32_t type;
  uint32_t format;
  uint32_t dataType;
  uint32_t shapeDim;
  uint32_t shape[8];
};

struct aclprofTensorInfo {
  uint64_t opNameId;
  uint64_t opTypeId;
  uint32_t resv;
  uint32_t tensorNum;
  uint32_t kernelType;
  uint32_t blockNums;
  void *stream;
  aclprofTensor *tensors;
};

struct aclprofEventAttributes {
  uint16_t version;
  uint16_t size;
  uint32_t messageType;
  union message {
    aclprofTensorInfo *tensorInfo;
  } message;
};
#endif // ACL_PROF_TENSOR_INFO_DEFINED

#define TENSOR_IN(x)                                                           \
  aclprofTensor {                                                              \
    (uint32_t)0,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::ToAclFormat(static_cast<int64_t>(x.sizes().size()))), \
        static_cast<uint32_t>(ascendc_ops::ToAclDtype(x.scalar_type())),       \
        static_cast<uint32_t>(x.sizes().size()), {                             \
      static_cast<uint32_t>(x.sizes().size() > 0 ? x.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(x.sizes().size() > 1 ? x.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 2 ? x.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 3 ? x.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define TENSOR_OUT(z)                                                          \
  aclprofTensor {                                                              \
    (uint32_t)1,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::ToAclFormat(static_cast<int64_t>(z.sizes().size()))), \
        static_cast<uint32_t>(ascendc_ops::ToAclDtype(z.scalar_type())),       \
        static_cast<uint32_t>(z.sizes().size()), {                             \
      static_cast<uint32_t>(z.sizes().size() > 0 ? z.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(z.sizes().size() > 1 ? z.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 2 ? z.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 3 ? z.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

namespace ascendc_ops {

aclDataType ToAclDtype(at::ScalarType scalarType) {
  switch (scalarType) {
  case at::ScalarType::Float:
    return ACL_FLOAT;
  case at::ScalarType::Int:
    return ACL_INT32;
  case at::ScalarType::BFloat16:
    return ACL_BF16;
  case at::ScalarType::Byte:
    return ACL_UINT8;
  case at::ScalarType::Char:
    return ACL_INT8;
  default:
    TORCH_CHECK(false,
                "Unsupported tensor dtype for profiling report: ", scalarType);
  }
}

aclFormat ToAclFormat(int64_t dimNum) {
  aclFormat format = ACL_FORMAT_ND;
  if (dimNum == 4) {
    format = ACL_FORMAT_FRACTAL_NZ;
  }
  return format;
}

at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2,
                      const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale) {
  auto aclStream = c10_npu::getCurrentNPUStream().stream(true);

  auto M = x1.size(0);
  auto K = x1.size(1);
  auto N = x2.size(1);

  uint32_t dequant =
      pertoken_scale.has_value() && pertoken_scale.value().defined() ? 1 : 0;
  at::ScalarType outDtype =
      dequant ? at::ScalarType::BFloat16 : at::ScalarType::Int;
  at::Tensor y = at::empty({M, N}, x1.options().dtype(outDtype));

  QmmTilingData td = MakeQmmTiling(dequant, M, N, K);
  uint32_t numBlocks = td.cube.usedCoreNum;

  at::Tensor workSpace =
      at::empty({static_cast<int64_t>(td.wsBytes)},
                x1.options().dtype(at::ScalarType::Byte));

  aclprofTensorInfo tensorInfo;
  uint64_t opNameId = aclprofStr2Id("qmm_custom");
  uint64_t opTypeId = aclprofStr2Id("QmmCustom");
  uint8_t *pertokenPtr =
      dequant ? (uint8_t *)(pertoken_scale.value().mutable_data_ptr())
              : nullptr;
  std::vector<aclprofTensor> tensors = {TENSOR_IN(x1), TENSOR_IN(x2),
                                        TENSOR_IN(scale)};
  if (dequant) {
    tensors.push_back(TENSOR_IN(pertoken_scale.value()));
  }
  tensors.push_back(TENSOR_OUT(y));
  tensorInfo = {opNameId, opTypeId,  0,         (uint32_t)tensors.size(),
                0,        numBlocks, aclStream, tensors.data()};

  aclprofEventAttributes attrs = {1, sizeof(aclprofEventAttributes::message), 0,
                                  &tensorInfo};

  aclprofRangePushEx(&attrs);
  qmm_run_kernel<<<numBlocks, 0, aclStream>>>(
      (uint8_t *)(x1.mutable_data_ptr()), (uint8_t *)(x2.mutable_data_ptr()),
      (uint8_t *)(scale.mutable_data_ptr()), pertokenPtr,
      (uint8_t *)(y.mutable_data_ptr()), workSpace.data_ptr<uint8_t>(), td);
  aclprofRangePop();
  return y;
}
} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m) {
  m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? "
        "pertoken_scale=None) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m) {
  m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}
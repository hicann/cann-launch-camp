#include <cmath>
#include "kernel_operator.h"
/*
 * Gelu Kernel — Ascend C Direct Invocation
 * This file is #included — do NOT add main(), #pragma once, or include guards.
 *
 * TensorGroupInfo / TensorInfo (predefined):
 *   struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
 *   struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
 *   dtype: 0=fp32 1=fp16 2=bf16 3=int8 4=int16 5=int32 6=int64 7=uint8 8=uint16 9=uint32 10=uint64 11=bool
 */

using namespace AscendC;

constexpr int32_t BUFFER_NUM = 2;                     // 双缓冲流水线
constexpr uint32_t TILE_LENGTH = 4096;                // 测试点 5 经验最优
constexpr float GELU_INV_SQRT2 = 0.7071067811865476f; // 1 / sqrt(2)

// ---------------------------------------------------------------------------
// GELU(x) = x * 0.5 * (1 + erf(x / sqrt(2)))
// 精确 erf 实现: fp32 直接算; fp16 提升 fp32 计算后 round 回 fp16。
// ---------------------------------------------------------------------------

template <typename T>
class KernelGelu {
public:
    __aicore__ inline KernelGelu() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, uint32_t totalLength, uint32_t alignElems)
    {
        uint32_t blockIdx = GetBlockIdx();
        uint32_t blockNum = GetBlockNum();

        uint32_t alignedTotal = totalLength / alignElems;
        uint32_t remainder = totalLength % alignElems;

        uint32_t chunksPerBlock = alignedTotal / blockNum;
        uint32_t chunksRemain = alignedTotal % blockNum;
        uint32_t myChunks = chunksPerBlock + (blockIdx < chunksRemain ? 1u : 0u);
        uint32_t offsetChunks = blockIdx * chunksPerBlock +
                                (blockIdx < chunksRemain ? blockIdx : chunksRemain);
        uint32_t localOffset = offsetChunks * alignElems;
        this->blockLength = myChunks * alignElems;
        if (blockIdx == blockNum - 1) {
            this->blockLength += remainder;
        }

        if (this->blockLength == 0) {
            return;
        }

        xGm.SetGlobalBuffer((__gm__ T*)x + localOffset, this->blockLength);
        yGm.SetGlobalBuffer((__gm__ T*)y + localOffset, this->blockLength);

        pipe.InitBuffer(inQueueX, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        pipe.InitBuffer(outQueueY, BUFFER_NUM, TILE_LENGTH * sizeof(T));
        InitWork((T*)nullptr);
    }

    __aicore__ inline void Process()
    {
        if (this->blockLength == 0) {
            return;
        }
        uint32_t loopCount = this->blockLength / TILE_LENGTH;
        uint32_t tailLength = this->blockLength % TILE_LENGTH;

        if (loopCount == 0) {
            CopyInTail(0, tailLength);
            ComputeTail(tailLength);
            CopyOutTail(0, tailLength);
            return;
        }

        CopyIn(0);
        for (uint32_t i = 0; i < loopCount; i++) {
            if (i + 1 < loopCount) {
                CopyIn(i + 1);
            }
            Compute(i);
            CopyOut(i);
        }

        if (tailLength > 0) {
            CopyInTail(loopCount, tailLength);
            ComputeTail(tailLength);
            CopyOutTail(loopCount, tailLength);
        }
    }

private:
    __aicore__ inline void InitWork(float*)
    {
        pipe.InitBuffer(tWork, TILE_LENGTH * sizeof(float));
    }

    __aicore__ inline void InitWork(half*)
    {
        pipe.InitBuffer(xWork, TILE_LENGTH * sizeof(float));
        pipe.InitBuffer(tWork, TILE_LENGTH * sizeof(float));
    }

    __aicore__ inline void CopyIn(uint32_t progress)
    {
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        DataCopy(xLocal, xGm[progress * TILE_LENGTH], TILE_LENGTH);
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void Compute(uint32_t progress)
    {
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        ComputeGelu(xLocal, yLocal, TILE_LENGTH);
        outQueueY.EnQue(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOut(uint32_t progress)
    {
        LocalTensor<T> yLocal = outQueueY.DeQue<T>();
        DataCopy(yGm[progress * TILE_LENGTH], yLocal, TILE_LENGTH);
        outQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void CopyInTail(uint32_t tileIdx, uint32_t tailLength)
    {
        const uint32_t alignElems = 32 / sizeof(T);
        uint32_t alignedTail = (tailLength + alignElems - 1) / alignElems * alignElems;
        LocalTensor<T> xLocal = inQueueX.AllocTensor<T>();
        if (tailLength > 0) {
            DataCopy(xLocal, xGm[tileIdx * TILE_LENGTH], tailLength);
        }
        for (uint32_t k = tailLength; k < alignedTail; ++k) {
            xLocal.SetValue(k, (T)0);
        }
        inQueueX.EnQue(xLocal);
    }

    __aicore__ inline void ComputeTail(uint32_t tailLength)
    {
        const uint32_t alignElems = 32 / sizeof(T);
        uint32_t alignedTail = (tailLength + alignElems - 1) / alignElems * alignElems;
        LocalTensor<T> xLocal = inQueueX.DeQue<T>();
        LocalTensor<T> yLocal = outQueueY.AllocTensor<T>();
        ComputeGelu(xLocal, yLocal, alignedTail);
        outQueueY.EnQue(yLocal);
        inQueueX.FreeTensor(xLocal);
    }

    __aicore__ inline void CopyOutTail(uint32_t tileIdx, uint32_t tailLength)
    {
        LocalTensor<T> yLocal = outQueueY.DeQue<T>();
        DataCopy(yGm[tileIdx * TILE_LENGTH], yLocal, tailLength);
        outQueueY.FreeTensor(yLocal);
    }

    __aicore__ inline void ComputeGelu(LocalTensor<float>& x, LocalTensor<float>& y, uint32_t len)
    {
        LocalTensor<float> tf = tWork.Get<float>();
        Muls(tf, x, GELU_INV_SQRT2, len);
        Erf(tf, tf, len);
        Adds(tf, tf, 1.0f, len);
        Muls(tf, tf, 0.5f, len);
        Mul(y, x, tf, len);
    }

    __aicore__ inline void ComputeGelu(LocalTensor<half>& x, LocalTensor<half>& y, uint32_t len)
    {
        LocalTensor<float> xf = xWork.Get<float>();
        LocalTensor<float> tf = tWork.Get<float>();
        Cast(xf, x, RoundMode::CAST_NONE, len);
        Muls(tf, xf, GELU_INV_SQRT2, len);
        Erf(tf, tf, len);
        Adds(tf, tf, 1.0f, len);
        Muls(tf, tf, 0.5f, len);
        Mul(tf, xf, tf, len);
        Cast(y, tf, RoundMode::CAST_ROUND, len);
    }

private:
    TPipe pipe;
    TQue<QuePosition::VECIN, BUFFER_NUM> inQueueX;
    TQue<QuePosition::VECOUT, BUFFER_NUM> outQueueY;
    TBuf<TPosition::VECCALC> xWork;
    TBuf<TPosition::VECCALC> tWork;
    GlobalTensor<T> xGm, yGm;
    uint32_t blockLength;
};

template <typename T>
__global__ __vector__ void gelu_custom(GM_ADDR x, GM_ADDR y, uint32_t totalLength, uint32_t alignElems)
{
    KernelGelu<T> op;
    op.Init(x, y, totalLength, alignElems);
    op.Process();
}

extern "C" void run_kernel(GM_ADDR input_x, const TensorGroupInfo& info_input_x, GM_ADDR output, const TensorGroupInfo& info_output, int64_t availableCoreNum, aclrtStream stream)
{
    int64_t totalLength = 1;
    for (int64_t i = 0; i < info_input_x.tensors[0].numDims; i++) {
        totalLength *= info_input_x.tensors[0].shape[i];
    }
    if (totalLength <= 0) {
        return;
    }
    int32_t dtype = info_input_x.tensors[0].dtype;

    const uint32_t alignElems = (dtype == 0) ? 8u : 16u;   // 32B / sizeof(T)

    // 核数策略:
    // 1) 满核未撞上限(数据量小) -> 满核(数据量小到每核只有 1~2 块, 满核最合适)
    // 2) 满核撞上限且 minChunk 后核数不足一半 -> 满核浪费, 用 minChunk=256 减核
    // 3) 其余 -> 满核
    uint32_t avail = (uint32_t)availableCoreNum;
    uint32_t fullBlocks = (uint32_t)(totalLength / alignElems);
    uint32_t minBlocks = (uint32_t)((totalLength + 255) / 256);

    uint32_t blockNum;
    if (fullBlocks >= avail && minBlocks < avail / 2) {
        blockNum = minBlocks;                 // 满核浪费, 减少核数
    } else {
        blockNum = (fullBlocks < avail) ? fullBlocks : avail;
    }
    if (blockNum < 1) {
        blockNum = 1;
    }

    if (dtype == 0) {          // float32
        gelu_custom<float><<<blockNum, nullptr, stream>>>(
            input_x, output, (uint32_t)totalLength, alignElems);
    } else if (dtype == 1) {   // float16
        gelu_custom<half><<<blockNum, nullptr, stream>>>(
            input_x, output, (uint32_t)totalLength, alignElems);
    }
}
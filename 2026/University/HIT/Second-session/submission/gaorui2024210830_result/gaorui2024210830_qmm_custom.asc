#include "acl/acl_base.h"
#include "acl/acl_prof.h"
#include "kernel_operator.h"
#define ASCENDC_CUBE_ONLY
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <torch/extension.h>

constexpr uint32_t QMM_SYNC_FLAG = 8;

#pragma pack(push, 8)
struct alignas(8) QmmCustomTilingData {
  TCubeTiling cubeTilingData;
  uint32_t isPertoken;
  uint32_t workspaceSize;
  uint32_t systemWorkspaceSize;
};
#pragma pack(pop)

static QmmCustomTilingData CalcQmmTiling(uint32_t isPertoken, uint32_t M,
                                         uint32_t N, uint32_t K) {
  QmmCustomTilingData tilingData = {};
  auto ascendcPlatform =
      platform_ascendc::PlatformAscendCManager::GetInstance();

  matmul_tiling::MultiCoreMatmulTiling tilingApi(*ascendcPlatform);
  tilingApi.SetDim(static_cast<int32_t>(ascendcPlatform->GetCoreNumAic()));
  tilingApi.SetAType(matmul_tiling::TPosition::GM,
                     matmul_tiling::CubeFormat::ND,
                     matmul_tiling::DataType::DT_INT8);
  tilingApi.SetBType(matmul_tiling::TPosition::GM,
                     matmul_tiling::CubeFormat::NZ,
                     matmul_tiling::DataType::DT_INT8);
  tilingApi.SetCType(matmul_tiling::TPosition::GM,
                     matmul_tiling::CubeFormat::ND,
                     matmul_tiling::DataType::DT_INT32);
  tilingApi.SetOrgShape(static_cast<int32_t>(M), static_cast<int32_t>(N),
                        static_cast<int32_t>(K));
  tilingApi.SetShape(static_cast<int32_t>(M), static_cast<int32_t>(N),
                     static_cast<int32_t>(K));
  tilingApi.SetBufferSpace(-1, -1, -1);
  if (tilingApi.GetTiling(tilingData.cubeTilingData) == -1) {
    return tilingData;
  }

  constexpr int32_t NZ_N0 = 32;
  if (tilingData.cubeTilingData.singleCoreN % NZ_N0 != 0) {
    int32_t alignedSingleCoreN =
        (tilingData.cubeTilingData.singleCoreN + NZ_N0 - 1) / NZ_N0 * NZ_N0;
    tilingApi.SetSingleShape(-1, alignedSingleCoreN, -1);
    if (tilingApi.GetTiling(tilingData.cubeTilingData) == -1) {
      return tilingData;
    }
  }

  tilingData.isPertoken = isPertoken;
  uint32_t systemWorkspaceSize = ascendcPlatform->GetLibApiWorkSpaceSize();
  uint32_t int32WorkspaceSize =
      isPertoken ? static_cast<uint32_t>(M) * N * sizeof(int32_t) : 0;
  tilingData.systemWorkspaceSize = systemWorkspaceSize;
  tilingData.workspaceSize = systemWorkspaceSize + int32WorkspaceSize;
  return tilingData;
}

class QmmCubeBasicKernel {
public:
    __aicore__ inline QmmCubeBasicKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y,
                                GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData, AscendC::TPipe *tPipe);

    __aicore__ inline void Process();

private:
    __aicore__ inline void CalcOffset(int32_t blockIdx, int32_t& offsetA,
                                      int32_t& offsetB, int32_t& offsetC);

    AscendC::GlobalTensor<int8_t> aGlobal;
    AscendC::GlobalTensor<int8_t> bGlobal;
    AscendC::GlobalTensor<int32_t> cGlobal;
    AscendC::Matmul<
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>>
        matmulObj;
    TCubeTiling tiling;
    int32_t mCoreIndex = 0;
    int32_t nCoreIndex = 0;
};

__aicore__ inline void QmmCubeBasicKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y,
    GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData, AscendC::TPipe *tPipe)
{
    this->tiling = tilingData->cubeTilingData;
    if ASCEND_IS_AIV {
        return;
    }
    REGIST_MATMUL_OBJ(tPipe, workSpace, matmulObj, &tilingData->cubeTilingData);

    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1), tiling.M * tiling.Ka);
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2), tiling.Kb * tiling.N);
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y), tiling.M * tiling.N);

    int32_t offsetA = 0, offsetB = 0, offsetC = 0;
    CalcOffset(AscendC::GetBlockIdx(), offsetA, offsetB, offsetC);
    aGlobal = aGlobal[offsetA];
    bGlobal = bGlobal[offsetB];
    cGlobal = cGlobal[offsetC];
}

__aicore__ inline void QmmCubeBasicKernel::Process()
{
    if ASCEND_IS_AIV {
        return;
    }
    matmulObj.SetTensorA(aGlobal, false);
    matmulObj.SetTensorB(bGlobal, false);
    matmulObj.IterateAll(cGlobal);
    matmulObj.End();
}

__aicore__ inline void QmmCubeBasicKernel::CalcOffset(
    int32_t blockIdx, int32_t& offsetA, int32_t& offsetB, int32_t& offsetC)
{
    const TCubeTiling& t = this->tiling;
    auto mSingleBlocks = (t.M + t.singleCoreM - 1) / t.singleCoreM;
    mCoreIndex = blockIdx % mSingleBlocks;
    nCoreIndex = blockIdx / mSingleBlocks;

    offsetA = mCoreIndex * t.Ka * t.singleCoreM;
    offsetB = nCoreIndex * t.singleCoreN * t.Kb;
    offsetC = mCoreIndex * t.N * t.singleCoreM + nCoreIndex * t.singleCoreN;

    int32_t tailM = t.M - mCoreIndex * t.singleCoreM;
    tailM = tailM < t.singleCoreM ? tailM : t.singleCoreM;
    int32_t tailN = t.N - nCoreIndex * t.singleCoreN;
    tailN = tailN < t.singleCoreN ? tailN : t.singleCoreN;
    if (tailM < t.singleCoreM || tailN < t.singleCoreN) {
        matmulObj.SetTail(tailM, tailN);
    }
}

class QmmPertokenKernel {
public:
    __aicore__ inline QmmPertokenKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
                                GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData,
                                AscendC::TPipe *tPipe);

    __aicore__ inline void Process();

private:
    __aicore__ inline void CalcOffset(int32_t blockIdx, int32_t& offsetA,
                                      int32_t& offsetB, int32_t& offsetC);

    AscendC::GlobalTensor<int8_t> aGlobal;
    AscendC::GlobalTensor<int8_t> bGlobal;
    AscendC::GlobalTensor<int32_t> cWorkspaceGlobal;
    AscendC::Matmul<
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>,
        AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>>
        matmulObj;
    TCubeTiling tiling;
    int32_t mCoreIndex = 0;
    int32_t nCoreIndex = 0;

    AscendC::TPipe* pipe = nullptr;
    AscendC::GlobalTensor<int32_t> int32Gm;
    AscendC::GlobalTensor<float> scaleGm;
    AscendC::GlobalTensor<float> pertokenGm;
    AscendC::GlobalTensor<bfloat16_t> yGm;
    AscendC::TQue<AscendC::QuePosition::VECIN, 2> inQueue;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 2> outQueue;
    AscendC::TBuf<AscendC::TPosition::VECCALC> scaleBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> pertokenBuf;
    AscendC::TBuf<AscendC::TPosition::VECCALC> calcBuf;
    uint32_t N = 0;
    uint32_t mStart = 0, nStart = 0;
    uint32_t curM = 0, curN = 0;
    uint32_t myMStart = 0, myMCount = 0;
};

__aicore__ inline void QmmPertokenKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
    GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData,
    AscendC::TPipe *tPipe)
{
    this->tiling = tilingData->cubeTilingData;
    this->pipe = tPipe;
    GM_ADDR int32Workspace = workSpace + tilingData->systemWorkspaceSize;

    if ASCEND_IS_AIC {
        REGIST_MATMUL_OBJ(tPipe, workSpace, matmulObj, &tilingData->cubeTilingData);

        aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1), tiling.M * tiling.Ka);
        bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2), tiling.Kb * tiling.N);
        cWorkspaceGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(int32Workspace),
                                         tiling.M * tiling.N);

        int32_t offsetA = 0, offsetB = 0, offsetC = 0;
        CalcOffset(AscendC::GetBlockIdx(), offsetA, offsetB, offsetC);
        aGlobal = aGlobal[offsetA];
        bGlobal = bGlobal[offsetB];
        cWorkspaceGlobal = cWorkspaceGlobal[offsetC];
    } else {
        N = static_cast<uint32_t>(tiling.N);
        int32Gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(int32Workspace),
                                tiling.M * tiling.N);
        scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), tiling.N);
        pertokenGm.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(pertokenScale), tiling.M);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y), tiling.M * tiling.N);

        uint32_t taskRatio = static_cast<uint32_t>(AscendC::GetTaskRatio());
        if (taskRatio == 0) {
            taskRatio = 1;
        }
        uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
        uint32_t coreIdx = blockIdx / taskRatio;
        uint32_t subBlockIdx = blockIdx % taskRatio;

        auto mSingleBlocks = (tiling.M + tiling.singleCoreM - 1) / tiling.singleCoreM;
        uint32_t mCoreIndex = coreIdx % mSingleBlocks;
        uint32_t nCoreIndex = coreIdx / mSingleBlocks;
        mStart = mCoreIndex * static_cast<uint32_t>(tiling.singleCoreM);
        nStart = nCoreIndex * static_cast<uint32_t>(tiling.singleCoreN);
        curM = static_cast<uint32_t>(tiling.M) - mStart;
        curM = curM < static_cast<uint32_t>(tiling.singleCoreM) ? curM
                                                                : static_cast<uint32_t>(tiling.singleCoreM);
        curN = static_cast<uint32_t>(tiling.N) - nStart;
        curN = curN < static_cast<uint32_t>(tiling.singleCoreN) ? curN
                                                                : static_cast<uint32_t>(tiling.singleCoreN);

        uint32_t rowsPerAIV = (curM + taskRatio - 1) / taskRatio;
        uint32_t tmpMStart = mStart + subBlockIdx * rowsPerAIV;
        if (tmpMStart >= mStart + curM) {
            myMCount = 0;
        } else {
            uint32_t end = tmpMStart + rowsPerAIV;
            myMCount = (end <= mStart + curM) ? rowsPerAIV : (mStart + curM - tmpMStart);
        }
        myMStart = tmpMStart;
    }
}

__aicore__ inline void QmmPertokenKernel::Process()
{
    if ASCEND_IS_AIC {
        matmulObj.SetTensorA(aGlobal, false);
        matmulObj.SetTensorB(bGlobal, false);
        matmulObj.IterateAll(cWorkspaceGlobal);
        matmulObj.End();
        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(QMM_SYNC_FLAG);
    } else {
        AscendC::CrossCoreWaitFlag<0x2>(QMM_SYNC_FLAG);
        if (myMCount == 0) {
            return;
        }
        pipe->InitBuffer(inQueue, 2, curN * sizeof(int32_t));
        pipe->InitBuffer(outQueue, 2, curN * sizeof(bfloat16_t));
        pipe->InitBuffer(scaleBuf, curN * sizeof(float));
        pipe->InitBuffer(pertokenBuf, myMCount * sizeof(float));
        pipe->InitBuffer(calcBuf, curN * sizeof(float));

        AscendC::LocalTensor<float> scaleLocal = scaleBuf.Get<float>();
        AscendC::DataCopy(scaleLocal, scaleGm[nStart], curN);

        AscendC::LocalTensor<float> ptLocal = pertokenBuf.Get<float>();
        AscendC::DataCopyExtParams ptParams{1, static_cast<uint32_t>(myMCount * sizeof(float)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<float> ptPadParams{true, 0, 0, 0.0f};
        AscendC::DataCopyPad(ptLocal, pertokenGm[myMStart], ptParams, ptPadParams);

        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        for (uint32_t m = 0; m < myMCount; ++m) {
            AscendC::LocalTensor<int32_t> intLocal = inQueue.AllocTensor<int32_t>();
            AscendC::DataCopy(intLocal,
                              int32Gm[static_cast<int64_t>(myMStart + m) * N + nStart], curN);
            inQueue.EnQue(intLocal);

            AscendC::LocalTensor<int32_t> intLocalIn = inQueue.DeQue<int32_t>();
            AscendC::LocalTensor<float> deqLocal = calcBuf.Get<float>();
            AscendC::Cast<float, int32_t>(deqLocal, intLocalIn, AscendC::RoundMode::CAST_NONE, curN);
            AscendC::Mul(deqLocal, deqLocal, scaleLocal, curN);
            float ptScalar = ptLocal.GetValue(static_cast<int32_t>(m));
            AscendC::Muls(deqLocal, deqLocal, ptScalar, curN);
            AscendC::LocalTensor<bfloat16_t> outLocal =
                outQueue.AllocTensor<bfloat16_t>();
            AscendC::Cast<bfloat16_t, float>(outLocal, deqLocal,
                                                      AscendC::RoundMode::CAST_ROUND, curN);
            outQueue.EnQue(outLocal);
            inQueue.FreeTensor(intLocalIn);

            AscendC::LocalTensor<bfloat16_t> outLocalOut =
                outQueue.DeQue<bfloat16_t>();
            AscendC::DataCopy(yGm[static_cast<int64_t>(myMStart + m) * N + nStart], outLocalOut, curN);
            outQueue.FreeTensor(outLocalOut);
        }
    }
}

__aicore__ inline void QmmPertokenKernel::CalcOffset(
    int32_t blockIdx, int32_t& offsetA, int32_t& offsetB, int32_t& offsetC)
{
    const TCubeTiling& t = this->tiling;
    auto mSingleBlocks = (t.M + t.singleCoreM - 1) / t.singleCoreM;
    mCoreIndex = blockIdx % mSingleBlocks;
    nCoreIndex = blockIdx / mSingleBlocks;

    offsetA = mCoreIndex * t.Ka * t.singleCoreM;
    offsetB = nCoreIndex * t.singleCoreN * t.Kb;
    offsetC = mCoreIndex * t.N * t.singleCoreM + nCoreIndex * t.singleCoreN;

    int32_t tailM = t.M - mCoreIndex * t.singleCoreM;
    tailM = tailM < t.singleCoreM ? tailM : t.singleCoreM;
    int32_t tailN = t.N - nCoreIndex * t.singleCoreN;
    tailN = tailN < t.singleCoreN ? tailN : t.singleCoreN;
    if (tailM < t.singleCoreM || tailN < t.singleCoreN) {
        matmulObj.SetTail(tailM, tailN);
    }
}

__global__ __mix__(1, 2) __aicore__
    void qmm_custom_kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                           GM_ADDR pertoken_scale, GM_ADDR y, GM_ADDR workspace,
                           QmmCustomTilingData tilingData) {
  if (workspace == nullptr) {
    return;
  }
  AscendC::TPipe pipe;

  if (tilingData.isPertoken == 0) {
    QmmCubeBasicKernel kernel;
    kernel.Init(x1, x2, scale, y, workspace, &tilingData, &pipe);
    kernel.Process();
    pipe.Destroy();
  } else {
    QmmPertokenKernel kernel;
    kernel.Init(x1, x2, scale, pertoken_scale, y, workspace, &tilingData,
                &pipe);
    kernel.Process();
    pipe.Destroy();
  }
}

#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor {
  uint32_t type;
  uint32_t format;
  uint32_t dataType;
  uint32_t shapeDim;
  uint32_t shape[8];
};

struct aclprofTensorInfo {
  uint64_t opNameId;
  uint64_t opTypeId;
  uint32_t resv;
  uint32_t tensorNum;
  uint32_t kernelType;
  uint32_t blockNums;
  void *stream;
  aclprofTensor *tensors;
};

struct aclprofEventAttributes {
  uint16_t version;
  uint16_t size;
  uint32_t messageType;
  union message {
    aclprofTensorInfo *tensorInfo;
  } message;
};
#endif

#define INPUT(x)                                                               \
  aclprofTensor {                                                              \
    (uint32_t)0,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(x.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(x.scalar_type())),   \
        static_cast<uint32_t>(x.sizes().size()), {                             \
      static_cast<uint32_t>(x.sizes().size() > 0 ? x.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(x.sizes().size() > 1 ? x.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 2 ? x.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 3 ? x.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define OUTPUT(z)                                                              \
  aclprofTensor {                                                              \
    (uint32_t)1,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(z.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(z.scalar_type())),   \
        static_cast<uint32_t>(z.sizes().size()), {                             \
      static_cast<uint32_t>(z.sizes().size() > 0 ? z.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(z.sizes().size() > 1 ? z.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 2 ? z.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 3 ? z.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define INIT_ACL_PROF_TENSOR_INFO(opName, opType, blockdim, kernelType,        \
                                  tensorInfo, stream, ...)                     \
  uint64_t opNameId = aclprofStr2Id(opName);                                   \
  uint64_t opTypeId = aclprofStr2Id(opType);                                   \
  struct aclprofTensor tensors[] = {__VA_ARGS__};                              \
  tensorInfo = {                                                               \
      opNameId,   opTypeId, 0,      sizeof(tensors) / sizeof(aclprofTensor),   \
      kernelType, blockdim, stream, tensors}

namespace ascendc_ops {

aclDataType GetAclDataType(at::ScalarType scalarType) {
  switch (scalarType) {
  case at::ScalarType::Float:
    return ACL_FLOAT;
  case at::ScalarType::Int:
    return ACL_INT32;
  case at::ScalarType::BFloat16:
    return ACL_BF16;
  case at::ScalarType::Byte:
    return ACL_UINT8;
  case at::ScalarType::Char:
    return ACL_INT8;
  default:
    TORCH_CHECK(false,
                "Unsupported tensor dtype for profiling report: ", scalarType);
  }
}

aclFormat GetFormat(int64_t dimNum) {
  aclFormat format = ACL_FORMAT_ND;
  if (dimNum == 4) {
    format = ACL_FORMAT_FRACTAL_NZ;
  }
  return format;
}

at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2,
                      const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale) {
  auto aclStream = c10_npu::getCurrentNPUStream().stream(true);

  auto M = x1.size(0);
  auto K = x1.size(1);
  auto N = x2.size(1);

  uint32_t isPertoken =
      pertoken_scale.has_value() && pertoken_scale.value().defined() ? 1 : 0;
  at::ScalarType output_dtype =
      isPertoken ? at::ScalarType::BFloat16 : at::ScalarType::Int;
  at::Tensor y = at::empty({M, N}, x1.options().dtype(output_dtype));

  QmmCustomTilingData tilingData = CalcQmmTiling(isPertoken, M, N, K);
  uint32_t numBlocks = tilingData.cubeTilingData.usedCoreNum;

  at::Tensor workspaceTensor =
      at::empty({static_cast<int64_t>(tilingData.workspaceSize)},
                x1.options().dtype(at::ScalarType::Byte));

  aclprofTensorInfo tensorInfo;
  uint64_t opNameId = aclprofStr2Id("qmm_custom");
  uint64_t opTypeId = aclprofStr2Id("QmmCustom");
  uint8_t *pertokenPtr =
      isPertoken ? (uint8_t *)(pertoken_scale.value().mutable_data_ptr())
                 : nullptr;
  std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale)};
  if (isPertoken) {
    tensors.push_back(INPUT(pertoken_scale.value()));
  }
  tensors.push_back(OUTPUT(y));
  tensorInfo = {opNameId, opTypeId,  0,         (uint32_t)tensors.size(),
                0,        numBlocks, aclStream, tensors.data()};

  aclprofEventAttributes attrs = {1, sizeof(aclprofEventAttributes::message), 0,
                                  &tensorInfo};

  aclprofRangePushEx(&attrs);
  qmm_custom_kernel<<<numBlocks, 0, aclStream>>>(
      (uint8_t *)(x1.mutable_data_ptr()), (uint8_t *)(x2.mutable_data_ptr()),
      (uint8_t *)(scale.mutable_data_ptr()), pertokenPtr,
      (uint8_t *)(y.mutable_data_ptr()), workspaceTensor.data_ptr<uint8_t>(),
      tilingData);
  aclprofRangePop();
  return y;
}
} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m) {
  m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? "
        "pertoken_scale=None) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m) {
  m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}

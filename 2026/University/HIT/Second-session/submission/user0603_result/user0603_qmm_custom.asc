#include "acl/acl_base.h"
#include "acl/acl_prof.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <torch/extension.h>

using namespace matmul;

// =====================================================================
// 任务一: 设计 tilingData 结构体并实现 tiling 函数
// =====================================================================
// 设计说明:
// 1. cubeTilingData (TCubeTiling): Matmul 高阶库所需的标准 tiling,
//    包含 baseM/baseN/baseK 分块、singleCoreM/N 多核切分、usedCoreNum 等字段。
// 2. isPertoken: 路径标志。0 -> Path1 纯 Cube, INT32 直出;
//               1 -> Path2 Cube+Vector 流水, UB 内反量化输出 BF16。
// 3. workspaceSize: Matmul 库临时工作空间字节数 (GetLibApiWorkSpaceSize)。
//
// 多核说明: __mix__(1,2) 下每个 block 由 1 个 Cube 核 + 2 个 Vector 核组成,
// Matmul 高阶 API 采用"Vector 核驱动、Cube 核被动执行"的消息模式,
// 因此 SetDim 配置的是驱动的 Vector 核数量(= 2 x block 数),
// GetTiling 返回的 usedCoreNum 亦为驱动核数, host 侧启动 block 数取其一半。
#pragma pack(push, 8)
struct alignas(8) QmmCustomTilingData {
  TCubeTiling cubeTilingData;
  uint32_t isPertoken;
  uint32_t workspaceSize;
};
#pragma pack(pop)

namespace {
constexpr uint32_t ROW_CHUNK = 16; // 反量化时每次处理的行数, 控制 UB 占用
} // namespace

// 计算QmmCustom tiling参数,返回tilingData结构体
static QmmCustomTilingData CalcQmmTiling(uint32_t isPertoken, uint32_t M,
                                         uint32_t N, uint32_t K) {
  QmmCustomTilingData tilingData;
  auto ascendcPlatform =
      platform_ascendc::PlatformAscendCManager::GetInstance();

  // 两条执行路径的矩阵乘 tiling 完全一致(均为 A8W8 -> INT32),
  // 区别仅在 Vector 核拿到 INT32 结果后是直接搬出还是先反量化
  matmul_tiling::MultiCoreMatmulTiling cubeTiling(*ascendcPlatform);
  uint32_t aicNum = ascendcPlatform->GetCoreNumAic();
  // N 方向切分粒度必须 16 对齐(NZ 分形约束): 从满配核数向下找第一个满足 ceil(N/d) 为 16 倍数的核数
  uint32_t dim = aicNum;
  while (dim > 1 && ((N + dim - 1) / dim) % 16 != 0) {
    --dim;
  }
  cubeTiling.SetDim(dim);
  // A: 激活 INT8, ND [M, K]; B: 权重 INT8, FRACTAL_NZ [K, N] (Cube 高效格式);
  // C: INT32, 先落在 Vector 核的 UB 中(VECIN), 由 Vector 完成反量化/搬出
  cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT8);
  cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::NZ,
                      matmul_tiling::DataType::DT_INT8);
  cubeTiling.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND,
                      matmul_tiling::DataType::DT_INT32);
  cubeTiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                         matmul_tiling::DataType::DT_INT32);
  cubeTiling.SetShape(M, N, K);
  cubeTiling.SetOrgShape(M, N, K);
  cubeTiling.SetAlignSplit(16, 128, -1); // 切分对齐: sM 16 对齐, sN 128 对齐(= baseN, 杜绝残缺列 tile)
  // baseM 按 M 自适应(向下不小于16), 避免小 M 时 baseM 与 singleCoreM 冲突;
  // baseN 固定 128, 保证 C tile 与反量化缓冲不超过 UB/L0C 容量
  uint32_t baseM = M < 128 ? ((M + 15) / 16) * 16 : 128;
  cubeTiling.SetFixSplit(baseM, 128, -1);
  cubeTiling.SetBias(false);
  cubeTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM); // M 优先切分
  cubeTiling.SetBufferSpace(-1, -1, -1);                         // L1/L0 由库自动分配
  if (cubeTiling.GetTiling(tilingData.cubeTilingData) == -1) {
    TORCH_CHECK(false, "CalcQmmTiling: GetTiling failed, M=", M, " N=", N, " K=", K);
  }
  int32_t gsM = 0, gsN = 0, gsK = 0;
  cubeTiling.GetSingleShape(gsM, gsN, gsK);
  // usedCoreNum 此时为 Vector 驱动核数; 启动 block 数 = 驱动核数 / 2
  uint32_t drivers = tilingData.cubeTilingData.usedCoreNum;
  tilingData.cubeTilingData.usedCoreNum = (drivers + 1) / 2;
  tilingData.workspaceSize = ascendcPlatform->GetLibApiWorkSpaceSize();
  tilingData.isPertoken = isPertoken;
  return tilingData;
}

// =====================================================================
// Cube+Vector 协作 kernel (任务二与任务三共用执行框架)
// =====================================================================
// 执行模型(与官方样例 03.05 matmul_abs 一致):
//   __mix__(1,2) 的三个子核(Cube 核 + 2 个 Vector 核)执行同一份 Process:
//   Vector 核驱动 while(Iterate) 循环, 每次取一块 baseM x baseN 的 INT32
//   结果到 UB; Cube 核由库内部调度, 被动接收消息完成 MMAD 与 Fixpipe。
//
// 任务二 Path1 (isPertoken=0): INT32 tile 直接从 UB 搬出到 GM。
// 任务三 Path2 (isPertoken=1): 在 UB 内按行块做反量化
//   y[m][n] = int32[m][n] * perChannelScale[n] * perTokenScale[m]
//   Cast(INT32->FP32) -> Mul(perChannelScale) -> Muls(perTokenScale)
//   -> Cast(FP32->BF16) -> 搬出, 与 Cube 计算逐块流水, 无需 GM 中间结果。
class QmmBaseKernel {
public:
    __aicore__ inline QmmBaseKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
                                GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData, AscendC::TPipe *tPipe);

    __aicore__ inline void Process();

private:
    __aicore__ inline void CalcOffset(int32_t blockIdx, int32_t &offsetA, int32_t &offsetB, int32_t &offsetC);
    __aicore__ inline void CopyInt32Tile(AscendC::LocalTensor<int32_t> &cUb, uint32_t count);
    __aicore__ inline void DequantTile(AscendC::LocalTensor<int32_t> &cUb, uint32_t count);
    __aicore__ inline void CopyBf16Tile(uint32_t count);

    AscendC::Matmul<AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>,
                    AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>,
                    AscendC::MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, int32_t>,
                    AscendC::MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>>
        matmulObj_;
    AscendC::GlobalTensor<int8_t> x1Gm_;
    AscendC::GlobalTensor<int8_t> x2Gm_;
    AscendC::GlobalTensor<int32_t> yGmInt32_;   // Path1: INT32 输出
    AscendC::GlobalTensor<bfloat16_t> yGmBf16_; // Path2: BF16 输出
    AscendC::GlobalTensor<float> scaleGm_;
    AscendC::GlobalTensor<float> pertokenGm_;
    AscendC::TQue<AscendC::QuePosition::VECOUT, 1> cQueue_;   // Cube 计算结果 tile
    AscendC::TBuf<AscendC::TPosition::VECCALC> fp32Buf_;      // 反量化 FP32 行块
    AscendC::TQue<AscendC::QuePosition::VECOUT, 2> bf16Queue_; // 反量化 BF16 tile (V->MTE3 队列同步)
    AscendC::TQue<AscendC::QuePosition::VECIN, 2> scaleQueue_; // perChannelScale 分片 (MTE2->V 队列同步)
    QmmCustomTilingData tiling_;
    AscendC::TPipe *tPipe_ = nullptr;
    GM_ADDR workSpace_ = nullptr;
    // 当前驱动核负责的子矩阵原点(用于 scale/pertoken 与越界判断)
    uint32_t mChunkBase_ = 0;
    uint32_t nChunkBase_ = 0;
    uint32_t totalChunks_ = 0;
};

__aicore__ inline void QmmBaseKernel::Init(
    GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
    GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData, AscendC::TPipe *tPipe)
{
    tiling_ = *tilingData;
    tPipe_ = tPipe;
    workSpace_ = workSpace;
    const TCubeTiling &ct = tiling_.cubeTilingData;
    x1Gm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x1), ct.M * ct.Ka);
    x2Gm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(x2), ct.Kb * ct.N);
    if (tiling_.isPertoken) {
        yGmBf16_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t *>(y), ct.M * ct.N);
        scaleGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(scale), ct.N);
        pertokenGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(pertokenScale), ct.M);
    } else {
        yGmInt32_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(y), ct.M * ct.N);
    }

    // 多核分块: M 优先, 与库的 tile 遍历顺序保持一致
    int32_t offsetA = 0, offsetB = 0, offsetC = 0;
    CalcOffset(AscendC::GetBlockIdx(), offsetA, offsetB, offsetC);
    x1Gm_ = x1Gm_[offsetA];
    x2Gm_ = x2Gm_[offsetB];
    if (tiling_.isPertoken) {
        yGmBf16_ = yGmBf16_[offsetC];
        scaleGm_ = scaleGm_[nChunkBase_];
        pertokenGm_ = pertokenGm_[mChunkBase_];
    } else {
        yGmInt32_ = yGmInt32_[offsetC];
    }

    // UB 资源: C tile 一块 + 反量化行块缓冲
    tPipe_->InitBuffer(cQueue_, 1, ct.baseM * ct.baseN * sizeof(int32_t));
    if (tiling_.isPertoken) {
        tPipe_->InitBuffer(fp32Buf_, ROW_CHUNK * ct.baseN * sizeof(float));
        tPipe_->InitBuffer(bf16Queue_, 2, ct.baseM * ct.baseN * sizeof(uint16_t));
        tPipe_->InitBuffer(scaleQueue_, 2, ct.baseN * sizeof(float));
    }
}

__aicore__ inline void QmmBaseKernel::CalcOffset(int32_t blockIdx, int32_t &offsetA,
                                                 int32_t &offsetB, int32_t &offsetC)
{
    const TCubeTiling &ct = tiling_.cubeTilingData;
    uint32_t mSingleBlocks = (ct.M + ct.singleCoreM - 1) / ct.singleCoreM;
    uint32_t mCoreIdx = blockIdx % mSingleBlocks;
    uint32_t nCoreIdx = blockIdx / mSingleBlocks;
    mChunkBase_ = mCoreIdx * ct.singleCoreM;
    nChunkBase_ = nCoreIdx * ct.singleCoreN;
    totalChunks_ = mSingleBlocks * ((ct.N + ct.singleCoreN - 1) / ct.singleCoreN);
    offsetA = mCoreIdx * ct.Ka * ct.singleCoreM;
    offsetB = nCoreIdx * ct.singleCoreN * ct.Kb; // NZ 为 n1 外层布局: 宽 sN 的列条带占 sN*Kb 元素且连续
    offsetC = mCoreIdx * ct.N * ct.singleCoreM + nCoreIdx * ct.singleCoreN;
}

__aicore__ inline void QmmBaseKernel::Process()
{
    const TCubeTiling &ct = tiling_.cubeTilingData;
    // 驱动核数可能多于实际分块数(小形状时), 多余的核直接退出
    if (static_cast<uint32_t>(AscendC::GetBlockIdx()) >= totalChunks_) {
        return;
    }
    // Matmul 库工作空间: 优先系统工作空间(__kfc_workspace__ 区域), 兜底用 host 传入缓冲
    __gm__ uint8_t *mmWs = GetSysWorkSpacePtr() != nullptr ? GetSysWorkSpacePtr() : workSpace_;
    REGIST_MATMUL_OBJ(tPipe_, mmWs, matmulObj_, &ct);
    matmulObj_.SetTensorA(x1Gm_);
    matmulObj_.SetTensorB(x2Gm_, false); // B 为 [K, N] 逻辑布局的 NZ 权重, 不转置

    const uint32_t roundM = (ct.singleCoreM + ct.baseM - 1) / ct.baseM;
    uint32_t count = 0;
    while (matmulObj_.template Iterate<true>()) {
        AscendC::LocalTensor<int32_t> cUb = cQueue_.AllocTensor<int32_t>();
        matmulObj_.template GetTensorC<true>(cUb, false, true);
        if (tiling_.isPertoken) {
            DequantTile(cUb, count);      // Vector 计算: 反量化到 bf16Buf_
        }
        cQueue_.EnQue(cUb);
        cQueue_.DeQue<int32_t>();         // 等待生产者(Vector/Cube)完成, 再发起 MTE3
        if (tiling_.isPertoken) {
            CopyBf16Tile(count);          // MTE3: 从 bf16Buf_ 搬出
        } else {
            CopyInt32Tile(cUb, count);    // MTE3: INT32 tile 直接搬出
        }
        cQueue_.FreeTensor(cUb);
        ++count;
    }
    matmulObj_.End();
}

// 任务二: INT32 tile 直接搬出
__aicore__ inline void QmmBaseKernel::CopyInt32Tile(AscendC::LocalTensor<int32_t> &cUb, uint32_t count)
{
    const TCubeTiling &ct = tiling_.cubeTilingData;
    const uint32_t roundM = (ct.singleCoreM + ct.baseM - 1) / ct.baseM;
    const uint32_t rowTile = count % roundM;
    const uint32_t colTile = count / roundM;
    const uint32_t tileRows = mChunkBase_ + rowTile * ct.baseM;
    const uint32_t tileCols = nChunkBase_ + colTile * ct.baseN;
    const uint32_t validRows = ct.baseM < (ct.M - tileRows) ? ct.baseM : (ct.M - tileRows);
    const uint32_t validCols = ct.baseN < (ct.N - tileCols) ? ct.baseN : (ct.N - tileCols);
    AscendC::DataCopyParams copyParam = {
        static_cast<uint16_t>(validRows),
        static_cast<uint16_t>(validCols * sizeof(int32_t) / AscendC::DEFAULT_C0_SIZE),
        static_cast<uint16_t>((ct.baseN - validCols) * sizeof(int32_t) / AscendC::DEFAULT_C0_SIZE),
        static_cast<uint16_t>((ct.N - validCols) * sizeof(int32_t) / AscendC::DEFAULT_C0_SIZE)};
    AscendC::DataCopy(yGmInt32_[rowTile * ct.baseM * ct.N + colTile * ct.baseN], cUb, copyParam);
}

// 任务三(阶段一): UB 内反量化, 结果写入 bf16Buf_ (纯 Vector 操作)
__aicore__ inline void QmmBaseKernel::DequantTile(AscendC::LocalTensor<int32_t> &cUb, uint32_t count)
{
    const TCubeTiling &ct = tiling_.cubeTilingData;
    const uint32_t roundM = (ct.singleCoreM + ct.baseM - 1) / ct.baseM;
    const uint32_t rowTile = count % roundM;
    const uint32_t colTile = count / roundM;
    const uint32_t tileRows = mChunkBase_ + rowTile * ct.baseM;
    const uint32_t tileCols = nChunkBase_ + colTile * ct.baseN;
    const uint32_t validRows = ct.baseM < (ct.M - tileRows) ? ct.baseM : (ct.M - tileRows);
    const uint32_t validCols = ct.baseN < (ct.N - tileCols) ? ct.baseN : (ct.N - tileCols);

    // 等待上一个 tile 对 fp32/bf16 缓冲的 MTE3 搬出完成, 才能覆写
    AscendC::PipeBarrier<PIPE_MTE3>();
    AscendC::LocalTensor<float> fp32Ub = fp32Buf_.Get<float>();
    AscendC::LocalTensor<bfloat16_t> bf16Ub = bf16Queue_.AllocTensor<bfloat16_t>();
    AscendC::LocalTensor<float> scaleUb = scaleQueue_.AllocTensor<float>();
    // perChannelScale 分片: GM -> UB (MTE2), 经队列同步后再由 V 流水读取
    AscendC::DataCopy(scaleUb, scaleGm_[colTile * ct.baseN], validCols);
    scaleQueue_.EnQue(scaleUb);
    scaleQueue_.DeQue<float>(); // MTE2 搬运完成后再进入 V 计算

    for (uint32_t r = 0; r < validRows; r += ROW_CHUNK) {
        const uint32_t rows = (validRows - r) < ROW_CHUNK ? (validRows - r) : ROW_CHUNK;
        // INT32 -> FP32 (行块连续, 覆盖整行 baseN, 尾列垃圾值不参与搬出)
        AscendC::Cast(fp32Ub, cUb[r * ct.baseN], AscendC::RoundMode::CAST_NONE, rows * ct.baseN);
        for (uint32_t i = 0; i < rows; ++i) {
            const float pt = pertokenGm_.GetValue(rowTile * ct.baseM + r + i);
            AscendC::Mul(fp32Ub[i * ct.baseN], fp32Ub[i * ct.baseN], scaleUb, validCols);
            AscendC::Muls(fp32Ub[i * ct.baseN], fp32Ub[i * ct.baseN], pt, validCols);
        }
        AscendC::Cast(bf16Ub[r * ct.baseN], fp32Ub, AscendC::RoundMode::CAST_RINT, rows * ct.baseN);
    }
    scaleQueue_.FreeTensor(scaleUb);
    bf16Queue_.EnQue(bf16Ub);
}

// 任务三(阶段二): 反量化结果整 tile 搬出 (MTE3, 在 EnQue/DeQue 同步之后)
__aicore__ inline void QmmBaseKernel::CopyBf16Tile(uint32_t count)
{
    const TCubeTiling &ct = tiling_.cubeTilingData;
    const uint32_t roundM = (ct.singleCoreM + ct.baseM - 1) / ct.baseM;
    const uint32_t rowTile = count % roundM;
    const uint32_t colTile = count / roundM;
    const uint32_t tileRows = mChunkBase_ + rowTile * ct.baseM;
    const uint32_t tileCols = nChunkBase_ + colTile * ct.baseN;
    const uint32_t validRows = ct.baseM < (ct.M - tileRows) ? ct.baseM : (ct.M - tileRows);
    const uint32_t validCols = ct.baseN < (ct.N - tileCols) ? ct.baseN : (ct.N - tileCols);
    AscendC::LocalTensor<bfloat16_t> bf16Ub = bf16Queue_.DeQue<bfloat16_t>();
    AscendC::DataCopyParams copyParam = {
        static_cast<uint16_t>(validRows),
        static_cast<uint16_t>(validCols * sizeof(bfloat16_t) / AscendC::DEFAULT_C0_SIZE),
        static_cast<uint16_t>((ct.baseN - validCols) * sizeof(bfloat16_t) / AscendC::DEFAULT_C0_SIZE),
        static_cast<uint16_t>((ct.N - validCols) * sizeof(bfloat16_t) / AscendC::DEFAULT_C0_SIZE)};
    AscendC::DataCopy(yGmBf16_[rowTile * ct.baseM * ct.N + colTile * ct.baseN], bf16Ub, copyParam);
    bf16Queue_.FreeTensor(bf16Ub);
}

__global__ __mix__(1, 2) __aicore__
    void qmm_custom_kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                           GM_ADDR pertoken_scale, GM_ADDR y,
                           __gm__ uint8_t *__kfc_workspace__ workspace,
                           QmmCustomTilingData tilingData) {
  if (workspace == nullptr) {
    return;
  }
  AscendC::TPipe pipe;

  QmmBaseKernel kernel;
  kernel.Init(x1, x2, scale, pertoken_scale, y, workspace, &tilingData, &pipe);
  kernel.Process();
  pipe.Destroy();
}

#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor {
  uint32_t type;     // Tensor类型: 0表示输入, 1表示输出。
  uint32_t format;   // Format类型, 对应aclFormat。
  uint32_t dataType; // 数据类型, 对应aclDataType。
  uint32_t shapeDim; // Shape维度数量, 最大支持8维。
  uint32_t shape[8]; // Shape信息。
};

struct aclprofTensorInfo {
  uint64_t opNameId; // 通过uint64_t aclprofStr2Id(const char *message)转化
  uint64_t opTypeId; // 通过uint64_t aclprofStr2Id(const char *message)转化
  uint32_t resv;
  uint32_t tensorNum;
  uint32_t kernelType;
  uint32_t blockNums;
  void *stream;
  aclprofTensor *tensors;
};

struct aclprofEventAttributes {
  uint16_t version;
  uint16_t size;
  uint32_t messageType;
  union message {
    aclprofTensorInfo *tensorInfo;
  } message;
};
#endif // ACL_PROF_TENSOR_INFO_DEFINED

#define INPUT(x)                                                               \
  aclprofTensor {                                                              \
    (uint32_t)0,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(x.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(x.scalar_type())),   \
        static_cast<uint32_t>(x.sizes().size()), {                             \
      static_cast<uint32_t>(x.sizes().size() > 0 ? x.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(x.sizes().size() > 1 ? x.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 2 ? x.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 3 ? x.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define OUTPUT(z)                                                              \
  aclprofTensor {                                                              \
    (uint32_t)1,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(z.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(z.scalar_type())),   \
        static_cast<uint32_t>(z.sizes().size()), {                             \
      static_cast<uint32_t>(z.sizes().size() > 0 ? z.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(z.sizes().size() > 1 ? z.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 2 ? z.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 3 ? z.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define INIT_ACL_PROF_TENSOR_INFO(opName, opType, blockdim, kernelType,        \
                                  tensorInfo, stream, ...)                     \
  uint64_t opNameId = aclprofStr2Id(opName);                                   \
  uint64_t opTypeId = aclprofStr2Id(opType);                                   \
  struct aclprofTensor tensors[] = {__VA_ARGS__};                              \
  tensorInfo = {                                                               \
      opNameId,   opTypeId, 0,      sizeof(tensors) / sizeof(aclprofTensor),   \
      kernelType, blockdim, stream, tensors}

namespace ascendc_ops {

aclDataType GetAclDataType(at::ScalarType scalarType) {
  switch (scalarType) {
  case at::ScalarType::Float:
    return ACL_FLOAT;
  case at::ScalarType::Int:
    return ACL_INT32;
  case at::ScalarType::BFloat16:
    return ACL_BF16;
  case at::ScalarType::Byte:
    return ACL_UINT8;
  case at::ScalarType::Char:
    return ACL_INT8;
  default:
    TORCH_CHECK(false,
                "Unsupported tensor dtype for profiling report: ", scalarType);
  }
}

aclFormat GetFormat(int64_t dimNum) {
  aclFormat format = ACL_FORMAT_ND;
  if (dimNum == 4) {
    format = ACL_FORMAT_FRACTAL_NZ;
  }
  return format;
}

at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2,
                      const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale) {
  auto aclStream = c10_npu::getCurrentNPUStream().stream(true);

  auto M = x1.size(0);
  auto K = x1.size(1);
  auto N = x2.size(1);

  uint32_t isPertoken =
      pertoken_scale.has_value() && pertoken_scale.value().defined() ? 1 : 0;
  at::ScalarType output_dtype =
      isPertoken ? at::ScalarType::BFloat16 : at::ScalarType::Int;
  at::Tensor y = at::empty({M, N}, x1.options().dtype(output_dtype));

  QmmCustomTilingData tilingData = CalcQmmTiling(isPertoken, M, N, K);
  uint32_t numBlocks = tilingData.cubeTilingData.usedCoreNum;

  at::Tensor workspaceTensor =
      at::empty({static_cast<int64_t>(tilingData.workspaceSize)},
                x1.options().dtype(at::ScalarType::Byte));

  aclprofTensorInfo tensorInfo;
  uint64_t opNameId = aclprofStr2Id("qmm_custom");
  uint64_t opTypeId = aclprofStr2Id("QmmCustom");
  uint8_t *pertokenPtr =
      isPertoken ? (uint8_t *)(pertoken_scale.value().mutable_data_ptr())
                 : nullptr;
  std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale)};
  if (isPertoken) {
    tensors.push_back(INPUT(pertoken_scale.value()));
  }
  tensors.push_back(OUTPUT(y));
  tensorInfo = {opNameId, opTypeId,  0,         (uint32_t)tensors.size(),
                0,        numBlocks, aclStream, tensors.data()};

  aclprofEventAttributes attrs = {1, sizeof(aclprofEventAttributes::message), 0,
                                  &tensorInfo};

  aclprofRangePushEx(&attrs);
  qmm_custom_kernel<<<numBlocks, 0, aclStream>>>(
      (uint8_t *)(x1.mutable_data_ptr()), (uint8_t *)(x2.mutable_data_ptr()),
      (uint8_t *)(scale.mutable_data_ptr()), pertokenPtr,
      (uint8_t *)(y.mutable_data_ptr()), workspaceTensor.data_ptr<uint8_t>(),
      tilingData);
  aclprofRangePop();
  return y;
}
} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m) {
  m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? "
        "pertoken_scale=None) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m) {
  m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}

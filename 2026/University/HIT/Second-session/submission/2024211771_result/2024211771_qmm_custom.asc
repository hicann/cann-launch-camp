%%writefile {QMM_CUSTOM_DIR}/qmm_custom.asc
#include <cstdint>
#include <cmath>

#include "acl/acl.h"
#include "acl/acl_base.h"
#include "acl/acl_prof.h"
#include "kernel_operator.h"
#include "lib/matmul_intf.h"
#include "tiling/platform/platform_ascendc.h"
#include "tiling/tiling_api.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include <torch/extension.h>

using namespace matmul;

struct ASCubeObjConfig {
    static constexpr int8_t enableABShareValue = 0;
    static constexpr int8_t enableMixDualMasterValue = 0;
};

namespace qmmcustom {

constexpr uint64_t KFC_WORKSPACE_SIZE = 32ULL * 1024 * 1024;
constexpr uint32_t PERT_GROUP = 1024;

} // namespace qmmcustom

static __aicore__ inline uint32_t Ceiling(uint32_t a, uint32_t b)
{
    return (a + b - 1) / b;
}

static __aicore__ inline uint32_t MinU(uint32_t a, uint32_t b)
{
    return a < b ? a : b;
}

#pragma pack(push, 8)
struct alignas(8) QmmCustomTilingData {
    AscendC::tiling::TCubeTiling cubeTilingData;
    uint32_t isPertoken;
    uint32_t workspaceSize;
};
#pragma pack(pop)

using AType = MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int8_t>;
using BType = MatmulType<AscendC::TPosition::GM, CubeFormat::NZ, int8_t>;
using CType = MatmulType<AscendC::TPosition::VECIN, CubeFormat::ND, int32_t>;
using BiasType = MatmulType<AscendC::TPosition::GM, CubeFormat::ND, int32_t>;
using QmmMatmul = Matmul<AType, BType, CType, BiasType>;

class QmmKernelBase {
public:
    QmmMatmul mm_;
    AscendC::tiling::TCubeTiling tiling_;

    __aicore__ inline void InitCommon(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale,
                                      GM_ADDR y, GM_ADDR workSpace,
                                      const QmmCustomTilingData* __restrict tilingData,
                                      AscendC::TPipe* pipe)
    {
        pipe_ = pipe;
        tiling_ = tilingData->cubeTilingData;
        const AscendC::tiling::TCubeTiling& t = tiling_;
        isPertoken_ = tilingData->isPertoken;

        const uint32_t blockIdx = static_cast<uint32_t>(AscendC::GetBlockIdx());
        const uint32_t groupIdx = static_cast<uint32_t>(blockIdx / AscendC::GetTaskRatio());
        nSingleBlocks_ = Ceiling(t.N, t.singleCoreN);
        nCoreIdx_ = groupIdx % nSingleBlocks_;
        mCoreIdx_ = groupIdx / nSingleBlocks_;
        mStart_ = mCoreIdx_ * t.singleCoreM;
        mEnd_ = MinU(mStart_ + t.singleCoreM, t.M);
        nStart_ = nCoreIdx_ * t.singleCoreN;
        nEnd_ = MinU(nStart_ + t.singleCoreN, t.N);
        if (mStart_ >= t.M || nStart_ >= t.N) {
            mEnd_ = mStart_;
            nEnd_ = nStart_;
        }

        baseM_ = t.baseM;
        baseN_ = t.baseN;
        singleCoreM_ = t.singleCoreM;
        singleCoreN_ = t.singleCoreN;

        aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x1), (int64_t)t.M * t.Ka);
        aGm_ = aGm_[(int64_t)mCoreIdx_ * t.singleCoreM * t.Ka];

        x2Gm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(x2), (int64_t)t.Kb * t.N);
        x2Gm_ = x2Gm_[(int64_t)((nCoreIdx_ * t.singleCoreN) / 32) * (t.Kb / 16) * 512 +
                      ((nCoreIdx_ * t.singleCoreN) % 32)];

        pipe->InitBuffer(cBuf_, baseM_ * baseN_ * sizeof(int32_t));
        if (isPertoken_) {
            yBf16Gm_.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(y), (int64_t)t.M * t.N);
            scaleGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scale), (int64_t)t.N);
            pertokenGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(pertokenScale), (int64_t)t.M);
            pipe->InitBuffer(fAll_, baseM_ * baseN_ * sizeof(float));
            pipe->InitBuffer(sChunk_, baseN_ * sizeof(float));
            pipe->InitBuffer(bfAll_, baseM_ * baseN_ * sizeof(bfloat16_t));
            pipe->InitBuffer(pertBuf_, qmmcustom::PERT_GROUP * sizeof(float));
        } else {
            yInt32Gm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(y), (int64_t)t.M * t.N);
        }
    }

    __aicore__ inline void Process()
    {
        mm_.SetTensorA(aGm_);
        mm_.SetTensorB(x2Gm_);
        uint32_t computeRound = 0;
        const uint32_t roundN = Ceiling(singleCoreN_, baseN_);
        while (mm_.template Iterate<true>()) {
            AscendC::LocalTensor<int32_t> cLocal = cBuf_.Get<int32_t>();
            mm_.template GetTensorC<true>(cLocal, false, true);
            const uint32_t nIdx = computeRound % roundN;
            const uint32_t mIdx = computeRound / roundN;
            const uint32_t m0 = mStart_ + mIdx * baseM_;
            const uint32_t n0 = nStart_ + nIdx * baseN_;
            const uint32_t rows = MinU(baseM_, tiling_.M - m0);
            if (rows > 0) {
                if (isPertoken_) {
                    DequantTile(cLocal, m0, n0, rows);
                } else {
                    CopyOutInt32(cLocal, m0, n0, rows);
                }
            }
            AscendC::PipeBarrier<PIPE_ALL>();
            ++computeRound;
        }
        mm_.End();
    }

protected:
    __aicore__ inline void CopyOutInt32(const AscendC::LocalTensor<int32_t>& cLocal,
                                        uint32_t m0, uint32_t n0, uint32_t rows)
    {
        const AscendC::tiling::TCubeTiling& t = tiling_;
        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopyParams p{
            static_cast<uint16_t>(rows),
            static_cast<uint16_t>(baseN_ * sizeof(int32_t) / 32),
            0,
            static_cast<uint16_t>((t.N - baseN_) * sizeof(int32_t) / 32)};
        AscendC::DataCopy(yInt32Gm_[(int64_t)m0 * t.N + n0], cLocal, p);
    }

    __aicore__ inline void DequantTile(const AscendC::LocalTensor<int32_t>& cLocal,
                                       uint32_t m0, uint32_t n0, uint32_t rows)
    {
        const AscendC::tiling::TCubeTiling& t = tiling_;
        AscendC::LocalTensor<float> cF = fAll_.Get<float>();
        AscendC::LocalTensor<float> sLoc = sChunk_.Get<float>();
        AscendC::LocalTensor<bfloat16_t> bf = bfAll_.Get<bfloat16_t>();
        AscendC::LocalTensor<float> ptLoc = pertBuf_.Get<float>();

        AscendC::PipeBarrier<PIPE_ALL>();
        AscendC::DataCopy(sLoc, scaleGm_[n0], baseN_);
        const uint32_t pg = MinU(qmmcustom::PERT_GROUP, rows);
        bool ptInUb = false;
        if ((pg & 7U) == 0U) {
            AscendC::DataCopy(ptLoc, pertokenGm_[m0], pg);
            ptInUb = true;
        }
        AscendC::PipeBarrier<PIPE_ALL>();

        for (uint32_t r = 0; r < rows; ++r) {
            const float p = ptInUb ? ptLoc.GetValue(r) : pertokenGm_.GetValue((int64_t)(m0 + r));
            AscendC::Cast(cF[r * baseN_], cLocal[r * baseN_], AscendC::RoundMode::CAST_NONE, baseN_);
            AscendC::Mul(cF[r * baseN_], cF[r * baseN_], sLoc, baseN_);
            AscendC::Muls(cF[r * baseN_], cF[r * baseN_], p, baseN_);
            AscendC::Cast(bf[r * baseN_], cF[r * baseN_], AscendC::RoundMode::CAST_RINT, baseN_);
        }
        AscendC::PipeBarrier<PIPE_ALL>();
        for (uint32_t r = 0; r < rows; ++r) {
            AscendC::DataCopyParams p1{1, static_cast<uint16_t>(baseN_ * sizeof(bfloat16_t) / 32), 0, 0};
            AscendC::DataCopy(yBf16Gm_[(int64_t)(m0 + r) * t.N + n0], bf[r * baseN_], p1);
        }
    }

    AscendC::TPipe* pipe_;
    AscendC::GlobalTensor<int8_t> aGm_;
    AscendC::GlobalTensor<int8_t> x2Gm_;
    AscendC::GlobalTensor<int32_t> yInt32Gm_;
    AscendC::GlobalTensor<bfloat16_t> yBf16Gm_;
    AscendC::GlobalTensor<float> scaleGm_;
    AscendC::GlobalTensor<float> pertokenGm_;

    AscendC::TBuf<AscendC::QuePosition::VECIN> cBuf_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> fAll_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> sChunk_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> bfAll_;
    AscendC::TBuf<AscendC::QuePosition::VECCALC> pertBuf_;

    uint32_t baseM_;
    uint32_t baseN_;
    uint32_t singleCoreM_;
    uint32_t singleCoreN_;
    uint32_t nSingleBlocks_;
    uint32_t mCoreIdx_;
    uint32_t nCoreIdx_;
    uint32_t mStart_;
    uint32_t mEnd_;
    uint32_t nStart_;
    uint32_t nEnd_;
    uint32_t isPertoken_;
};

class QmmCubeBasicKernel : public QmmKernelBase {
public:
    __aicore__ inline QmmCubeBasicKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR y,
                                GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData,
                                AscendC::TPipe *tPipe)
    {
        InitCommon(x1, x2, scale, nullptr, y, workSpace, tilingData, tPipe);
    }

    __aicore__ inline void Process()
    {
        QmmKernelBase::Process();
    }
};

class QmmPertokenKernel : public QmmKernelBase {
public:
    __aicore__ inline QmmPertokenKernel() {}

    __aicore__ inline void Init(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale, GM_ADDR pertokenScale, GM_ADDR y,
                                GM_ADDR workSpace, const QmmCustomTilingData *__restrict tilingData,
                                AscendC::TPipe *tPipe)
    {
        InitCommon(x1, x2, scale, pertokenScale, y, workSpace, tilingData, tPipe);
    }

    __aicore__ inline void Process()
    {
        QmmKernelBase::Process();
    }
};

__global__ __mix__(1, 2) __aicore__
    void qmm_custom_kernel(GM_ADDR x1, GM_ADDR x2, GM_ADDR scale,
                           GM_ADDR pertoken_scale, GM_ADDR y,
                           __gm__ uint8_t* __kfc_workspace__ workspace,
                           QmmCustomTilingData tilingData) {
  if (workspace == nullptr) {
    return;
  }
  AscendC::TPipe pipe;

  if (tilingData.isPertoken == 0) {
    QmmCubeBasicKernel kernel;
    kernel.Init(x1, x2, scale, y, workspace, &tilingData, &pipe);
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.mm_, &kernel.tiling_);
    kernel.Process();
    pipe.Destroy();
  } else {
    QmmPertokenKernel kernel;
    kernel.Init(x1, x2, scale, pertoken_scale, y, workspace, &tilingData,
                &pipe);
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), kernel.mm_, &kernel.tiling_);
    kernel.Process();
    pipe.Destroy();
  }
}

static bool GenCubeTiling(QmmCustomTilingData& td, uint32_t M, uint32_t N, uint32_t K,
                          uint32_t G, bool useFixSplit)
{
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (platform == nullptr) {
        return false;
    }
    matmul_tiling::MultiCoreMatmulTiling cubeTiling(*platform);
    cubeTiling.SetDim(G);
    cubeTiling.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_INT8);
    cubeTiling.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::NZ,
                        matmul_tiling::DataType::DT_INT8);
    cubeTiling.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND,
                        matmul_tiling::DataType::DT_INT32);
    cubeTiling.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND,
                           matmul_tiling::DataType::DT_INT32);
    cubeTiling.SetShape(M, N, K);
    cubeTiling.SetOrgShape(M, N, K);
    if (useFixSplit) {
        cubeTiling.SetFixSplit(128, 128, -1);
    }
    cubeTiling.SetBias(false);
    cubeTiling.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTN);
    cubeTiling.SetBufferSpace(-1, -1, -1);
    return cubeTiling.GetTiling(td.cubeTilingData) != -1;
}

static QmmCustomTilingData CalcQmmTiling(uint32_t isPertoken, uint32_t M,
                                         uint32_t N, uint32_t K) {
  QmmCustomTilingData tilingData{};
  auto* ascendcPlatform =
      platform_ascendc::PlatformAscendCManager::GetInstance();
  if (ascendcPlatform == nullptr) {
    tilingData.workspaceSize = static_cast<uint32_t>(qmmcustom::KFC_WORKSPACE_SIZE);
    return tilingData;
  }

  const int64_t coreNum = static_cast<int64_t>(ascendcPlatform->GetCoreNum());
  const uint32_t mBlocks = (M + 127) / 128;
  const uint32_t nBlocks = (N + 127) / 128;
  int64_t g64 = coreNum / 3;
  if (g64 < 1) {
    g64 = 1;
  }
  const int64_t tileCount = (int64_t)mBlocks * nBlocks;
  if (g64 > tileCount) {
    g64 = tileCount;
  }
  if (g64 > 24) {
    g64 = 24;
  }
  if (g64 > 1) {
    int64_t bestG = 1;
    const uint32_t mCap = mBlocks < 32 ? mBlocks : 32;
    const uint32_t nCap = nBlocks < 32 ? nBlocks : 32;
    for (uint32_t mm = 1; mm <= mCap; ++mm) {
      if (mBlocks % mm != 0) {
        continue;
      }
      for (uint32_t nn = 1; nn <= nCap; ++nn) {
        if (nBlocks % nn != 0) {
          continue;
        }
        const int64_t gg = static_cast<int64_t>(mm) * nn;
        if (gg <= g64 && gg > bestG) {
          bestG = gg;
        }
      }
    }
    g64 = bestG;
  }
  if (g64 < 1) {
    g64 = 1;
  }
  const uint32_t G = static_cast<uint32_t>(g64);

  if (!GenCubeTiling(tilingData, M, N, K, G, true)) {
    if (!GenCubeTiling(tilingData, M, N, K, G, false)) {
      tilingData.isPertoken = isPertoken;
      tilingData.workspaceSize = static_cast<uint32_t>(qmmcustom::KFC_WORKSPACE_SIZE);
      return tilingData;
    }
  }

  tilingData.isPertoken = isPertoken;
  tilingData.workspaceSize = static_cast<uint32_t>(qmmcustom::KFC_WORKSPACE_SIZE);
  return tilingData;
}

#ifndef ACL_PROF_TENSOR_INFO_DEFINED
#define ACL_PROF_TENSOR_INFO_DEFINED
struct aclprofTensor {
  uint32_t type;
  uint32_t format;
  uint32_t dataType;
  uint32_t shapeDim;
  uint32_t shape[8];
};

struct aclprofTensorInfo {
  uint64_t opNameId;
  uint64_t opTypeId;
  uint32_t resv;
  uint32_t tensorNum;
  uint32_t kernelType;
  uint32_t blockNums;
  void *stream;
  aclprofTensor *tensors;
};

struct aclprofEventAttributes {
  uint16_t version;
  uint16_t size;
  uint32_t messageType;
  union message {
    aclprofTensorInfo *tensorInfo;
  } message;
};
#endif

#define INPUT(x)                                                               \
  aclprofTensor {                                                              \
    (uint32_t)0,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(x.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(x.scalar_type())),   \
        static_cast<uint32_t>(x.sizes().size()), {                             \
      static_cast<uint32_t>(x.sizes().size() > 0 ? x.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(x.sizes().size() > 1 ? x.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 2 ? x.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(x.sizes().size() > 3 ? x.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define OUTPUT(z)                                                              \
  aclprofTensor {                                                              \
    (uint32_t)1,                                                               \
        static_cast<uint32_t>(                                                 \
            ascendc_ops::GetFormat(static_cast<int64_t>(z.sizes().size()))),   \
        static_cast<uint32_t>(ascendc_ops::GetAclDataType(z.scalar_type())),   \
        static_cast<uint32_t>(z.sizes().size()), {                             \
      static_cast<uint32_t>(z.sizes().size() > 0 ? z.sizes().data()[0] : 0),   \
          static_cast<uint32_t>(z.sizes().size() > 1 ? z.sizes().data()[1]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 2 ? z.sizes().data()[2]     \
                                                     : 0),                     \
          static_cast<uint32_t>(z.sizes().size() > 3 ? z.sizes().data()[3]     \
                                                     : 0)                      \
    }                                                                          \
  }

#define INIT_ACL_PROF_TENSOR_INFO(opName, opType, blockdim, kernelType,        \
                                  tensorInfo, stream, ...)                     \
  uint64_t opNameId = aclprofStr2Id(opName);                                   \
  uint64_t opTypeId = aclprofStr2Id(opType);                                   \
  struct aclprofTensor tensors[] = {__VA_ARGS__};                              \
  tensorInfo = {                                                               \
      opNameId,   opTypeId, 0,      sizeof(tensors) / sizeof(aclprofTensor),   \
      kernelType, blockdim, stream, tensors}

namespace ascendc_ops {

aclDataType GetAclDataType(at::ScalarType scalarType) {
  switch (scalarType) {
  case at::ScalarType::Float:
    return ACL_FLOAT;
  case at::ScalarType::Int:
    return ACL_INT32;
  case at::ScalarType::BFloat16:
    return ACL_BF16;
  case at::ScalarType::Byte:
    return ACL_UINT8;
  case at::ScalarType::Char:
    return ACL_INT8;
  default:
    TORCH_CHECK(false,
                "Unsupported tensor dtype for profiling report: ", scalarType);
  }
}

aclFormat GetFormat(int64_t dimNum) {
  aclFormat format = ACL_FORMAT_ND;
  if (dimNum == 4) {
    format = ACL_FORMAT_FRACTAL_NZ;
  }
  return format;
}

at::Tensor qmm_custom(const at::Tensor &x1, const at::Tensor &x2,
                      const at::Tensor &scale,
                      const c10::optional<at::Tensor> &pertoken_scale) {
  auto aclStream = c10_npu::getCurrentNPUStream().stream(true);

  auto M = x1.size(0);
  auto K = x1.size(1);
  auto N = x2.size(1);

  uint32_t isPertoken =
      pertoken_scale.has_value() && pertoken_scale.value().defined() ? 1 : 0;
  at::ScalarType output_dtype =
      isPertoken ? at::ScalarType::BFloat16 : at::ScalarType::Int;
  at::Tensor y = at::empty({M, N}, x1.options().dtype(output_dtype));

  QmmCustomTilingData tilingData = CalcQmmTiling(isPertoken, M, N, K);
  uint32_t numBlocks = tilingData.cubeTilingData.usedCoreNum;
  if (numBlocks == 0) {
    numBlocks = 1;
  }

  static uint8_t *g_ws = nullptr;
  static uint64_t g_wsSize = 0;
  if (g_wsSize < tilingData.workspaceSize) {
    void *newBuf = nullptr;
    if (aclrtMalloc(&newBuf, tilingData.workspaceSize, ACL_MEM_MALLOC_HUGE_FIRST) !=
            ACL_SUCCESS ||
        newBuf == nullptr) {
      at::Tensor wsFallback = at::empty(
          {static_cast<int64_t>(tilingData.workspaceSize)},
          x1.options().dtype(at::ScalarType::Byte));
      aclprofTensorInfo tensorInfo;
      uint64_t opNameId = aclprofStr2Id("qmm_custom");
      uint64_t opTypeId = aclprofStr2Id("QmmCustom");
      uint8_t *pertokenPtr =
          isPertoken ? (uint8_t *)(pertoken_scale.value().mutable_data_ptr())
                     : nullptr;
      std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale)};
      if (isPertoken) {
        tensors.push_back(INPUT(pertoken_scale.value()));
      }
      tensors.push_back(OUTPUT(y));
      tensorInfo = {opNameId, opTypeId,  0,         (uint32_t)tensors.size(),
                    0,        numBlocks, aclStream, tensors.data()};
      aclprofEventAttributes attrs = {1, sizeof(aclprofEventAttributes::message), 0,
                                      &tensorInfo};
      aclprofRangePushEx(&attrs);
      qmm_custom_kernel<<<numBlocks, 0, aclStream>>>(
          (uint8_t *)(x1.mutable_data_ptr()), (uint8_t *)(x2.mutable_data_ptr()),
          (uint8_t *)(scale.mutable_data_ptr()), pertokenPtr,
          (uint8_t *)(y.mutable_data_ptr()), wsFallback.data_ptr<uint8_t>(),
          tilingData);
      aclprofRangePop();
      return y;
    }
    if (g_ws != nullptr) {
      aclrtFree(g_ws);
    }
    g_ws = static_cast<uint8_t *>(newBuf);
    g_wsSize = tilingData.workspaceSize;
  }

  aclprofTensorInfo tensorInfo;
  uint64_t opNameId = aclprofStr2Id("qmm_custom");
  uint64_t opTypeId = aclprofStr2Id("QmmCustom");
  uint8_t *pertokenPtr =
      isPertoken ? (uint8_t *)(pertoken_scale.value().mutable_data_ptr())
                 : nullptr;
  std::vector<aclprofTensor> tensors = {INPUT(x1), INPUT(x2), INPUT(scale)};
  if (isPertoken) {
    tensors.push_back(INPUT(pertoken_scale.value()));
  }
  tensors.push_back(OUTPUT(y));
  tensorInfo = {opNameId, opTypeId,  0,         (uint32_t)tensors.size(),
                0,        numBlocks, aclStream, tensors.data()};

  aclprofEventAttributes attrs = {1, sizeof(aclprofEventAttributes::message), 0,
                                  &tensorInfo};

  aclprofRangePushEx(&attrs);
  qmm_custom_kernel<<<numBlocks, 0, aclStream>>>(
      (uint8_t *)(x1.mutable_data_ptr()), (uint8_t *)(x2.mutable_data_ptr()),
      (uint8_t *)(scale.mutable_data_ptr()), pertokenPtr,
      (uint8_t *)(y.mutable_data_ptr()), g_ws, tilingData);
  aclrtSynchronizeStream(aclStream);
  aclprofRangePop();
  return y;
}
} // namespace ascendc_ops

TORCH_LIBRARY(ascendc_ops, m) {
  m.def("qmm_custom(Tensor x1, Tensor x2, Tensor scale, Tensor? "
        "pertoken_scale=None) -> Tensor");
}

TORCH_LIBRARY_IMPL(ascendc_ops, PrivateUse1, m) {
  m.impl("qmm_custom", TORCH_FN(ascendc_ops::qmm_custom));
}